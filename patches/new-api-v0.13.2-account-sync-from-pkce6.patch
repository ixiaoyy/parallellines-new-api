+// MainAccountSessionUser 只携带当前授权所需字段，不暴露账号资料或凭据。
+type MainAccountSessionUser struct {
+	Id        int
+	Role      int
+	Status    int
+	MainBound bool
+}
+
+// GetMainAccountSessionUser 一次查询确认账号存在并识别主站绑定；只在统一账号同步启用时使用。
+// 保留软删除过滤，不刷新本地独立账号的旧 cookie 权限语义。
+func GetMainAccountSessionUser(id int) (*MainAccountSessionUser, error) {
+	if id <= 0 {
+		return nil, gorm.ErrRecordNotFound
+	}
+	var user MainAccountSessionUser
+	err := DB.Model(&User{}).Select("users.id, users.role, users.status, EXISTS (SELECT 1 FROM user_oauth_bindings WHERE user_oauth_bindings.user_id = users.id AND user_oauth_bindings.provider_id = ?) AS main_bound", 1).
+		Where("users.id = ?", id).Take(&user).Error
+	return &user, err
+}
diff --git a/oauth/main_account.go b/oauth/main_account.go
new file mode 100644
--- /dev/null
+++ b/oauth/main_account.go
@@ -0,0 +1,179 @@
+package oauth
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	gormlogger "gorm.io/gorm/logger"
+)
+
+type MainProfileConflictError struct{}
+
+func (*MainProfileConflictError) Error() string {
+	return "Main account profile conflicts with an existing account. Contact an administrator."
+}
+
+type OAuthRegistrationDisabledError struct{}
+
+func (*OAuthRegistrationDisabledError) Error() string { return "registration is disabled" }
+
+var ErrMainAccountUnavailable = errors.New("Main account profile could not be synchronized. Please retry or contact an administrator.")
+
+func mainProfileCollision(tx *gorm.DB, userID int, profile *OAuthUser) error {
+	var count int64
+	if err := tx.Unscoped().Model(&model.User{}).Where("id <> ? AND (username = ? OR LOWER(email) = ?)",
+		userID, profile.Username, strings.ToLower(profile.Email)).Count(&count).Error; err != nil {
+		return ErrMainAccountUnavailable
+	}
+	if count != 0 {
+		return &MainProfileConflictError{}
+	}
+	return nil
+}
+
+// FindOrCreateMainProfileUser 按固定 provider+sub 原子创建或同步主站账号。
+// inviterID 仅沿用原生 OAuth 的邀请上下文；Chat 固定为 0。余额、密码、分组与超级管理员保持原值。
+// 开启统一账号同步后，主站 admin 映射管理员，其余合法角色映射普通用户。
+func FindOrCreateMainProfileUser(db *gorm.DB, provider *GenericOAuthProvider,
+	profile *OAuthUser, inviterID int) (*model.User, bool, error) {
+	if err := provider.ValidateMainProfileConfiguration(); err != nil {
+		return nil, false, err
+	}
+	if err := ValidateMainProfile(profile); err != nil {
+		return nil, false, err
+	}
+	var user model.User
+	created := false
+	var profileConflict error
+	// Database errors can include query parameters. Never log private profile values.
+	err := db.Session(&gorm.Session{Logger: db.Logger.LogMode(gormlogger.Silent)}).Transaction(func(tx *gorm.DB) error {
+		var liveProvider model.CustomOAuthProvider
+		// Serializes Main-profile writers on databases with row locks. SQLite's
+		// write serialization rejects a racing write, which fails the login closed.
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).First(&liveProvider, provider.GetProviderId()).Error; err != nil {
+			return ErrMainAccountUnavailable
+		}
+		if err := NewGenericOAuthProvider(&liveProvider).ValidateMainProfileConfiguration(); err != nil {
+			return err
+		}
+		var bindings []model.UserOAuthBinding
+		if err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).Where("provider_id = ? AND provider_user_id = ?",
+			provider.GetProviderId(), profile.ProviderUserID).Limit(2).Find(&bindings).Error; err != nil {
+			return ErrMainAccountUnavailable
+		}
+		// sub 必须精确匹配；拒绝大小写不敏感数据库返回的近似记录及重复绑定。
+		if len(bindings) > 1 || (len(bindings) == 1 && bindings[0].ProviderUserId != profile.ProviderUserID) {
+			return model.ErrOAuthRelayIdentityDenied
+		}
+		if len(bindings) == 1 {
+			binding := bindings[0]
+			err := tx.Clauses(clause.Locking{Strength: "UPDATE"}).First(&user, binding.UserId).Error
+			if errors.Is(err, gorm.ErrRecordNotFound) || (err == nil && user.Status != common.UserStatusEnabled) {
+				return model.ErrOAuthRelayIdentityDenied
+			}
+			if err != nil {
+				return ErrMainAccountUnavailable
+			}
+			if MainAccountSyncEnabled() && user.Role != common.RoleCommonUser && user.Role != common.RoleAdminUser && user.Role != common.RoleRootUser {
+				return model.ErrOAuthRelayIdentityDenied
+			}
+			role := mainAccountRole(&user, profile)
+			updates := map[string]any{}
+			if role != user.Role {
+				updates["role"] = role
+			}
+			if err := mainProfileCollision(tx, user.Id, profile); err != nil {
+				var conflict *MainProfileConflictError
+				if !errors.As(err, &conflict) {
+					return err
+				}
+				// 资料冲突仍明确失败，但不能阻止已核主站撤权；只提交角色变化，不改冲突资料。
+				profileConflict = err
+				// 冲突登录不新增权限；已验证的降权仍提交，避免旧管理员权限残留。
+				if role > user.Role {
+					delete(updates, "role")
+				}
+			} else {
+				if user.Username != profile.Username {
+					updates["username"] = profile.Username
+				}
+				if user.DisplayName != profile.DisplayName {
+					updates["display_name"] = profile.DisplayName
+				}
+				if user.Email != profile.Email {
+					updates["email"] = profile.Email
+				}
+			}
+			if len(updates) != 0 {
+				if tx.Model(&user).Updates(updates).Error != nil {
+					return ErrMainAccountUnavailable
+				}
+			}
+			return nil
+		}
+		if !common.RegisterEnabled {
+			return &OAuthRegistrationDisabledError{}
+		}
+		if err := mainProfileCollision(tx, 0, profile); err != nil {
+			return err
+		}
+		user = model.User{Username: profile.Username, DisplayName: profile.DisplayName, Email: profile.Email,
+			Role: mainAccountRole(nil, profile), Status: common.UserStatusEnabled}
+		if user.InsertWithTx(tx, inviterID) != nil {
+			return ErrMainAccountUnavailable
+		}
+		binding := model.UserOAuthBinding{UserId: user.Id, ProviderId: provider.GetProviderId(), ProviderUserId: profile.ProviderUserID}
+		if model.CreateUserOAuthBindingWithTx(tx, &binding) != nil {
+			return ErrMainAccountUnavailable
+		}
+		created = true
+		return nil
+	})
+	if err != nil {
+		// Commit/driver errors can contain private SQL values; preserve only our
+		// explicitly safe errors, never forward the raw database message.
+		var conflict *MainProfileConflictError
+		var registration *OAuthRegistrationDisabledError
+		if errors.As(err, &conflict) || errors.As(err, &registration) ||
+			errors.Is(err, ErrMainProfileConfig) || errors.Is(err, ErrMainAccountUnavailable) || errors.Is(err, model.ErrOAuthRelayIdentityDenied) {
+			return nil, false, err
+		}
+		return nil, false, ErrMainAccountUnavailable
+	}
+	// 每次成功提交均尝试原有失效；上次提交后 Redis 失败时，重复请求可恢复缓存。
+	if err := model.InvalidateUserCache(user.Id); err != nil {
+		return nil, false, ErrMainAccountUnavailable
+	}
+	if profileConflict != nil {
+		return nil, false, profileConflict
+	}
+	return &user, created, nil
+}
+
+// mainAccountRole 仅使用已校验的主站角色；恢复超级管理员不参加自动升降级。
+func mainAccountRole(user *model.User, profile *OAuthUser) int {
+	if user != nil && (user.Role == common.RoleRootUser || !MainAccountSyncEnabled()) {
+		return user.Role
+	}
+	if MainAccountSyncEnabled() && profile.Extra["main_role"] == "admin" {
+		return common.RoleAdminUser
+	}
+	return common.RoleCommonUser
+}
+
+// FindOrCreateChatMainUser 为受信 Chat 首次请求复用原生事务开户；不接受调用方指定用户或邀请人。
+// 已禁用、已删除或绑定冲突均由同一事务拒绝，注册关闭时只允许已有启用账号同步。
+func FindOrCreateChatMainUser(db *gorm.DB, profile *OAuthUser) (*model.User, bool, error) {
+	if !MainAccountSyncEnabled() {
+		return nil, false, ErrMainProfileConfig
+	}
+	var provider model.CustomOAuthProvider
+	if db.First(&provider, 1).Error != nil {
+		return nil, false, ErrMainAccountUnavailable
+	}
+	return FindOrCreateMainProfileUser(db, NewGenericOAuthProvider(&provider), profile, 0)
+}
