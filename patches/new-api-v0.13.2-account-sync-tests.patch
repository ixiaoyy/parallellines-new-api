+package controller
+
+import (
+	"errors"
+	"sync"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/oauth"
+)
+
+func TestMainAccountChatProvisionRoleMappingAndPreservedQuota(t *testing.T) {
+	for _, tc := range []struct { role string; want int }{
+		{"user", common.RoleCommonUser}, {"moderator", common.RoleCommonUser}, {"admin", common.RoleAdminUser},
+	} {
+		t.Run(tc.role, func(t *testing.T) {
+			db, p := profileDatabase(t)
+			t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+			oldQuota := common.QuotaForNewUser
+			common.QuotaForNewUser = 345
+			t.Cleanup(func() { common.QuotaForNewUser = oldQuota })
+			profile := testMainProfile()
+			profile.Extra["main_role"] = tc.role
+			user, created, err := oauth.FindOrCreateChatMainUser(db, profile)
+			if err != nil || !created || user.Role != tc.want || user.Quota != 345 || user.Group != "default" {
+				t.Fatal("Chat account creation did not retain native registration policy")
+			}
+			id := user.Id
+			if err := db.Model(user).Updates(map[string]any{"quota": 123, "used_quota": 45, "password": "synthetic-retained-password", "group": "retained-group"}).Error; err != nil { t.Fatal(err) }
+			// 原生 API 登录和 Chat 请求复用同一个 sub；不能另建账号或重新送注册额度。
+			for _, role := range []string{"admin", "moderator", "user"} {
+				profile.Extra["main_role"] = role
+				after, created, err := findOrCreateMainProfileUser(db, p, profile, 0)
+				want := common.RoleCommonUser
+				if role == "admin" { want = common.RoleAdminUser }
+				if err != nil || created || after.Id != id || after.Role != want || after.Quota != 123 || after.UsedQuota != 45 || after.Password != "synthetic-retained-password" || after.Group != "retained-group" { t.Fatal("role sync changed identity or protected values") }
+			}
+			var users, bindings int64
+			db.Model(&model.User{}).Count(&users)
+			db.Model(&model.UserOAuthBinding{}).Count(&bindings)
+			if users != 1 || bindings != 1 { t.Fatal("duplicate account or binding") }
+		})
+	}
+}
+
+func TestMainAccountRootAndAccountRestrictions(t *testing.T) {
+	for _, state := range []string{"root", "disabled", "soft-deleted", "hard-deleted", "registration-off", "provider-disabled"} {
+		t.Run(state, func(t *testing.T) {
+			db, _ := profileDatabase(t)
+			t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+			profile := testMainProfile()
+			profile.Extra["main_role"] = "user"
+			user := insertProfileUser(t, db, 2, "53", "old-name", "old@example.invalid")
+			switch state {
+			case "disabled": db.Model(&user).Update("status", common.UserStatusDisabled)
+			case "soft-deleted": db.Delete(&user)
+			case "hard-deleted": db.Unscoped().Delete(&user)
+			case "registration-off": common.RegisterEnabled = false
+			case "provider-disabled": db.Model(&model.CustomOAuthProvider{}).Where("id = ?", 1).Update("enabled", false)
+			}
+			after, created, err := oauth.FindOrCreateChatMainUser(db, profile)
+			if state == "root" || state == "registration-off" {
+				if err != nil || created || after.Id != 2 || after.Role != common.RoleRootUser { t.Fatal("existing root account changed") }
+			} else if err == nil || created { t.Fatal("inactive identity recreated") }
+			if state == "registration-off" {
+				profile.ProviderUserID, profile.Username, profile.Email = "new-sub", "new-name", "new@example.invalid"
+				if _, _, err := oauth.FindOrCreateChatMainUser(db, profile); err == nil { t.Fatal("registration policy bypassed") }
+			}
+		})
+	}
+}
+
+func TestMainAccountProfileConflictCannotPreventRoleDemotion(t *testing.T) {
+	db, _ := profileDatabase(t)
+	t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+	before := insertProfileUser(t, db, 2, "53", "old-name", "old@example.invalid")
+	db.Model(&before).Update("role", common.RoleAdminUser)
+	profile := testMainProfile()
+	profile.Extra["main_role"] = "user"
+	insertProfileUser(t, db, 3, "54", profile.Username, "other@example.invalid")
+	_, _, err := oauth.FindOrCreateChatMainUser(db, profile)
+	var conflict *oauth.MainProfileConflictError
+	if !errors.As(err, &conflict) { t.Fatal("profile conflict hidden") }
+	var after model.User
+	db.First(&after, 2)
+	if after.Role != common.RoleCommonUser || after.Username != before.Username || after.Email != before.Email || after.Quota != before.Quota { t.Fatal("demotion or conflict preservation failed") }
+}
+
+func TestMainAccountConcurrentFirstAccessHasOneIdentity(t *testing.T) {
+	db, _ := profileDatabase(t)
+	t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+	connection, _ := db.DB()
+	connection.SetMaxOpenConns(1)
+	var workers sync.WaitGroup
+	for i := 0; i < 2; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			profile := testMainProfile()
+			profile.Extra["main_role"] = "user"
+			if _, _, err := oauth.FindOrCreateChatMainUser(db, profile); err != nil { t.Error(err) }
+		}()
+	}
+	workers.Wait()
+	var users, bindings int64
+	db.Model(&model.User{}).Count(&users)
+	db.Model(&model.UserOAuthBinding{}).Count(&bindings)
+	if users != 1 || bindings != 1 { t.Fatal("concurrent first access created duplicate identity") }
+}
