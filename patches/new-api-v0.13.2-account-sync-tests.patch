+func TestChatMainAccountNeedsFreshProfileClaims(t *testing.T) {
+	t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+	for _, kind := range []string{"valid", "missing-role", "missing-email", "wrong-role"} {
+		t.Run(kind, func(t *testing.T) {
+			claims := fixtureChatClaims("fixture-a")
+			claims["preferred_username"], claims["name"] = "main-name", "Main display"
+			claims["email"], claims["email_verified"], claims["pl_role"] = "synthetic@example.invalid", true, "admin"
+			switch kind {
+			case "missing-role": delete(claims, "pl_role")
+			case "missing-email": delete(claims, "email")
+			case "wrong-role": claims["pl_role"] = "root"
+			}
+			mockChatUserInfo(t, func(*http.Request) (int, any) { return 200, claims })
+			result, err := verifyChatOAuthToken(context.Background(), "synthetic-token")
+			if kind == "valid" {
+				if err != nil || result.Profile.Extra["main_role"] != "admin" { t.Fatal("trusted role not passed to account layer") }
+			} else if err != errChatOAuthInvalid { t.Fatal("incomplete session did not require Chat reauthorization") }
+		})
+	}
+}
+
+func TestMainAccountCookieUsesCurrentBoundRoleButKeepsLocalRecovery(t *testing.T) {
+	r := sessionRevocationFixture(t)
+	t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+	if err := model.DB.AutoMigrate(&model.UserOAuthBinding{}); err != nil { t.Fatal(err) }
+	if err := model.DB.Create(&model.UserOAuthBinding{UserId: 2, ProviderId: 1, ProviderUserId: "synthetic-sub"}).Error; err != nil { t.Fatal(err) }
+	login := sessionRevocationCookie(t, r, map[string]any{"id": 2, "username": "synthetic-user", "role": common.RoleAdminUser, "status": common.UserStatusEnabled, "group": "default"})
+	// 即使重放旧管理员 cookie，也只能使用已同步到数据库的当前普通角色。
+	w := sessionRevocationRequest(r, "/admin", login, "", "2")
+	if w.Code != http.StatusOK || strings.Contains(w.Body.String(), `"handler":true`) { t.Fatal("old cookie retained revoked administrator access") }
+	if err := model.DB.Model(&model.User{}).Where("id = ?", 2).Update("role", common.RoleAdminUser).Error; err != nil { t.Fatal(err) }
+	w = sessionRevocationRequest(r, "/admin", login, "", "2")
+	if !strings.Contains(w.Body.String(), `"handler":true`) { t.Fatal("current administrator role was not read") }
+	if err := model.DB.Model(&model.User{}).Where("id = ?", 2).Update("status", common.UserStatusDisabled).Error; err != nil { t.Fatal(err) }
+	if w = sessionRevocationRequest(r, "/user", login, "", "2"); w.Code != http.StatusUnauthorized { t.Fatal("disabled Main-bound account remained usable") }
+	t.Run("local-recovery-unchanged", func(t *testing.T) {
+		local := sessionRevocationFixture(t)
+		if err := model.DB.AutoMigrate(&model.UserOAuthBinding{}); err != nil { t.Fatal(err) }
+		root := sessionRevocationCookie(t, local, sessionRevocationRootClaims())
+		if err := model.DB.Model(&model.User{}).Where("id = ?", 1).Update("role", common.RoleCommonUser).Error; err != nil { t.Fatal(err) }
+		if result := sessionRevocationRequest(local, "/root", root, "", "1"); !strings.Contains(result.Body.String(), `"handler":true`) { t.Fatal("local recovery cookie semantics changed") }
+	})
+}
