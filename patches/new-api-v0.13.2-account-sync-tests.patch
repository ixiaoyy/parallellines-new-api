@@ -0,0 +1,35 @@
+package oauth
+
+import (
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+func TestMainAccountClaimsRequireTrustedRoleAndSeparateAudiences(t *testing.T) {
+	p := profileTestProvider(t)
+	t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+	for _, role := range []string{"user", "moderator", "admin"} {
+		claims := profileTestClaims()
+		claims["pl_role"] = role
+		body, _ := common.Marshal(claims)
+		profile, err := p.parseMainProfile(body)
+		if err != nil || profile.Extra["main_role"] != role { t.Fatal("valid Main role rejected") }
+		if _, err := ParseChatMainProfile(body); err == nil { t.Fatal("API audience accepted as Chat") }
+		claims["aud"] = mainChatClient
+		body, _ = common.Marshal(claims)
+		if _, err := ParseChatMainProfile(body); err != nil { t.Fatal(err) }
+		if _, err := p.parseMainProfile(body); err == nil { t.Fatal("Chat audience accepted as API login") }
+	}
+	for _, role := range []any{nil, "", "root", "Admin", 10, true, []string{"admin"}} {
+		claims := profileTestClaims()
+		claims["pl_role"] = role
+		body, _ := common.Marshal(claims)
+		if _, err := p.parseMainProfile(body); err != ErrMainProfileUnverified { t.Fatal("invalid role accepted") }
+	}
+	claims := profileTestClaims()
+	body, _ := common.Marshal(claims)
+	if _, err := p.parseMainProfile(body); err != ErrMainProfileUnverified { t.Fatal("missing role accepted") }
+	t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "false")
+	if _, err := p.parseMainProfile(body); err != nil { t.Fatal("legacy profile behavior changed") }
+}
