+package dto
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestResponsesCacheOptionsSurviveNativeRequestEncoding(t *testing.T) {
+	var request OpenAIResponsesRequest
+	if err := json.Unmarshal([]byte(`{"model":"gpt-6-luna","input":"hello","prompt_cache_options":{"ttl":"12h","mode":"explicit"}}`), &request); err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := json.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wire struct {
+		Options struct{ TTL, Mode string } `json:"prompt_cache_options"`
+	}
+	if err := json.Unmarshal(encoded, &wire); err != nil || wire.Options.TTL != "12h" || wire.Options.Mode != "explicit" {
+		t.Fatal("cache lifetime was lost before upstream dispatch")
+	}
+}
