@@ -0,0 +1,63 @@
+package service
+
+import (
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+func TestOpenAIStandardCacheTTLRequestEvidence(t *testing.T) {
+	for _, tt := range []struct{ request, want string }{
+		{`{"input":"hello"}`, "30m"},
+		{`{"prompt_cache_options":{"ttl":"12h"}}`, "12h"},
+		{`{"input":[{"role":"user","content":[{"type":"input_text","text":"x","prompt_cache_breakpoint":{"mode":"explicit"}}]}]}`, "30m"},
+		{`{"input":[{"content":[{"prompt_cache_breakpoint":{"ttl":"12h"}}]}]}`, ""},
+		{`{"prompt_cache_options":{"ttl":"12h"},"input":[{"content":[{"prompt_cache_breakpoint":{"ttl":"12h"}}]}]}`, "12h"},
+		{`{"previous_response_id":"resp-history"}`, ""},
+		{`{"conversation":"conv-history"}`, ""},
+		{`{"prompt_cache_options":null}`, ""},
+		{`{"prompt_cache_options":{"ttl":"24h"}}`, ""},
+		{`{"metadata":{"prompt_cache_breakpoint":{"ttl":"12h"}}}`, "30m"},
+	} {
+		var request map[string]any
+		if err := common.Unmarshal([]byte(tt.request), &request); err != nil {
+			t.Fatal(err)
+		}
+		if got := openAIStandardCacheTTL(request); got != tt.want {
+			t.Fatalf("request=%s got=%q want=%q", tt.request, got, tt.want)
+		}
+	}
+}
+
+func TestOpenAIStandardUsageUsesOnlyProvenTTLWhenSplitAbsent(t *testing.T) {
+	raw := []byte(`{"input_tokens":30,"output_tokens":1,"total_tokens":31,"input_tokens_details":{"cache_write_tokens":20}}`)
+	for _, ttl := range []string{"30m", "12h"} {
+		got, err := ParseOpenAIStandardUsageWithCacheTTL(raw, true, ttl)
+		if err != nil || got == nil {
+			t.Fatalf("ttl=%s usage=%+v error=%v", ttl, got, err)
+		}
+		if ttl == "30m" && (got.CacheWrite30mTokens != 20 || got.CacheWrite12hTokens != 0) {
+			t.Fatal("30m write partition changed")
+		}
+		if ttl == "12h" && (got.CacheWrite30mTokens != 0 || got.CacheWrite12hTokens != 20) {
+			t.Fatal("12h write partition changed")
+		}
+	}
+	if _, err := ParseOpenAIStandardUsage(raw, true); err == nil {
+		t.Fatal("legacy strict parser accepted unproven duration")
+	}
+	for _, raw := range []string{
+		`{"input_tokens":30,"output_tokens":1,"total_tokens":31,"input_tokens_details":{"cache_write_tokens":20,"cache_write_tokens_details":null}}`,
+		`{"input_tokens":30,"output_tokens":1,"total_tokens":31,"input_tokens_details":{"cache_write_tokens":20,"cache_write_tokens_details":{"ttl_30m_tokens":20}}}`,
+		`{"input_tokens":30,"output_tokens":1,"total_tokens":31,"input_tokens_details":{"cache_write_tokens":20,"cache_write_tokens_details":{"ttl_30m_tokens":20,"ttl_12h_tokens":1}}}`,
+	} {
+		if _, err := ParseOpenAIStandardUsageWithCacheTTL([]byte(raw), true, "30m"); err == nil {
+			t.Fatal("invalid explicit breakdown was hidden by request TTL")
+		}
+	}
+	valid := []byte(`{"input_tokens":30,"output_tokens":1,"total_tokens":31,"input_tokens_details":{"cache_write_tokens":20,"cache_write_tokens_details":{"ttl_30m_tokens":10,"ttl_12h_tokens":10}}}`)
+	got, err := ParseOpenAIStandardUsageWithCacheTTL(valid, true, "30m")
+	if err != nil || got.CacheWrite30mTokens != 10 || got.CacheWrite12hTokens != 10 {
+		t.Fatal("explicit mixed breakdown must remain authoritative")
+	}
+}
