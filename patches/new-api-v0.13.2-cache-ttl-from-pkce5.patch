diff --git a/service/openai_standard_cache_ttl.go b/service/openai_standard_cache_ttl.go
new file mode 100644
--- /dev/null
+++ b/service/openai_standard_cache_ttl.go
@@ -0,0 +1,52 @@
+package service
+
+// openAIStandardCacheTTL 从已验证的实际请求计算统一缓存写入时长。
+// 返回空字符串表示有混合时长、未知设置或服务端历史，结算仍须使用上游明细。
+// 只检查原生 input/content 断点，不解释用户文本、工具参数或 metadata。
+func openAIStandardCacheTTL(request map[string]any) string {
+	if previous, exists := request["previous_response_id"]; exists && previous != nil && previous != "" {
+		return ""
+	}
+	if conversation, exists := request["conversation"]; exists && conversation != nil {
+		return ""
+	}
+	// 官方默认 30m；只有省略设置时使用默认值，显式无效值不能被默认值掩盖。
+	ttl := "30m"
+	if raw, exists := request["prompt_cache_options"]; exists {
+		options, ok := raw.(map[string]any)
+		if !ok {
+			return ""
+		}
+		if rawTTL, exists := options["ttl"]; exists {
+			value, ok := rawTTL.(string)
+			if !ok || (value != "30m" && value != "12h") {
+				return ""
+			}
+			ttl = value
+		}
+	}
+	items, _ := request["input"].([]any)
+	for _, rawItem := range items {
+		item, ok := rawItem.(map[string]any)
+		if !ok {
+			return ""
+		}
+		content, _ := item["content"].([]any)
+		for _, rawBlock := range content {
+			block, ok := rawBlock.(map[string]any)
+			if !ok {
+				return ""
+			}
+			if raw, exists := block["prompt_cache_breakpoint"]; exists {
+				breakpoint, ok := raw.(map[string]any)
+				if !ok {
+					return ""
+				}
+				if override, exists := breakpoint["ttl"]; exists && override != ttl {
+					return ""
+				}
+			}
+		}
+	}
+	return ttl
+}
