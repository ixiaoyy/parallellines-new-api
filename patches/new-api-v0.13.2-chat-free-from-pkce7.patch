diff --git a/controller/chat_free_error.go b/controller/chat_free_error.go
new file mode 100644
--- /dev/null
+++ b/controller/chat_free_error.go
@@ -0,0 +1,32 @@
+package controller
+
+import (
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/relay/helper"
+	"github.com/QuantumNous/new-api/types"
+	"github.com/gin-gonic/gin"
+)
+
+// writeChatFreeStreamError 仅为新免费入口的已开始 SSE 写入显式失败，不追加普通 HTTP JSON。
+// 原三模型继续使用原来的错误、退款和审计边界。
+func writeChatFreeStreamError(c *gin.Context, format types.RelayFormat, err *types.NewAPIError) bool {
+	if err == nil ||
+		!common.GetContextKeyBool(c, constant.ContextKeyChatOAuthFreeModel) || !c.Writer.Written() || !c.GetBool(string(constant.ContextKeyIsStream)) {
+		return false
+	}
+	if format == types.RelayFormatOpenAIResponses {
+		next := 0
+		if value, ok := c.Get("openai_standard_last_sequence"); ok {
+			if n, valid := value.(int); valid && n >= 0 && n < 1000000000 {
+				next = n + 1
+			}
+		}
+		c.Render(-1, common.CustomEvent{Data: "event: error\n"})
+		_ = helper.ObjectData(c, gin.H{"type": "error", "code": string(err.GetErrorCode()), "message": err.ToOpenAIError().Message, "param": nil, "sequence_number": next})
+	} else {
+		_ = helper.ObjectData(c, gin.H{"error": err.ToOpenAIError()})
+		helper.Done(c)
+	}
+	return true
+}
