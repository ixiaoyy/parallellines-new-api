new file mode 100644
--- /dev/null
+++ b/service/chat_free.go
@@ -0,0 +1,292 @@
+package service
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/setting/billing_setting"
+	"github.com/QuantumNous/new-api/setting/ratio_setting"
+	"github.com/QuantumNous/new-api/types"
+	"github.com/shopspring/decimal"
+)
+
+const ChatFreePolicyErrorCode types.ErrorCode = "chat_free_policy_rejected"
+const ChatFreeUsageErrorCode types.ErrorCode = "chat_free_usage_unsettled"
+
+// ChatFreePolicyError 拒绝无法保证免费的新入口；不作为渠道故障重试或禁用渠道。
+func ChatFreePolicyError(reason string) *types.NewAPIError {
+	return types.NewErrorWithStatusCode(fmt.Errorf("Chat free model is unavailable (%s)", reason), ChatFreePolicyErrorCode, http.StatusBadRequest, types.ErrOptionWithSkipRetry())
+}
+
+// ChatFreeUsageError 报告真实费用或响应异常，不把非零账单改成零，不重试已发生的调用。
+func ChatFreeUsageError(reason string) *types.NewAPIError {
+	return types.NewErrorWithStatusCode(fmt.Errorf("Chat free response could not be accepted (%s)", reason), ChatFreeUsageErrorCode, http.StatusBadGateway, types.ErrOptionWithSkipRetry())
+}
+
+// ValidateChatFreePricing 仅校验已核验 Chat 的精确免费模型；普通 API 和原三模型不受影响。
+// groupRatio 为本请求实际分组倍率。必须在预扣前和每次上游发送前分别检查。
+func ValidateChatFreePricing(info *relaycommon.RelayInfo, groupRatio float64) error {
+	if info == nil || !info.ChatOAuthFreeModel {
+		return nil
+	}
+	if info.ChannelMeta == nil || info.OriginModelName != constant.ChatFreeModel ||
+		info.ChannelType != constant.ChannelTypeOpenRouter || strings.TrimRight(info.ChannelBaseUrl, "/") != "https://openrouter.ai/api" ||
+		info.IsModelMapped || info.UpstreamModelName != constant.ChatFreeModel {
+		return ChatFreePolicyError("channel_or_model_changed")
+	}
+	if math.IsNaN(groupRatio) || math.IsInf(groupRatio, 0) || groupRatio < 0 {
+		return ChatFreePolicyError("invalid_group_ratio")
+	}
+	// 分组倍率为零或阶梯表达式初值为零不能替代模型本身的零定价。
+	if billing_setting.GetBillingMode(info.OriginModelName) == billing_setting.BillingModeTieredExpr {
+		return ChatFreePolicyError("tiered_billing_not_free")
+	}
+	if price, usePrice := ratio_setting.GetModelPrice(info.OriginModelName, false); usePrice {
+		if price != 0 {
+			return ChatFreePolicyError("nonzero_fixed_price")
+		}
+	} else if ratio, found, _ := ratio_setting.GetModelRatio(info.OriginModelName); !found || ratio != 0 {
+		return ChatFreePolicyError("zero_model_price_required")
+	}
+	return nil
+}
+
+// ValidateChatFreeHTTPRequest 在所有映射、参数覆盖、透传与请求头覆盖之后检查真正出站内容。
+// 仅新免费能力重读有界请求体并原样放回；允许普通客户端 function 工具，不允许收费服务端工具/插件。
+func ValidateChatFreeHTTPRequest(info *relaycommon.RelayInfo, req *http.Request) error {
+	if info == nil || !info.ChatOAuthFreeModel {
+		return nil
+	}
+	info.ChatFreeRequestValidated = false
+	info.ChatFreeRequestPrice = nil
+	info.ChatFreeRequestChannel = 0
+	if err := ValidateChatFreePricing(info, info.PriceData.GroupRatioInfo.GroupRatio); err != nil {
+		return err
+	}
+	if !info.PriceData.FreeModel || info.PriceData.QuotaToPreConsume != 0 ||
+		(info.PriceData.UsePrice && info.PriceData.ModelPrice != 0) || (!info.PriceData.UsePrice && info.PriceData.ModelRatio != 0) {
+		return ChatFreePolicyError("invalid_zero_price_snapshot")
+	}
+	if req == nil || req.URL == nil || req.Method != http.MethodPost || req.URL.Scheme != "https" ||
+		req.URL.Host != "openrouter.ai" || (req.Host != "" && req.Host != "openrouter.ai") ||
+		req.URL.User != nil || req.URL.RawQuery != "" || req.URL.Fragment != "" ||
+		(req.URL.Path != "/api/v1/chat/completions" && req.URL.Path != "/api/v1/responses") {
+		return ChatFreePolicyError("invalid_final_endpoint")
+	}
+	if info.ApiKey == "" || len(req.Header.Values("Authorization")) != 1 || req.Header.Get("Authorization") != "Bearer "+info.ApiKey {
+		return ChatFreePolicyError("invalid_final_authorization")
+	}
+	limit := int64(constant.MaxRequestBodyMB) * 1024 * 1024
+	if limit <= 0 {
+		limit = 128 * 1024 * 1024
+	}
+	if req.Body == nil {
+		return ChatFreePolicyError("missing_request_body")
+	}
+	body, err := io.ReadAll(io.LimitReader(req.Body, limit+1))
+	_ = req.Body.Close()
+	if err != nil || int64(len(body)) > limit {
+		return ChatFreePolicyError("request_body_unavailable_or_too_large")
+	}
+	if err := validateChatFreeBody(body); err != nil {
+		return err
+	}
+	req.Body = io.NopCloser(bytes.NewReader(body))
+	req.ContentLength = int64(len(body))
+	// 本次真实出站资格冻结，后续管理员改价只约束新请求，不追溯改变在途请求的合同。
+	price := info.PriceData
+	if price.OtherRatios != nil {
+		price.OtherRatios = make(map[string]float64, len(info.PriceData.OtherRatios))
+		for key, value := range info.PriceData.OtherRatios {
+			price.OtherRatios[key] = value
+		}
+	}
+	info.ChatFreeRequestPrice = &price
+	info.ChatFreeRequestChannel = info.ChannelId
+	info.ChatFreeRequestValidated = true
+	return nil
+}
+
+// IsValidatedChatFreeRequest 仅认可本次已通过最终出站守卫的零价资格快照，不重查可变全局价。
+// 价格预检、客户端模型名或旧重试留下的状态不能单独获得附加违规费例外。
+func IsValidatedChatFreeRequest(info *relaycommon.RelayInfo) bool {
+	if info == nil || !info.ChatOAuthFreeModel || !info.ChatFreeRequestValidated || info.ChatFreeRequestPrice == nil ||
+		info.ChannelMeta == nil || info.ChannelId != info.ChatFreeRequestChannel || info.OriginModelName != constant.ChatFreeModel ||
+		info.ChannelType != constant.ChannelTypeOpenRouter || strings.TrimRight(info.ChannelBaseUrl, "/") != "https://openrouter.ai/api" ||
+		info.IsModelMapped || info.UpstreamModelName != constant.ChatFreeModel {
+		return false
+	}
+	price := info.ChatFreeRequestPrice
+	return price.FreeModel && price.QuotaToPreConsume == 0 &&
+		((price.UsePrice && price.ModelPrice == 0) || (!price.UsePrice && price.ModelRatio == 0))
+}
+
+// validateChatFreeBody 校验最终 JSON 的模型、回退及附加能力；不修改客户端参数。
+func validateChatFreeBody(body []byte) error {
+	var request map[string]json.RawMessage
+	if common.Unmarshal(body, &request) != nil || request == nil {
+		return ChatFreePolicyError("invalid_request_json")
+	}
+	var model string
+	if common.Unmarshal(request["model"], &model) != nil || model != constant.ChatFreeModel {
+		return ChatFreePolicyError("final_model_changed")
+	}
+	if raw, exists := request["models"]; exists {
+		var fallbacks []string
+		if common.Unmarshal(raw, &fallbacks) != nil {
+			return ChatFreePolicyError("invalid_fallback_models")
+		}
+		for _, fallback := range fallbacks {
+			if fallback != constant.ChatFreeModel {
+				return ChatFreePolicyError("unapproved_fallback_model")
+			}
+		}
+	}
+	for _, field := range []string{"plugins", "web_search_options", "search_parameters", "web_search", "enable_search", "audio", "extra_body"} {
+		if field == "extra_body" && string(bytes.TrimSpace(request[field])) == "{}" {
+			continue
+		}
+		if raw, exists := request[field]; exists && string(bytes.TrimSpace(raw)) != "null" && string(bytes.TrimSpace(raw)) != "false" && string(bytes.TrimSpace(raw)) != "[]" {
+			return ChatFreePolicyError("unapproved_addon_" + field)
+		}
+	}
+	if raw, exists := request["modalities"]; exists {
+		var modalities []string
+		if common.Unmarshal(raw, &modalities) != nil {
+			return ChatFreePolicyError("invalid_modalities")
+		}
+		for _, modality := range modalities {
+			if modality != "text" {
+				return ChatFreePolicyError("nontext_output_not_free")
+			}
+		}
+	}
+	return validateChatFreeTools(request["tools"], false)
+}
+
+// validateChatFreeTools 允许由客户端执行的 function 工具；服务端工具不属于免费合同。
+func validateChatFreeTools(raw json.RawMessage, response bool) error {
+	if len(raw) == 0 || string(bytes.TrimSpace(raw)) == "null" {
+		return nil
+	}
+	var tools []struct {
+		Type string `json:"type"`
+	}
+	if common.Unmarshal(raw, &tools) == nil {
+		for _, tool := range tools {
+			if tool.Type != "function" {
+				if response {
+					return ChatFreeUsageError("server_tool_returned")
+				}
+				return ChatFreePolicyError("server_tools_not_free")
+			}
+		}
+		return nil
+	}
+	if response {
+		return ChatFreeUsageError("invalid_response_tools")
+	}
+	return ChatFreePolicyError("invalid_tools")
+}
+
+// ValidateChatFreeUpstreamResponse 在写回非流响应或每个 SSE 帧之前检查可用的真实费用证据。
+// cost 缺失不伪造为零；显式非零/无效 cost、上游失败或服务端工具均明确失败。
+func ValidateChatFreeUpstreamResponse(info *relaycommon.RelayInfo, body []byte) *types.NewAPIError {
+	if info == nil || !info.ChatOAuthFreeModel {
+		return nil
+	}
+	var envelope map[string]json.RawMessage
+	if common.Unmarshal(body, &envelope) != nil || envelope == nil {
+		return ChatFreeUsageError("invalid_upstream_json")
+	}
+	var event string
+	_ = common.Unmarshal(envelope["type"], &event)
+	if raw, exists := envelope["response"]; exists && string(bytes.TrimSpace(raw)) != "null" {
+		if common.Unmarshal(raw, &envelope) != nil || envelope == nil {
+			return ChatFreeUsageError("invalid_response_envelope")
+		}
+	}
+	if raw, exists := envelope["error"]; exists && string(bytes.TrimSpace(raw)) != "null" {
+		// 保留上游违规拒绝原因，继续交由原有规范化、拒绝和错误审计边界处理。
+		var value any
+		if common.Unmarshal(raw, &value) == nil {
+			if upstream := dto.GetOpenAIError(value); upstream != nil && upstream.Message != "" {
+				return ChatFreeUsageError("upstream_error: " + upstream.Message)
+			}
+		}
+		return ChatFreeUsageError("upstream_error")
+	}
+	if event == "error" || event == "response.failed" || event == "response.error" {
+		return ChatFreeUsageError("upstream_failed")
+	}
+	if raw, exists := envelope["usage"]; exists && string(bytes.TrimSpace(raw)) != "null" {
+		var usage map[string]json.RawMessage
+		if common.Unmarshal(raw, &usage) != nil {
+			return ChatFreeUsageError("invalid_upstream_usage")
+		}
+		if cost, exists := usage["cost"]; exists {
+			value := strings.TrimSpace(string(cost))
+			if len(value) > 0 && value[0] == '"' {
+				if common.Unmarshal(cost, &value) != nil {
+					return ChatFreeUsageError("invalid_upstream_cost")
+				}
+			}
+			amount, err := decimal.NewFromString(value)
+			if err != nil || !amount.IsZero() {
+				return ChatFreeUsageError("nonzero_or_invalid_upstream_cost")
+			}
+		}
+	}
+	if err := validateChatFreeTools(envelope["tools"], true); err != nil {
+		return ChatFreeUsageError("server_tool_returned")
+	}
+	var output []struct {
+		Type string `json:"type"`
+	}
+	if raw, exists := envelope["output"]; exists {
+		if common.Unmarshal(raw, &output) != nil {
+			return ChatFreeUsageError("invalid_response_output")
+		}
+	}
+	if raw, exists := envelope["item"]; exists {
+		var item struct {
+			Type string `json:"type"`
+		}
+		if common.Unmarshal(raw, &item) != nil {
+			return ChatFreeUsageError("invalid_response_item")
+		}
+		output = append(output, item)
+	}
+	for _, item := range output {
+		if item.Type != "message" && item.Type != "reasoning" && item.Type != "function_call" {
+			return ChatFreeUsageError("unapproved_response_item")
+		}
+	}
+	return nil
+}
+
+// ValidateChatFreeStreamEnd 要求真实协议终止证据并检查 scanner 的结束原因；不能用估算补成功。
+// chatCompletions 为 true 时另要求 [DONE]；Responses 允许合法终帧后的正常 EOF。
+func ValidateChatFreeStreamEnd(info *relaycommon.RelayInfo, terminal, chatCompletions bool) *types.NewAPIError {
+	if info == nil || !info.ChatOAuthFreeModel {
+		return nil
+	}
+	status := info.StreamStatus
+	if !terminal || status == nil || status.HasErrors() || status.EndError != nil {
+		return ChatFreeUsageError("missing_or_invalid_terminal_stream")
+	}
+	if status.EndReason != relaycommon.StreamEndReasonDone &&
+		(chatCompletions || status.EndReason != relaycommon.StreamEndReasonEOF) {
+		return ChatFreeUsageError("abnormal_stream_end")
+	}
+	return nil
+}
