+func TestChatFreeFinalRequestGuard(t *testing.T) {
+	info := chatFreeFixture(t)
+	for _, tc := range []struct {
+		name, body string
+		reject     bool
+	}{
+		{"chat", `{"model":"openrouter/free","messages":[{"role":"user","content":"hi"}]}`, false},
+		{"responses and client function", `{"model":"openrouter/free","input":"hi","tools":[{"type":"function","name":"client_function"}]}`, false},
+		{"changed model", `{"model":"paid-model"}`, true},
+		{"paid fallback", `{"model":"openrouter/free","models":["openrouter/free","paid-model"]}`, true},
+		{"paid plugin", `{"model":"openrouter/free","plugins":[{"id":"web"}]}`, true},
+		{"server tool", `{"model":"openrouter/free","tools":[{"type":"web_search_preview"}]}`, true},
+		{"audio output", `{"model":"openrouter/free","modalities":["text","audio"]}`, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			req := httptest.NewRequest("POST", "https://openrouter.ai/api/v1/responses", strings.NewReader(tc.body))
+			req.Header.Set("Authorization", "Bearer synthetic-key")
+			err := ValidateChatFreeHTTPRequest(info, req)
+			if tc.reject {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			body, err := io.ReadAll(req.Body)
+			require.NoError(t, err)
+			require.Equal(t, tc.body, string(body), "guard must not rewrite the approved payload")
+		})
+	}
+	for _, url := range []string{"http://openrouter.ai/api/v1/responses", "https://other.invalid/api/v1/responses", "https://openrouter.ai/api/v1/responses?model=paid"} {
+		req := httptest.NewRequest("POST", url, strings.NewReader(`{"model":"openrouter/free"}`))
+		require.Error(t, ValidateChatFreeHTTPRequest(info, req))
+	}
+	req := httptest.NewRequest("POST", "https://openrouter.ai/api/v1/responses", strings.NewReader(`{"model":"openrouter/free"}`))
+	req.Host = "other.invalid"
+	require.Error(t, ValidateChatFreeHTTPRequest(info, req))
+	info.IsModelMapped = true
+	require.Error(t, ValidateChatFreePricing(info, 1))
+	info.IsModelMapped = false
+	info.ChannelType = constant.ChannelTypeOpenAI
+	require.Error(t, ValidateChatFreePricing(info, 1), "retry cannot escape into another channel type")
+}
