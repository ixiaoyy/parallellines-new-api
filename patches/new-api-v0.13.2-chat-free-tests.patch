+func chatFreeFixture(t *testing.T) *relaycommon.RelayInfo {
+	t.Helper()
+	oldPrices, oldRatios := ratio_setting.ModelPrice2JSONString(), ratio_setting.ModelRatio2JSONString()
+	settings := model_setting.GetGrokSettings()
+	oldGrok := *settings
+	billing := config.GlobalConfig.Get("billing_setting").(*billing_setting.BillingSetting)
+	oldModes := billing.BillingMode
+	billing.BillingMode = map[string]string{}
+	settings.ViolationDeductionEnabled = false
+	require.NoError(t, ratio_setting.UpdateModelPriceByJSONString(`{}`))
+	require.NoError(t, ratio_setting.UpdateModelRatioByJSONString(`{"openrouter/free":0}`))
+	t.Cleanup(func() {
+		*settings = oldGrok
+		billing.BillingMode = oldModes
+		_ = ratio_setting.UpdateModelPriceByJSONString(oldPrices)
+		_ = ratio_setting.UpdateModelRatioByJSONString(oldRatios)
+	})
+	return &relaycommon.RelayInfo{
+		ChatOAuthFreeModel: true,
+		OriginModelName:    constant.ChatFreeModel,
+		ChannelMeta:        &relaycommon.ChannelMeta{ChannelType: constant.ChannelTypeOpenRouter, ChannelBaseUrl: "https://openrouter.ai/api", UpstreamModelName: constant.ChatFreeModel, ApiKey: "synthetic-key"},
+		PriceData:          types.PriceData{FreeModel: true, GroupRatioInfo: types.GroupRatioInfo{GroupRatio: 1}},
+	}
+}
