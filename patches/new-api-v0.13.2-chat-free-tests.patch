+package openai
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/types"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+type chatFreeReadError struct{}
+
+func (chatFreeReadError) Read([]byte) (int, error) { return 0, io.ErrUnexpectedEOF }
+
+func TestChatFreeStreamNeverSynthesizesSuccessAfterFailure(t *testing.T) {
+	// 直接执行原生扫描器时补齐应用启动才设置的超时，不修改生产默认值。
+	oldStreamingTimeout := constant.StreamingTimeout
+	constant.StreamingTimeout = 30
+	t.Cleanup(func() { constant.StreamingTimeout = oldStreamingTimeout })
+	chatPrefix := "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"partial\"}}]}\n\ndata: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n"
+	responsesPrefix := "data: {\"type\":\"response.output_text.delta\",\"delta\":\"partial\"}\n\n"
+	responsesTerminal := "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"synthetic\",\"output\":[],\"usage\":{\"input_tokens\":1,\"output_tokens\":1,\"total_tokens\":2,\"cost\":0}}}\n\n"
+	for _, tc := range []struct {
+		name      string
+		prefix    string
+		readError bool
+		handler   func(*gin.Context, *relaycommon.RelayInfo, *http.Response) (*dto.Usage, *types.NewAPIError)
+	}{
+		{"chat read error after finish", chatPrefix, true, OaiStreamHandler},
+		{"chat EOF without DONE", chatPrefix, false, OaiStreamHandler},
+		{"responses conversion read error after terminal", responsesPrefix + responsesTerminal, true, OaiResponsesToChatStreamHandler},
+		{"responses conversion EOF without terminal", responsesPrefix, false, OaiResponsesToChatStreamHandler},
+		{"native responses read error after terminal", responsesPrefix + responsesTerminal, true, OaiResponsesStreamHandler},
+		{"native responses EOF without terminal", responsesPrefix, false, OaiResponsesStreamHandler},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(w)
+			c.Request = httptest.NewRequest("POST", "/v1/chat/completions", nil)
+			info := &relaycommon.RelayInfo{ChatOAuthFreeModel: true, OriginModelName: constant.ChatFreeModel, IsStream: true, RelayFormat: types.RelayFormatOpenAI, ShouldIncludeUsage: true,
+				ChannelMeta: &relaycommon.ChannelMeta{UpstreamModelName: constant.ChatFreeModel, ChannelType: constant.ChannelTypeOpenRouter}}
+			var body io.Reader = strings.NewReader(tc.prefix)
+			if tc.readError {
+				body = io.MultiReader(body, chatFreeReadError{})
+			}
+			resp := &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"text/event-stream"}}, Body: io.NopCloser(body)}
+			_, err := tc.handler(c, info, resp)
+			require.NotNil(t, err)
+			require.Equal(t, service.ChatFreeUsageErrorCode, err.GetErrorCode())
+			require.True(t, types.IsSkipRetryError(err))
+			require.NotContains(t, w.Body.String(), "[DONE]")
+			require.NotContains(t, w.Body.String(), `"finish_reason":"stop"`)
+			require.NotContains(t, w.Body.String(), `"type":"response.completed"`)
+		})
+	}
+}
