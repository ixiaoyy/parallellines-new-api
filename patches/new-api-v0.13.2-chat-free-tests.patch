+func TestChatFreeEffectivePricing(t *testing.T) {
+	info := chatFreeFixture(t)
+	require.NoError(t, ValidateChatFreePricing(info, 1))
+	require.NoError(t, ratio_setting.UpdateModelPriceByJSONString(`{"openrouter/free":0.1}`))
+	require.Error(t, ValidateChatFreePricing(info, 0), "group zero must not hide a nonzero effective fixed price")
+	require.NoError(t, ratio_setting.UpdateModelPriceByJSONString(`{"openrouter/free":0}`))
+	require.NoError(t, ratio_setting.UpdateModelRatioByJSONString(`{"openrouter/free":10}`))
+	require.NoError(t, ValidateChatFreePricing(info, 1), "effective zero fixed price has normal precedence")
+	config.GlobalConfig.Get("billing_setting").(*billing_setting.BillingSetting).BillingMode[constant.ChatFreeModel] = billing_setting.BillingModeTieredExpr
+	require.Error(t, ValidateChatFreePricing(info, 1))
+	delete(config.GlobalConfig.Get("billing_setting").(*billing_setting.BillingSetting).BillingMode, constant.ChatFreeModel)
+	settings := model_setting.GetGrokSettings()
+	settings.ViolationDeductionEnabled, settings.ViolationDeductionAmount = true, 0.05
+	require.NoError(t, ValidateChatFreePricing(info, 1), "approved free Chat scope does not disable ordinary fee settings")
+	require.False(t, IsValidatedChatFreeRequest(info), "pricing alone does not grant a fee exception")
+	req := httptest.NewRequest("POST", "https://openrouter.ai/api/v1/responses", strings.NewReader(`{"model":"openrouter/free","input":"hi"}`))
+	req.Header.Set("Authorization", "Bearer synthetic-key")
+	require.NoError(t, ValidateChatFreeHTTPRequest(info, req))
+	require.True(t, IsValidatedChatFreeRequest(info))
+	require.NoError(t, ratio_setting.UpdateModelPriceByJSONString(`{"openrouter/free":0.2}`))
+	require.True(t, IsValidatedChatFreeRequest(info), "configuration changes do not revoke the completed outgoing qualification")
+	next := *info
+	require.Error(t, ValidateChatFreeHTTPRequest(&next, httptest.NewRequest("POST", "https://openrouter.ai/api/v1/responses", strings.NewReader(`{"model":"openrouter/free"}`))))
+	require.False(t, IsValidatedChatFreeRequest(&next))
+	info.IsModelMapped = true
+	require.False(t, IsValidatedChatFreeRequest(info))
+	info.ChatOAuthFreeModel = false
+	require.NoError(t, ValidateChatFreePricing(info, 1), "unrelated callers retain their original path")
+}
