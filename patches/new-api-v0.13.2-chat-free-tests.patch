+func TestChatFreeRawUsageIsNotZeroed(t *testing.T) {
+	info := chatFreeFixture(t)
+	for _, body := range []string{
+		`{"usage":{"cost":0}}`,
+		`{"type":"response.completed","response":{"usage":{"cost":"0.000"},"output":[{"type":"message"}]}}`,
+		`{"type":"response.output_item.added","item":{"type":"function_call"}}`,
+		`{"usage":{"input_tokens":1}}`,
+	} {
+		require.Nil(t, ValidateChatFreeUpstreamResponse(info, []byte(body)), body)
+	}
+	for _, body := range []string{
+		`{"usage":{"cost":0.01}}`,
+		`{"type":"response.completed","response":{"usage":{"cost":1e-100}}}`,
+		`{"usage":{"cost":null}}`,
+		`{"usage":{"cost":"NaN"}}`,
+		`{"type":"response.output_item.done","item":{"type":"web_search_call"}}`,
+		`{"error":{"message":"upstream rejected the request"}}`,
+	} {
+		err := ValidateChatFreeUpstreamResponse(info, []byte(body))
+		require.NotNil(t, err, body)
+		require.Equal(t, ChatFreeUsageErrorCode, err.GetErrorCode())
+		require.False(t, types.IsChannelError(err))
+		require.True(t, types.IsSkipRetryError(err))
+	}
+	info.ChatOAuthFreeModel = false
+	require.Nil(t, ValidateChatFreeUpstreamResponse(info, []byte(`{"usage":{"cost":2}}`)))
+}
