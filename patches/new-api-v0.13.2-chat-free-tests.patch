+// The only HTTP transports are local functions. No sockets, actual identities or paid models are used.
+func TestChatFreeNativeRelayIntegration(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	require.NoError(t, i18n.Init())
+	oldDB, oldPath, oldMaster := model.DB, common.SQLitePath, common.IsMasterNode
+	oldRedis, oldBatch, oldMemory := common.RedisEnabled, common.BatchUpdateEnabled, common.MemoryCacheEnabled
+	oldCount, oldTransport, oldLog := constant.CountToken, http.DefaultTransport, common.LogConsumeEnabled
