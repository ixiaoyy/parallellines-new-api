+	if err != nil || len(listed) != 2 {
+		t.Fatal("self token list included internal/other user's credentials")
+	}
+	if count, err := CountUserTokens(user.Id); err != nil || count != 2 {
+		t.Fatal("self token count included internal credentials")
+	}
+	searched, count, err := SearchUserTokens(user.Id, "", "", 0, 100)
+	if err != nil || count != 2 || len(searched) != 2 {
+		t.Fatal("self token search included internal credentials")
+	}
+	searched, count, err = SearchUserTokens(user.Id, "", internal.Key, 0, 100)
+	if err != nil || count != 0 || len(searched) != 0 {
+		t.Fatal("exact key search exposed internal credentials")
+	}
+	if _, err := GetTokenByIds(internal.Id, user.Id); !errors.Is(err, gorm.ErrRecordNotFound) {
+		t.Fatal("self fetch/key/update guard accepted internal credential")
+	}
+	if err := DeleteTokenById(internal.Id, user.Id); !errors.Is(err, gorm.ErrRecordNotFound) {
+		t.Fatal("self delete accepted internal credential")
+	}
+	keys, err := GetTokenKeysByIds([]int{internal.Id, normal1.Id, other.Id}, user.Id)
+	if err != nil || len(keys) != 1 || keys[0].Id != normal1.Id {
+		t.Fatal("batch key export exposed internal/other user's credential")
+	}
+	removed, err := BatchDeleteTokens([]int{internal.Id, normal1.Id, other.Id}, user.Id)
+	if err != nil || removed != 1 {
+		t.Fatal("batch delete affected protected credentials")
+	}
+	for _, token := range []*Token{internal, normal2, other} {
