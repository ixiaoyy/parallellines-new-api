@@ -0,0 +1,61 @@
+package oauth
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"net/url"
+	"os"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+)
+
+const PKCEVerifierContextKey = "custom_oauth_pkce_verifier"
+const PKCERedirectContextKey = "custom_oauth_pkce_redirect"
+
+// CustomPKCEEnabled is explicitly opt-in per custom provider slug. Legacy providers
+// retain their upstream behavior; selected providers never fall back without PKCE.
+func CustomPKCEEnabled(slug string) bool {
+	for _, allowed := range strings.Split(os.Getenv("CUSTOM_OAUTH_PKCE_PROVIDERS"), ",") {
+		if strings.TrimSpace(allowed) == slug && slug != "" {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *GenericOAuthProvider) Snapshot() *GenericOAuthProvider {
+	config := *p.config
+	return NewGenericOAuthProvider(&config)
+}
+
+// PKCEConfiguration freezes the trusted redirect and all provider security settings.
+// The client secret is excluded from the model's JSON, so include it explicitly in
+// this internal hash. Neither the payload nor its digest is returned to browsers.
+func (p *GenericOAuthProvider) PKCEConfiguration() (string, string, error) {
+	base, err := url.Parse(system_setting.ServerAddress)
+	if err != nil || base.Scheme != "https" || base.Host == "" || base.User != nil ||
+		base.RawQuery != "" || base.Fragment != "" || (base.Path != "" && base.Path != "/") {
+		return "", "", fmt.Errorf("PKCE requires an HTTPS ServerAddress origin")
+	}
+	for _, endpoint := range []string{p.config.AuthorizationEndpoint, p.config.TokenEndpoint, p.config.UserInfoEndpoint} {
+		u, parseErr := url.Parse(endpoint)
+		if parseErr != nil || u.Scheme != "https" || u.Host == "" || u.User != nil || u.Fragment != "" {
+			return "", "", fmt.Errorf("PKCE requires HTTPS provider endpoints")
+		}
+	}
+	redirect := strings.TrimRight(system_setting.ServerAddress, "/") + "/oauth/" + p.config.Slug
+	payload, err := common.Marshal(struct {
+		Provider model.CustomOAuthProvider
+		Secret   string
+		Redirect string
+	}{*p.config, p.config.ClientSecret, redirect})
+	if err != nil {
+		return "", "", err
+	}
+	hash := sha256.Sum256(payload)
+	return redirect, hex.EncodeToString(hash[:]), nil
+}
diff --git a/pkg/oauthpkce/store.go b/pkg/oauthpkce/store.go
new file mode 100644
index 0000000..c273266
--- /dev/null
+++ b/pkg/oauthpkce/store.go
@@ -0,0 +1,111 @@
+// Package oauthpkce holds short-lived, single-use OAuth authorization transactions.
+// It deliberately stores verifiers on the server, never in the signed session cookie.
+package oauthpkce
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"sync"
+	"time"
+)
+
+var (
+	ErrInvalidState = errors.New("invalid or expired OAuth transaction")
+	ErrCapacity     = errors.New("too many pending OAuth transactions")
+)
+
+type Binding struct {
+	Session     string
+	UserID      int
+	ProviderID  int
+	Fingerprint string
+}
+
+type transaction struct {
+	binding  Binding
+	verifier string
+	expires  time.Time
+}
+
+type Store struct {
+	mu       sync.Mutex
+	pending  map[[32]byte]transaction
+	ttl      time.Duration
+	capacity int
+	now      func() time.Time
+}
+
+func NewStore(ttl time.Duration, capacity int) *Store {
+	return &Store{pending: make(map[[32]byte]transaction), ttl: ttl, capacity: capacity, now: time.Now}
+}
+
+func RandomValue() (string, error) {
+	var b [32]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(b[:]), nil
+}
+
+func Challenge(verifier string) string {
+	digest := sha256.Sum256([]byte(verifier))
+	return base64.RawURLEncoding.EncodeToString(digest[:])
+}
+
+func (s *Store) prune(now time.Time) {
+	for key, tx := range s.pending {
+		if !now.Before(tx.expires) {
+			delete(s.pending, key)
+		}
+	}
+}
+
+func (s *Store) Issue(binding Binding) (string, string, error) {
+	if binding.Session == "" || binding.ProviderID <= 0 || binding.Fingerprint == "" {
+		return "", "", ErrInvalidState
+	}
+	state, err := RandomValue()
+	if err != nil {
+		return "", "", err
+	}
+	verifier, err := RandomValue()
+	if err != nil {
+		return "", "", err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.now()
+	s.prune(now)
+	count := 0
+	for _, tx := range s.pending {
+		if tx.binding.Session == binding.Session {
+			count++
+		}
+	}
+	if len(s.pending) >= s.capacity || count >= 8 {
+		return "", "", ErrCapacity
+	}
+	key := sha256.Sum256([]byte(state))
+	if _, exists := s.pending[key]; exists {
+		return "", "", ErrCapacity
+	}
+	s.pending[key] = transaction{binding: binding, verifier: verifier, expires: now.Add(s.ttl)}
+	return state, Challenge(verifier), nil
+}
+
+// Consume rejects mismatched sessions without burning another browser's transaction.
+// A matched transaction is removed atomically before any token exchange is attempted.
+func (s *Store) Consume(state string, binding Binding) (string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.prune(s.now())
+	key := sha256.Sum256([]byte(state))
+	tx, ok := s.pending[key]
+	if !ok || state == "" || tx.binding != binding {
+		return "", ErrInvalidState
+	}
+	delete(s.pending, key)
+	return tx.verifier, nil
+}
diff --git a/pkg/oauthpkce/store_test.go b/pkg/oauthpkce/store_test.go
new file mode 100644
index 0000000..5a92279
--- /dev/null
+++ b/pkg/oauthpkce/store_test.go
@@ -0,0 +1,367 @@
+package oauthpkce
+
+import (
+	"encoding/base64"
+	"errors"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+)
+
+func testBinding() Binding {
+	return Binding{
+		Session:     "test-browser-binding",
+		UserID:      17,
+		ProviderID:  3,
+		Fingerprint: "test-config-fingerprint",
+	}
+}
+
+func requireRandomValue(t *testing.T, label, value string) {
+	t.Helper()
+	if len(value) != 43 {
+		t.Fatalf("%s length = %d, want 43", label, len(value))
+	}
+	decoded, err := base64.RawURLEncoding.DecodeString(value)
+	if err != nil {
+		t.Fatalf("%s is not unpadded base64url: %v", label, err)
+	}
+	if len(decoded) != 32 {
+		t.Fatalf("%s decodes to %d bytes, want 32", label, len(decoded))
+	}
+}
+
+func requireIssue(t *testing.T, store *Store, binding Binding) (string, string) {
+	t.Helper()
+	state, challenge, err := store.Issue(binding)
+	if err != nil {
+		t.Fatalf("Issue() error: %v", err)
+	}
+	requireRandomValue(t, "state", state)
+	requireRandomValue(t, "challenge", challenge)
+	return state, challenge
+}
+
+func requireConsume(t *testing.T, store *Store, state string, binding Binding, challenge string) {
+	t.Helper()
+	verifier, err := store.Consume(state, binding)
+	if err != nil {
+		t.Fatalf("Consume() error: %v", err)
+	}
+	requireRandomValue(t, "verifier", verifier)
+	if verifier == state {
+		t.Fatal("state and verifier must be generated independently")
+	}
+	if Challenge(verifier) != challenge {
+		t.Fatal("consumed verifier does not match the issued S256 challenge")
+	}
+}
+
+func requireInvalidState(t *testing.T, store *Store, state string, binding Binding) {
+	t.Helper()
+	verifier, err := store.Consume(state, binding)
+	if !errors.Is(err, ErrInvalidState) {
+		t.Fatalf("Consume() error = %v, want ErrInvalidState", err)
+	}
+	if verifier != "" {
+		t.Fatal("rejected Consume() returned a verifier")
+	}
+}
+
+func requireCapacity(t *testing.T, store *Store, binding Binding) {
+	t.Helper()
+	state, challenge, err := store.Issue(binding)
+	if !errors.Is(err, ErrCapacity) {
+		t.Fatalf("Issue() error = %v, want ErrCapacity", err)
+	}
+	if state != "" || challenge != "" {
+		t.Fatal("rejected Issue() returned transaction material")
+	}
+}
+
+func TestChallengeRFC7636(t *testing.T) {
+	// RFC 7636, Appendix B: public S256 example, not a real credential.
+	const verifier = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
+	const expected = "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
+	if got := Challenge(verifier); got != expected {
+		t.Fatalf("Challenge(RFC example) = %q, want %q", got, expected)
+	}
+}
+
+func TestRandomValueFormatAndUniqueness(t *testing.T) {
+	seen := make(map[string]bool)
+	for i := 0; i < 64; i++ {
+		value, err := RandomValue()
+		if err != nil {
+			t.Fatalf("RandomValue() error: %v", err)
+		}
+		requireRandomValue(t, "random value", value)
+		if seen[value] {
+			t.Fatal("RandomValue() repeated a value")
+		}
+		seen[value] = true
+	}
+}
+
+func TestStoreBindingMismatchDoesNotConsume(t *testing.T) {
+	tests := []struct {
+		name   string
+		change func(*Binding)
+	}{
+		{"other session", func(b *Binding) { b.Session = "other-browser" }},
+		{"missing session", func(b *Binding) { b.Session = "" }},
+		{"other user", func(b *Binding) { b.UserID++ }},
+		{"logged out", func(b *Binding) { b.UserID = 0 }},
+		{"other provider", func(b *Binding) { b.ProviderID++ }},
+		{"missing provider", func(b *Binding) { b.ProviderID = 0 }},
+		{"changed config", func(b *Binding) { b.Fingerprint = "changed-config" }},
+		{"missing config", func(b *Binding) { b.Fingerprint = "" }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			store := NewStore(5*time.Minute, 16)
+			binding := testBinding()
+			state, challenge := requireIssue(t, store, binding)
+			wrong := binding
+			tt.change(&wrong)
+			requireInvalidState(t, store, state, wrong)
+			requireConsume(t, store, state, binding, challenge)
+		})
+	}
+	t.Run("anonymous initiation then login", func(t *testing.T) {
+		store := NewStore(5*time.Minute, 16)
+		anonymous := testBinding()
+		anonymous.UserID = 0
+		state, challenge := requireIssue(t, store, anonymous)
+		requireInvalidState(t, store, state, testBinding())
+		requireConsume(t, store, state, anonymous, challenge)
+	})
+}
+
+func TestStoreMissingUnknownAndReplayedState(t *testing.T) {
+	store := NewStore(5*time.Minute, 16)
+	binding := testBinding()
+	state, challenge := requireIssue(t, store, binding)
+	requireInvalidState(t, store, "", binding)
+	requireInvalidState(t, store, "unknown-state", binding)
+	requireConsume(t, store, state, binding, challenge)
+	requireInvalidState(t, store, state, binding)
+}
+
+func TestStoreExpiryBoundary(t *testing.T) {
+	const ttl = 5 * time.Minute
+	base := time.Date(2026, time.January, 1, 0, 0, 0, 0, time.UTC)
+	for _, tt := range []struct {
+		name    string
+		elapsed time.Duration
+		expired bool
+	}{
+		{"just before expiry", ttl - time.Nanosecond, false},
+		{"exactly at expiry", ttl, true},
+		{"after expiry", ttl + time.Nanosecond, true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			now := base
+			store := NewStore(ttl, 16)
+			store.now = func() time.Time { return now }
+			binding := testBinding()
+			state, challenge := requireIssue(t, store, binding)
+			now = base.Add(tt.elapsed)
+			if tt.expired {
+				requireInvalidState(t, store, state, binding)
+			} else {
+				requireConsume(t, store, state, binding, challenge)
+			}
+		})
+	}
+}
+
+func TestStoreMultipleTabsAreIndependent(t *testing.T) {
+	store := NewStore(5*time.Minute, 16)
+	binding := testBinding()
+	var states, challenges []string
+	seen := make(map[string]bool)
+	for i := 0; i < 5; i++ {
+		state, challenge := requireIssue(t, store, binding)
+		if seen[state] {
+			t.Fatal("Issue() repeated a pending state")
+		}
+		seen[state] = true
+		states = append(states, state)
+		challenges = append(challenges, challenge)
+	}
+	// Tabs may complete in a different order from their initiation.
+	for i := len(states) - 1; i >= 0; i-- {
+		requireConsume(t, store, states[i], binding, challenges[i])
+		requireInvalidState(t, store, states[i], binding)
+	}
+}
+
+func TestStoreConcurrentConsumeHasExactlyOneWinner(t *testing.T) {
+	store := NewStore(5*time.Minute, 16)
+	binding := testBinding()
+	state, challenge := requireIssue(t, store, binding)
+	const attempts = 64
+	type result struct {
+		verifier string
+		err      error
+	}
+	start := make(chan struct{})
+	results := make(chan result, attempts)
+	var wg sync.WaitGroup
+	for i := 0; i < attempts; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			verifier, err := store.Consume(state, binding)
+			results <- result{verifier, err}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	winners := 0
+	for result := range results {
+		if result.err == nil {
+			winners++
+			requireRandomValue(t, "winning verifier", result.verifier)
+			if Challenge(result.verifier) != challenge {
+				t.Fatal("winning verifier does not match challenge")
+			}
+		} else if !errors.Is(result.err, ErrInvalidState) || result.verifier != "" {
+			t.Fatalf("losing Consume() returned unexpected result: error=%v, verifier present=%t", result.err, result.verifier != "")
+		}
+	}
+	if winners != 1 {
+		t.Fatalf("successful concurrent consumes = %d, want 1", winners)
+	}
+}
+
+func TestStoreGlobalCapacityDoesNotEvictPendingTransactions(t *testing.T) {
+	store := NewStore(5*time.Minute, 2)
+	a, b, c := testBinding(), testBinding(), testBinding()
+	b.Session = "browser-b"
+	c.Session = "browser-c"
+	stateA, challengeA := requireIssue(t, store, a)
+	stateB, challengeB := requireIssue(t, store, b)
+	requireCapacity(t, store, c)
+	requireConsume(t, store, stateA, a, challengeA)
+	stateC, challengeC := requireIssue(t, store, c)
+	requireConsume(t, store, stateB, b, challengeB)
+	requireConsume(t, store, stateC, c, challengeC)
+}
+
+func TestStorePerBindingCapacityDoesNotEvictPendingTransactions(t *testing.T) {
+	store := NewStore(5*time.Minute, 32)
+	binding := testBinding()
+	var states, challenges []string
+	for i := 0; i < 8; i++ {
+		state, challenge := requireIssue(t, store, binding)
+		states = append(states, state)
+		challenges = append(challenges, challenge)
+	}
+	requireCapacity(t, store, binding)
+	other := binding
+	other.Session = "other-browser"
+	otherState, otherChallenge := requireIssue(t, store, other)
+	requireConsume(t, store, states[0], binding, challenges[0])
+	replacement, replacementChallenge := requireIssue(t, store, binding)
+	for i := 1; i < len(states); i++ {
+		requireConsume(t, store, states[i], binding, challenges[i])
+	}
+	requireConsume(t, store, replacement, binding, replacementChallenge)
+	requireConsume(t, store, otherState, other, otherChallenge)
+}
+
+func TestStoreExpiryReleasesCapacity(t *testing.T) {
+	const ttl = 5 * time.Minute
+	for _, tt := range []struct {
+		name     string
+		capacity int
+		count    int
+	}{
+		{"global capacity", 2, 2},
+		{"per binding capacity", 32, 8},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			now := time.Date(2026, time.January, 1, 0, 0, 0, 0, time.UTC)
+			store := NewStore(ttl, tt.capacity)
+			store.now = func() time.Time { return now }
+			binding := testBinding()
+			var oldStates []string
+			for i := 0; i < tt.count; i++ {
+				state, _ := requireIssue(t, store, binding)
+				oldStates = append(oldStates, state)
+			}
+			requireCapacity(t, store, binding)
+			now = now.Add(ttl)
+			// Issue must recover expired capacity without a prior Consume call.
+			state, challenge := requireIssue(t, store, binding)
+			for _, oldState := range oldStates {
+				requireInvalidState(t, store, oldState, binding)
+			}
+			requireConsume(t, store, state, binding, challenge)
+		})
+	}
+}
+
+func TestStoreConcurrentIssueHonorsCapacity(t *testing.T) {
+	for _, tt := range []struct {
+		name        string
+		capacity    int
+		wantIssued  int
+		sameBinding bool
+	}{
+		{"global capacity", 16, 16, false},
+		{"per binding capacity", 64, 8, true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			store := NewStore(5*time.Minute, tt.capacity)
+			const attempts = 64
+			type result struct {
+				state     string
+				challenge string
+				binding   Binding
+				err       error
+			}
+			start := make(chan struct{})
+			results := make(chan result, attempts)
+			var wg sync.WaitGroup
+			for i := 0; i < attempts; i++ {
+				binding := testBinding()
+				if !tt.sameBinding {
+					binding.Session = "test-browser-" + strconv.Itoa(i)
+				}
+				wg.Add(1)
+				go func(binding Binding) {
+					defer wg.Done()
+					<-start
+					state, challenge, err := store.Issue(binding)
+					results <- result{state, challenge, binding, err}
+				}(binding)
+			}
+			close(start)
+			wg.Wait()
+			close(results)
+			seen := make(map[string]bool)
+			for result := range results {
+				if result.err != nil {
+					if !errors.Is(result.err, ErrCapacity) || result.state != "" || result.challenge != "" {
+						t.Fatalf("rejected Issue() returned unexpected result: %v", result.err)
+					}
+					continue
+				}
+				if seen[result.state] {
+					t.Fatal("concurrent Issue() repeated a pending state")
+				}
+				seen[result.state] = true
+				requireConsume(t, store, result.state, result.binding, result.challenge)
+			}
+			if len(seen) != tt.wantIssued {
+				t.Fatalf("successful concurrent issues = %d, want %d", len(seen), tt.wantIssued)
+			}
+		})
+	}
+}
diff --git a/relay/channel/openai/openai_standard_usage.go b/relay/channel/openai/openai_standard_usage.go
new file mode 100644
index 0000000..9dd847f
--- /dev/null
+++ b/relay/channel/openai/openai_standard_usage.go
@@ -0,0 +1,111 @@
+package openai
+
+import (
+	"encoding/json"
+	"errors"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/dto"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/gin-gonic/gin"
+)
+
+func standardUsageFromEnvelope(raw []byte, responses bool) (*dto.OpenAIStandardUsage, error) {
+	var envelope map[string]json.RawMessage
+	if common.Unmarshal(raw, &envelope) != nil || envelope == nil {
+		return nil, errors.New("invalid_response_envelope")
+	}
+	return service.ParseOpenAIStandardUsage(envelope["usage"], responses)
+}
+
+func standardUsageFromResponsesEvent(raw []byte) (*dto.OpenAIStandardUsage, error) {
+	var envelope map[string]json.RawMessage
+	if common.Unmarshal(raw, &envelope) != nil || envelope == nil {
+		return nil, errors.New("invalid_response_event")
+	}
+	return standardUsageFromEnvelope(envelope["response"], true)
+}
+
+func applyStandardUsage(usage *dto.Usage, verified *dto.OpenAIStandardUsage) {
+	usage.StandardOpenAIUsage = verified
+	usage.PromptTokens = verified.InputTokensTotal
+	usage.InputTokens = verified.InputTokensTotal
+	usage.CompletionTokens = verified.OutputTokens
+	usage.OutputTokens = verified.OutputTokens
+	usage.TotalTokens = verified.InputTokensTotal + verified.OutputTokens
+	usage.PromptTokensDetails.CachedTokens = verified.CacheReadTokens
+	write := verified.CacheWrite30mTokens + verified.CacheWrite12hTokens
+	usage.PromptTokensDetails.CacheWriteTokens = &write
+	usage.PromptTokensDetails.CacheWriteTokensDetails = &dto.OpenAICacheWriteTokenDetails{
+		TTL30mTokens: &verified.CacheWrite30mTokens, TTL12hTokens: &verified.CacheWrite12hTokens,
+	}
+	usage.UsageSource = "openai_standard_verified"
+}
+
+func standardChatHasOutput(raw []byte) bool {
+	type outputContent struct {
+		Content          json.RawMessage   `json:"content"`
+		ReasoningContent string            `json:"reasoning_content"`
+		Reasoning        string            `json:"reasoning"`
+		Refusal          *string           `json:"refusal"`
+		ToolCalls        []json.RawMessage `json:"tool_calls"`
+	}
+	var response struct {
+		Choices []struct {
+			Message *outputContent `json:"message"`
+			Delta   *outputContent `json:"delta"`
+		} `json:"choices"`
+	}
+	if common.Unmarshal(raw, &response) != nil {
+		return true
+	}
+	for _, choice := range response.Choices {
+		for _, m := range []*outputContent{choice.Message, choice.Delta} {
+			if m == nil {
+				continue
+			}
+			if m.ReasoningContent != "" || m.Reasoning != "" || (m.Refusal != nil && *m.Refusal != "") || len(m.ToolCalls) != 0 {
+				return true
+			}
+			if common.GetJsonType(m.Content) == "string" {
+				var text string
+				if common.Unmarshal(m.Content, &text) != nil || text != "" {
+					return true
+				}
+			} else if len(m.Content) > 0 && common.GetJsonType(m.Content) != "null" {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func captureStandardResponsesSequence(c *gin.Context, raw []byte) {
+	var envelope struct {
+		Sequence *int `json:"sequence_number"`
+	}
+	if common.Unmarshal(raw, &envelope) != nil || envelope.Sequence == nil || *envelope.Sequence < 0 || *envelope.Sequence == int(^uint(0)>>1) {
+		return
+	}
+	if _, present := c.Get("openai_standard_last_sequence"); !present || *envelope.Sequence > c.GetInt("openai_standard_last_sequence") {
+		c.Set("openai_standard_last_sequence", *envelope.Sequence)
+	}
+}
+
+// Strip only the outgoing copy. The original frame remains available for
+// strict usage validation and billing, including duplicate-frame checks.
+func standardChatOutputWithoutUsage(data string) (string, error) {
+	var envelope map[string]json.RawMessage
+	if common.UnmarshalJsonStr(data, &envelope) != nil || envelope == nil {
+		return "", errors.New("invalid_stream_output_envelope")
+	}
+	if _, exists := envelope["usage"]; !exists {
+		return data, nil
+	}
+	delete(envelope, "usage")
+	encoded, err := common.Marshal(envelope)
+	if err != nil {
+		return "", errors.New("invalid_stream_output_envelope")
+	}
+	return string(encoded), nil
+}
