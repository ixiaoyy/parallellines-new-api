+func TestOAuthRelayCredentialRefusesRevokedOrCorruptRows(t *testing.T) {
+	cases := []struct {
+		name   string
+		mutate func(*gorm.DB, *Token) error
+	}{
+		{"disabled", func(db *gorm.DB, token *Token) error {
+			return db.Model(token).Update("status", common.TokenStatusDisabled).Error
+		}},
+		{"expired", func(db *gorm.DB, token *Token) error {
+			return db.Model(token).Update("expired_time", common.GetTimestamp()-1).Error
+		}},
+		{"deleted", func(db *gorm.DB, token *Token) error { return db.Delete(token).Error }},
+		{"model_limits_disabled", func(db *gorm.DB, token *Token) error {
+			return db.Model(token).Update("model_limits_enabled", false).Error
+		}},
+		{"extra_model", func(db *gorm.DB, token *Token) error {
+			return db.Model(token).Update("model_limits", OAuthRelayModelLimits+",unapproved-model").Error
+		}},
+		{"group_override", func(db *gorm.DB, token *Token) error { return db.Model(token).Update("group", "vip").Error }},
+		{"key_separator", func(db *gorm.DB, token *Token) error {
+			return db.Model(token).Update("key", strings.Repeat("A", 47)+"-").Error
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			db := oauthRelayTestDB(t)
+			user := oauthRelayFixture(t, db, 11, "stable-sub-A")
+			token, err := GetOrCreateOAuthRelayToken(user.Id)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := tc.mutate(db, token); err != nil {
+				t.Fatal(err)
+			}
+			if found, err := GetOrCreateOAuthRelayToken(user.Id); found != nil || !errors.Is(err, ErrOAuthRelayCredentialUnavailable) {
+				t.Fatal("revoked/corrupt credential was repaired or reissued")
+			}
+			var count int64
+			if err := db.Unscoped().Model(&Token{}).Where("user_id = ?", user.Id).Count(&count).Error; err != nil || count != 1 {
+				t.Fatal("a replacement credential was created")
+			}
+		})
+	}
+}
