+package service
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/dto"
+)
+
+// ParseOpenAIStandardUsage accepts actual upstream counters, never estimates.
+// Core counters require presence even for zero. Optional cache counters default
+// to zero when absent; explicit null and invalid values are rejected. Missing
+// usage cannot silently become zero. Only fixed safe field names
+// are returned in errors; response content is never included.
+func ParseOpenAIStandardUsage(rawUsage []byte, responses bool) (*dto.OpenAIStandardUsage, error) {
+	var fields map[string]json.RawMessage
+	if len(rawUsage) == 0 || common.Unmarshal(rawUsage, &fields) != nil || fields == nil {
+		return nil, errors.New("missing_or_invalid_usage")
+	}
+	promptKey, outputKey, detailsKey := "prompt_tokens", "completion_tokens", "prompt_tokens_details"
+	if responses {
+		promptKey, outputKey, detailsKey = "input_tokens", "output_tokens", "input_tokens_details"
+	}
+	readCount := func(object map[string]json.RawMessage, key string) (int, error) {
+		var value *int
+		if raw, ok := object[key]; !ok || common.Unmarshal(raw, &value) != nil || value == nil || *value < 0 || *value > 1_000_000_000 {
+			return 0, fmt.Errorf("missing_or_invalid_%s", key)
+		}
+		return *value, nil
+	}
+	input, err := readCount(fields, promptKey)
+	if err != nil {
+		return nil, err
+	}
+	output, err := readCount(fields, outputKey)
+	if err != nil {
+		return nil, err
+	}
+	total, err := readCount(fields, "total_tokens")
+	if err != nil {
+		return nil, err
+	}
+	if input > total || output != total-input {
+		return nil, errors.New("inconsistent_total_tokens")
+	}
+	var details map[string]json.RawMessage
+	if raw, present := fields[detailsKey]; present {
+		if common.Unmarshal(raw, &details) != nil || details == nil {
+			return nil, errors.New("invalid_input_token_details")
+		}
+	} else {
+		details = map[string]json.RawMessage{}
+	}
+	optionalCount := func(object map[string]json.RawMessage, key string) (int, error) {
+		if _, ok := object[key]; !ok {
+			return 0, nil
+		}
+		return readCount(object, key)
+	}
+	read, err := optionalCount(details, "cached_tokens")
+	if err != nil {
+		return nil, err
+	}
+	write, err := optionalCount(details, "cache_write_tokens")
+	if err != nil {
+		return nil, err
+	}
+	if read > input || write > input-read {
+		return nil, errors.New("inconsistent_cache_partition")
+	}
+	write30, write12 := 0, 0
+	var durations map[string]json.RawMessage
+	if raw, ok := details["cache_write_tokens_details"]; ok {
+		if common.Unmarshal(raw, &durations) != nil {
+			return nil, errors.New("invalid_cache_write_details")
+		}
+	}
+	if durations != nil {
+		write30, err = readCount(durations, "ttl_30m_tokens")
+		if err != nil {
+			return nil, err
+		}
+		write12, err = readCount(durations, "ttl_12h_tokens")
+		if err != nil {
+			return nil, err
+		}
+		if write30 > write || write12 != write-write30 {
+			return nil, errors.New("inconsistent_cache_write_durations")
+		}
+	} else if responses && write != 0 {
+		return nil, errors.New("missing_cache_write_durations")
+	} else {
+		// Chat's verified request-level contract permits 30m only. A Responses
+		// write with no split is ambiguous and was rejected above.
+		write30 = write
+	}
+	if !responses && write12 != 0 {
+		return nil, errors.New("unsupported_chat_cache_write_duration")
+	}
+	return &dto.OpenAIStandardUsage{
+		InputTokensTotal: input, OutputTokens: output, CacheReadTokens: read,
+		CacheWrite30mTokens: write30, CacheWrite12hTokens: write12,
+	}, nil
+}
