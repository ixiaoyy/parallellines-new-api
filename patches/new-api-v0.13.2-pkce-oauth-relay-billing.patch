diff --git a/service/openai_standard_billing.go b/service/openai_standard_billing.go
new file mode 100644
index 0000000..ec2bcf4
--- /dev/null
+++ b/service/openai_standard_billing.go
@@ -0,0 +1,241 @@
+package service
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"os"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/setting/model_setting"
+	"github.com/QuantumNous/new-api/types"
+	"github.com/gin-gonic/gin"
+	"github.com/shopspring/decimal"
+)
+
+// This is the site's explicit quota policy, not an assertion about an upstream
+// account's contract or actual invoice. Prices are USD per million tokens.
+// Sources checked 2026-10-30: developers.openai.com/api/docs/pricing and the
+// gpt-6-luna, gpt-6.1-terra, gpt-6.1-sol model pages and prompt-caching guide.
+const OpenAIStandardPolicyVersion = "openai-standard-2026-10-30"
+const OpenAIStandardUsageErrorCode types.ErrorCode = "openai_standard_usage_unsettled"
+
+type OpenAIStandardPricingInfo struct {
+	PolicyVersion                 string  `json:"policy_version"`
+	Source                        string  `json:"source"`
+	CheckedDate                   string  `json:"checked_date"`
+	Currency                      string  `json:"currency"`
+	Unit                          string  `json:"unit"`
+	Input                         float64 `json:"input"`
+	Output                        float64 `json:"output"`
+	CacheRead                     float64 `json:"cache_read"`
+	CacheWrite30m                 float64 `json:"cache_write_30m"`
+	CacheWrite12h                 float64 `json:"cache_write_12h"`
+	LongContextThreshold          int     `json:"long_context_threshold"`
+	LongInputMultiplier           float64 `json:"long_input_multiplier"`
+	LongOutputMultiplier          float64 `json:"long_output_multiplier"`
+	QuotaPolicyNotProviderInvoice bool    `json:"quota_policy_not_provider_invoice"`
+}
+
+func GetOpenAIStandardPricing(model string) (OpenAIStandardPricingInfo, bool) {
+	input, cache, ok := openAIStandardRates(model)
+	if !ok {
+		return OpenAIStandardPricingInfo{}, false
+	}
+	return OpenAIStandardPricingInfo{PolicyVersion: OpenAIStandardPolicyVersion, Source: "https://developers.openai.com/api/docs/pricing", CheckedDate: "2026-10-30", Currency: "USD", Unit: "per_1000000_tokens", Input: input, Output: input * 5, CacheRead: cache, CacheWrite30m: input * 1.25, CacheWrite12h: input * 2.5, LongContextThreshold: 272000, LongInputMultiplier: 2, LongOutputMultiplier: 1.5, QuotaPolicyNotProviderInvoice: true}, true
+}
+
+func OpenAIStandardPolicyConfigured() bool {
+	return os.Getenv("OPENAI_STANDARD_BILLING_ENABLED") == "true"
+}
+
+func OpenAIStandardModel(model string) bool {
+	switch model {
+	case "gpt-6-luna", "gpt-6.1-terra", "gpt-6.1-sol":
+		return true
+	}
+	return false
+}
+
+func OpenAIStandardBillingCandidate(info *relaycommon.RelayInfo) bool {
+	if info == nil || info.ChannelMeta == nil || info.ChannelType != constant.ChannelTypeOpenAI || !OpenAIStandardModel(info.OriginModelName) {
+		return false
+	}
+	base := strings.TrimRight(info.ChannelBaseUrl, "/")
+	return base == "" || base == "https://api.openai.com" || base == "https://api.openai.com/v1"
+}
+
+func OpenAIStandardBillingEnabled(info *relaycommon.RelayInfo) bool {
+	return OpenAIStandardPolicyConfigured() && OpenAIStandardBillingCandidate(info)
+}
+
+func OpenAIStandardUsageError(reason string) *types.NewAPIError {
+	// Reasons are internal enum-like diagnostics. Never include upstream payloads.
+	return types.NewErrorWithStatusCode(fmt.Errorf("upstream usage could not be settled under %s (%s); request failed, reserved quota will be refunded", OpenAIStandardPolicyVersion, reason), OpenAIStandardUsageErrorCode, http.StatusBadGateway, types.ErrOptionWithSkipRetry())
+}
+
+func openAIStandardRates(model string) (input, cache float64, ok bool) {
+	switch model {
+	case "gpt-6-luna":
+		return .10, .01, true
+	case "gpt-6.1-terra":
+		return 1, .05, true
+	case "gpt-6.1-sol":
+		return 2, .10, true
+	}
+	return 0, 0, false
+}
+
+// Preconsume remains an estimate/reservation, never the final charge. Reserve
+// conservative 12h-write/long-context rates; native settlement refunds excess.
+func OpenAIStandardPriceData(info *relaycommon.RelayInfo, prompt int, meta *types.TokenCountMeta, group types.GroupRatioInfo) (types.PriceData, error) {
+	if !OpenAIStandardBillingEnabled(info) {
+		return types.PriceData{}, errors.New("OpenAI standard quota policy is disabled for this model")
+	}
+	input, cache, ok := openAIStandardRates(info.OriginModelName)
+	if !ok || !finitePositive(common.QuotaPerUnit) || !finitePositive(group.GroupRatio) || prompt < 0 {
+		return types.PriceData{}, errors.New("invalid OpenAI standard quota policy configuration")
+	}
+	output := common.PreConsumedQuota
+	if meta != nil && meta.MaxTokens > 0 {
+		output = meta.MaxTokens
+	}
+	reserveInput := common.Max(prompt, common.PreConsumedQuota)
+	ratio := input * common.QuotaPerUnit / 1000000
+	reserve := decimal.NewFromInt(int64(reserveInput)).Mul(decimal.NewFromFloat(5)).Add(decimal.NewFromInt(int64(output)).Mul(decimal.NewFromFloat(7.5))).Mul(decimal.NewFromFloat(ratio)).Mul(decimal.NewFromFloat(group.GroupRatio)).Ceil()
+	if reserve.LessThan(decimal.NewFromInt(1)) || reserve.GreaterThan(decimal.NewFromInt(math.MaxInt64/4)) {
+		return types.PriceData{}, errors.New("invalid OpenAI standard quota reservation")
+	}
+	data := types.PriceData{ModelRatio: ratio, CompletionRatio: 5, CacheRatio: cache / input, ImageRatio: 1, GroupRatioInfo: group, QuotaToPreConsume: int(reserve.IntPart())}
+	info.OpenAIStandardPolicy = OpenAIStandardPolicyVersion
+	info.OpenAIStandardChannel = info.ChannelId
+	info.PriceData = data
+	return data, nil
+}
+
+func finitePositive(value float64) bool {
+	return value > 0 && !math.IsInf(value, 0) && !math.IsNaN(value)
+}
+
+// Called again after actual channel selection/model mapping and before sending
+// upstream. A retry must not carry this policy onto another channel.
+func ValidateOpenAIStandardRequest(c *gin.Context, info *relaycommon.RelayInfo) error {
+	if info.OpenAIStandardPolicy == "" {
+		return nil
+	}
+	if !OpenAIStandardBillingEnabled(info) || info.OpenAIStandardChannel != info.ChannelId || info.IsModelMapped || info.UpstreamModelName != info.OriginModelName {
+		return errors.New("standard billing channel or model changed")
+	}
+	if model_setting.GetGlobalSettings().PassThroughRequestEnabled || info.ChannelSetting.PassThroughBodyEnabled || info.ChannelSetting.Proxy != "" || len(info.ParamOverride) != 0 || len(info.HeadersOverride) != 0 || info.ChannelOtherSettings.AllowServiceTier {
+		return errors.New("standard billing requires the reviewed direct-channel settings")
+	}
+	storage, err := common.GetBodyStorage(c)
+	if err != nil {
+		return errors.New("standard billing request could not be inspected")
+	}
+	raw, err := storage.Bytes()
+	if err != nil {
+		return errors.New("standard billing request could not be inspected")
+	}
+	var object map[string]any
+	if common.Unmarshal(raw, &object) != nil {
+		return errors.New("standard billing request could not be inspected")
+	}
+	if tier, exists := object["service_tier"]; exists && tier != nil && tier != "" && tier != "default" {
+		return errors.New("only the standard service tier is supported by this quota policy")
+	}
+	// Keep other providers and arbitrary JSON strings/metadata untouched. Only
+	// inspect documented Chat cache-control paths, whose 12h schema is ambiguous.
+	if info.RelayFormat == types.RelayFormatOpenAI {
+		if ShouldChatCompletionsUseResponsesGlobal(info.ChannelId, info.ChannelType, info.OriginModelName) {
+			return errors.New("standard billing requires native Chat usage, not Chat-to-Responses conversion")
+		}
+		if option, ok := object["prompt_cache_options"].(map[string]any); ok {
+			if ttl, exists := option["ttl"]; exists && ttl != "30m" {
+				return errors.New("Chat cache TTL must be 30m")
+			}
+		}
+		checkContent := func(content any) bool {
+			items, ok := content.([]any)
+			if !ok {
+				return true
+			}
+			for _, item := range items {
+				obj, ok := item.(map[string]any)
+				if !ok {
+					continue
+				}
+				if bp, ok := obj["prompt_cache_breakpoint"].(map[string]any); ok {
+					if ttl, exists := bp["ttl"]; exists && ttl != "30m" {
+						return false
+					}
+				}
+			}
+			return true
+		}
+		if messages, ok := object["messages"].([]any); ok {
+			for _, message := range messages {
+				if msg, ok := message.(map[string]any); ok && !checkContent(msg["content"]) {
+					return errors.New("Chat cache breakpoints must use 30m")
+				}
+			}
+		}
+		if prediction, ok := object["prediction"].(map[string]any); ok && !checkContent(prediction["content"]) {
+			return errors.New("Chat prediction cache breakpoints must use 30m")
+		}
+	}
+	return nil
+}
+
+func ValidateOpenAIStandardSettlement(info *relaycommon.RelayInfo, usage *dto.Usage) *types.NewAPIError {
+	if info.OpenAIStandardPolicy == "" {
+		return nil
+	}
+	if !OpenAIStandardBillingEnabled(info) || info.OpenAIStandardChannel != info.ChannelId || usage == nil || usage.StandardOpenAIUsage == nil {
+		return OpenAIStandardUsageError("validated_usage_missing")
+	}
+	_, err := CalculateOpenAIStandardQuota(info, usage.StandardOpenAIUsage)
+	if err != nil {
+		return OpenAIStandardUsageError("invalid_usage_partition")
+	}
+	return nil
+}
+
+func CalculateOpenAIStandardQuota(info *relaycommon.RelayInfo, usage *dto.OpenAIStandardUsage) (int, error) {
+	amount, err := openAIStandardQuotaAmount(info, usage)
+	if err != nil {
+		return 0, err
+	}
+	quota := int(amount.Round(0).IntPart())
+	if usage.InputTokensTotal+usage.OutputTokens > 0 && quota < 1 {
+		quota = 1
+	}
+	return quota, nil
+}
+
+func openAIStandardQuotaAmount(info *relaycommon.RelayInfo, usage *dto.OpenAIStandardUsage) (decimal.Decimal, error) {
+	if info == nil || usage == nil || !OpenAIStandardBillingEnabled(info) || !finitePositive(info.PriceData.ModelRatio) || !finitePositive(info.PriceData.GroupRatioInfo.GroupRatio) {
+		return decimal.Zero, errors.New("standard billing snapshot missing")
+	}
+	p, o, k, w30, w12 := usage.InputTokensTotal, usage.OutputTokens, usage.CacheReadTokens, usage.CacheWrite30mTokens, usage.CacheWrite12hTokens
+	if p < 0 || o < 0 || k < 0 || w30 < 0 || w12 < 0 || p > 1000000000 || o > 1000000000 || k > p || w30 > p-k || w12 > p-k-w30 {
+		return decimal.Zero, errors.New("invalid standard billing token partition")
+	}
+	inputFactor, outputFactor := decimal.NewFromInt(1), decimal.NewFromInt(1)
+	if p > 272000 {
+		inputFactor = decimal.NewFromInt(2)
+		outputFactor = decimal.NewFromFloat(1.5)
+	}
+	input := decimal.NewFromInt(int64(p - k - w30 - w12)).Add(decimal.NewFromInt(int64(k)).Mul(decimal.NewFromFloat(info.PriceData.CacheRatio))).Add(decimal.NewFromInt(int64(w30)).Mul(decimal.NewFromFloat(1.25))).Add(decimal.NewFromInt(int64(w12)).Mul(decimal.NewFromFloat(2.5))).Mul(inputFactor)
+	output := decimal.NewFromInt(int64(o)).Mul(decimal.NewFromInt(5)).Mul(outputFactor)
+	amount := input.Add(output).Mul(decimal.NewFromFloat(info.PriceData.ModelRatio)).Mul(decimal.NewFromFloat(info.PriceData.GroupRatioInfo.GroupRatio))
+	if amount.GreaterThan(decimal.NewFromInt(math.MaxInt64 / 4)) {
+		return decimal.Zero, errors.New("standard billing quota overflow")
+	}
+	return amount, nil
+}
