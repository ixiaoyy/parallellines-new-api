+  await h.click({ ...provider, pkce_enabled: false });
+
+  assert.deepEqual(requestPaths(h), ['get:/api/oauth/state']);
+  assert.deepEqual(h.redirects, []);
+  assert.deepEqual(h.errors, ['fixture state rejected']);
+});
diff --git a/web/src/helpers/model-pricing-currency.js b/web/src/helpers/model-pricing-currency.js
new file mode 100644
index 0000000..9808662
--- /dev/null
+++ b/web/src/helpers/model-pricing-currency.js
@@ -0,0 +1,28 @@
+// Keep the native three-decimal display for existing callers. Policy pricing
+// requests the numeric conversion and rounds only after choosing the token unit.
+export function displayModelPricingCurrency(
+  usdPrice,
+  {
+    showWithRecharge,
+    priceRate,
+    usdExchangeRate,
+    currency,
+    customExchangeRate,
+    customCurrencySymbol,
+  },
+  { raw = false } = {},
+) {
+  const priceInUSD = showWithRecharge
+    ? (usdPrice * priceRate) / usdExchangeRate
+    : usdPrice;
+  let value = priceInUSD;
+  let symbol = '$';
+  if (currency === 'CNY') {
+    value *= usdExchangeRate;
+    symbol = '¥';
+  } else if (currency === 'CUSTOM') {
+    value *= customExchangeRate;
+    symbol = customCurrencySymbol;
+  }
+  return raw ? value : `${symbol}${value.toFixed(3)}`;
+}
diff --git a/web/src/helpers/openai-standard-pricing.js b/web/src/helpers/openai-standard-pricing.js
new file mode 100644
index 0000000..3424edf
--- /dev/null
+++ b/web/src/helpers/openai-standard-pricing.js
@@ -0,0 +1,132 @@
+// Display the same versioned USD schedule used by the opt-in billing policy.
+// No model-name inference or legacy ratio fallback is permitted for this record.
+export function calculateStandardPricing({
+  record,
+  usedGroup,
+  usedGroupRatio,
+  tokenUnit,
+  displayPrice,
+  currency,
+  quotaDisplayType = 'USD',
+  precision = 4,
+  customCurrencySymbol = '¤',
+}) {
+  const policy = record.standard_pricing;
+  if (!policy) return null;
+  const fields = [
+    'input',
+    'output',
+    'cache_read',
+    'cache_write_30m',
+    'cache_write_12h',
+    'long_context_threshold',
+    'long_input_multiplier',
+    'long_output_multiplier',
+  ];
+  const valid =
+    policy.currency === 'USD' &&
+    policy.unit === 'per_1000000_tokens' &&
+    fields.every((key) => Number.isFinite(policy[key]) && policy[key] > 0) &&
+    Number.isFinite(usedGroupRatio) &&
+    usedGroupRatio > 0;
+  if (!valid || record.standard_pricing_state !== 'enabled') {
+    return {
+      isStandardPricingUnavailable: true,
+      standardPricing: policy,
+      usedGroup,
+      usedGroupRatio,
+    };
+  }
+  const isTokensDisplay = quotaDisplayType === 'TOKENS';
+  const divisor = tokenUnit === 'K' ? 1000 : 1;
+  const symbol =
+    currency === 'CNY'
+      ? '¥'
+      : currency === 'CUSTOM'
+        ? customCurrencySymbol
+        : '$';
+  const money = (value) => {
+    const converted = displayPrice(value * usedGroupRatio, { raw: true });
+    const unitPrice = converted / divisor;
+    const fixed = unitPrice.toFixed(
+      Math.max(precision, tokenUnit === 'K' ? 8 : 4),
+    );
+    return `${symbol}${unitPrice > 0 && Number(fixed) === 0 ? unitPrice.toPrecision(4) : fixed}`;
+  };
+  return {
+    isPerToken: true,
+    isTokensDisplay,
+    usedGroup,
+    usedGroupRatio,
+    standardPricing: policy,
+    unitLabel: tokenUnit === 'K' ? 'K' : 'M',
+    inputPrice: money(policy.input),
+    completionPrice: money(policy.output),
+    cachePrice: money(policy.cache_read),
+    cacheWrite30mPrice: money(policy.cache_write_30m),
+    cacheWrite12hPrice: money(policy.cache_write_12h),
+    inputRatio: record.model_ratio,
+    completionRatio: policy.output / policy.input,
+    cacheRatio: policy.cache_read / policy.input,
+    cacheWrite30mRatio: policy.cache_write_30m / policy.input,
+    cacheWrite12hRatio: policy.cache_write_12h / policy.input,
+  };
+}
+
+export function standardPricingItems(data, t, quotaDisplayType = 'USD') {
+  if (!data.standardPricing) return null;
+  if (data.isStandardPricingUnavailable) {
+    return [
+      {
+        key: 'standard-unavailable',
+        label: t('标准计价未启用或渠道配置不兼容'),
+        value: '',
+        suffix: '',
+      },
+    ];
+  }
+  const ratio = quotaDisplayType === 'TOKENS' || data.isTokensDisplay;
+  const suffix = ratio ? 'x' : ` / 1${data.unitLabel} Tokens`;
+  const items = [
+    [
+      'input',
+      ratio ? '输入倍率' : '输入价格',
+      ratio ? data.inputRatio : data.inputPrice,
+    ],
+    [
+      'output',
+      ratio ? '补全倍率' : '补全价格',
+      ratio ? data.completionRatio : data.completionPrice,
+    ],
+    [
+      'cache-read',
+      ratio ? '缓存读取倍率' : '缓存读取价格',
+      ratio ? data.cacheRatio : data.cachePrice,
+    ],
+    [
+      'write-30m',
+      '缓存写入（30分钟）',
+      ratio ? data.cacheWrite30mRatio : data.cacheWrite30mPrice,
+    ],
+    [
+      'write-12h',
+      '缓存写入（12小时，仅 Responses）',
+      ratio ? data.cacheWrite12hRatio : data.cacheWrite12hPrice,
+    ],
+  ].map(([key, label, value]) => ({ key, label: t(label), value, suffix }));
+  const p = data.standardPricing;
+  items.push({
+    key: 'long-context',
+    label: t('长上下文'),
+    value: t(
+      '输入超过 {{threshold}} tokens：整单输入及缓存 ×{{input}}，输出 ×{{output}}',
+      {
+        threshold: p.long_context_threshold,
+        input: p.long_input_multiplier,
+        output: p.long_output_multiplier,
+      },
+    ),
+    suffix: '',
+  });
+  return items;
+}
diff --git a/web/src/helpers/openai-standard-pricing.test.js b/web/src/helpers/openai-standard-pricing.test.js
new file mode 100644
index 0000000..d79858b
--- /dev/null
+++ b/web/src/helpers/openai-standard-pricing.test.js
@@ -0,0 +1,143 @@
+import { describe, expect, test } from 'bun:test';
+import { displayModelPricingCurrency } from './model-pricing-currency';
+import {
+  calculateStandardPricing,
+  standardPricingItems,
+} from './openai-standard-pricing';
+
+const policy = {
+  policy_version: 'openai-standard-2026-10-30',
+  currency: 'USD',
+  unit: 'per_1000000_tokens',
+  input: 0.1,
+  output: 0.5,
+  cache_read: 0.01,
+  cache_write_30m: 0.125,
+  cache_write_12h: 0.25,
+  long_context_threshold: 272000,
+  long_input_multiplier: 2,
+  long_output_multiplier: 1.5,
+};
+const nativeDisplay =
+  (extra = {}) =>
+  (value, options) =>
+    displayModelPricingCurrency(
+      value,
+      {
+        currency: 'USD',
+        showWithRecharge: false,
+        priceRate: 1,
+        usdExchangeRate: 7,
+        customExchangeRate: 1,
+        customCurrencySymbol: '¤',
+        ...extra,
+      },
+      options,
+    );
+const fixture = (extra = {}) => ({
+  record: {
+    standard_pricing: policy,
+    standard_pricing_state: 'enabled',
+    model_ratio: 0.05,
+  },
+  usedGroup: 'default',
+  usedGroupRatio: 1,
+  tokenUnit: 'M',
+  currency: 'USD',
+  displayPrice: nativeDisplay(),
+  ...extra,
+});
+const t = (text, values = {}) =>
+  text.replace(/{{(\w+)}}/g, (_, k) => values[k]);
+
+describe('versioned standard pricing display', () => {
+  test('shows the authoritative USD rates, writes and long-context threshold', () => {
+    const data = calculateStandardPricing(fixture());
+    expect([
+      data.inputPrice,
+      data.completionPrice,
+      data.cachePrice,
+      data.cacheWrite30mPrice,
+      data.cacheWrite12hPrice,
+    ]).toEqual(['$0.1000', '$0.5000', '$0.0100', '$0.1250', '$0.2500']);
+    const items = standardPricingItems(data, t);
+    expect(items).toHaveLength(6);
+    expect(items[4].label).toContain('12小时，仅 Responses');
+    expect(items[5].value).toContain('272000');
+    expect(items[5].value).toContain('×1.5');
+  });
+  test('K units preserve a nonzero cheap cache price and currency/group conversion', () => {
+    const data = calculateStandardPricing(
+      fixture({
+        tokenUnit: 'K',
+        currency: 'CNY',
+        usedGroupRatio: 2,
+        displayPrice: nativeDisplay({ currency: 'CNY' }),
+      }),
+    );
+    expect(data.cachePrice).toBe('¥0.00014000');
+    expect(data.cacheWrite30mPrice).toBe('¥0.00175000');
+    expect(standardPricingItems(data, t)[0].suffix).toContain('1K');
+  });
+  test('native currency conversion preserves low group rates before final rounding', () => {
+    const displayPrice = nativeDisplay();
+    expect(displayPrice(0.0001)).toBe('$0.000');
+    expect(displayPrice(0.0001, { raw: true })).toBe(0.0001);
+    const data = calculateStandardPricing(
+      fixture({ usedGroupRatio: 0.01, displayPrice }),
+    );
+    expect(data.cachePrice).toBe('$0.0001');
+    const tiny = calculateStandardPricing(
+      fixture({
+        usedGroupRatio: 0.01,
+        tokenUnit: 'K',
+        currency: 'CUSTOM',
+        customCurrencySymbol: '¤',
+        displayPrice: nativeDisplay({
+          currency: 'CUSTOM',
+          customExchangeRate: 1e-10,
+        }),
+      }),
+    );
+    expect(tiny.cachePrice).toBe('¤1.000e-17');
+    expect(
+      nativeDisplay({
+        showWithRecharge: true,
+        priceRate: 14,
+        currency: 'CNY',
+      })(0.01, { raw: true }),
+    ).toBeCloseTo(0.14, 12);
+  });
+  test('TOKENS mode uses correct relative ratios and distinct OpenAI write durations', () => {
+    const data = calculateStandardPricing(
+      fixture({ quotaDisplayType: 'TOKENS' }),
+    );
+    expect(data.cacheWrite30mRatio).toBe(1.25);
+    expect(data.cacheWrite12hRatio).toBe(2.5);
+    const items = standardPricingItems(data, t, 'TOKENS');
+    expect(items[0].value).toBe(0.05);
+    expect(items[3].suffix).toBe('x');
+  });
+  test('disabled and malformed policies cannot show a legacy fallback price', () => {
+    for (const record of [
+      { standard_pricing: policy, standard_pricing_state: 'disabled' },
+      {
+        standard_pricing: { ...policy, input: NaN },
+        standard_pricing_state: 'enabled',
+      },
+      {
+        standard_pricing: { ...policy, unit: 'wrong-unit' },
+        standard_pricing_state: 'enabled',
+      },
+    ]) {
+      const data = calculateStandardPricing(fixture({ record }));
+      expect(data.isStandardPricingUnavailable).toBe(true);
+      expect(standardPricingItems(data, t)).toHaveLength(1);
+      expect(data.inputPrice).toBeUndefined();
+    }
+  });
+  test('non-policy records retain the native pricing branch', () => {
+    expect(calculateStandardPricing(fixture({ record: {} }))).toBeNull();
+    expect(standardPricingItems({ inputPrice: '$3' }, t)).toBeNull();
+  });
+});
