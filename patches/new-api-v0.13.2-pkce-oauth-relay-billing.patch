+	if found, err := GetTokenById(normal.Id); err != nil || found.Status != common.TokenStatusEnabled {
+		t.Fatal("revocation changed a normal user token")
+	}
+	if current, err := GetUserById(user.Id, false); err != nil || current.Quota != user.Quota || current.Role != user.Role {
+		t.Fatal("revocation modified user quota or role")
+	}
+}
