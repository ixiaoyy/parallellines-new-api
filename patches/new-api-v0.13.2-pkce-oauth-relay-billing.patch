+	})
+	t.Run("both paid routes reject unsupported models before upstream", func(t *testing.T) {
+		for _, path := range []string{"/chat/completions", "/responses"} {
+			res := request("POST", "/oauth-relay/v1"+path, "fixture-zero", `{"model":"unapproved-model"}`)
+			if res.Code != 403 {
