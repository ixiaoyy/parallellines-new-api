+)
+
+func TestParseOpenAIStandardUsageVerifiedCounters(t *testing.T) {
+	tests := []struct {
+		name, raw string
+		responses bool
+		want      dto.OpenAIStandardUsage
+	}{
+		{"ordinary_optional_details", `{"prompt_tokens":2000,"completion_tokens":1000,"total_tokens":3000}`, false, dto.OpenAIStandardUsage{InputTokensTotal: 2000, OutputTokens: 1000}},
+		{"explicit_zero_output", `{"prompt_tokens":100,"completion_tokens":0,"total_tokens":100,"prompt_tokens_details":{"cached_tokens":0,"cache_write_tokens":0}}`, false, dto.OpenAIStandardUsage{InputTokensTotal: 100}},
+		{"explicit_all_zero", `{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{}}`, true, dto.OpenAIStandardUsage{}},
+		{"chat_read_write", `{"prompt_tokens":2000,"completion_tokens":1000,"total_tokens":3000,"prompt_tokens_details":{"cached_tokens":500,"cache_write_tokens":1000}}`, false, dto.OpenAIStandardUsage{InputTokensTotal: 2000, OutputTokens: 1000, CacheReadTokens: 500, CacheWrite30mTokens: 1000}},
+		{"responses_mixed_write", `{"input_tokens":4000,"output_tokens":1000,"total_tokens":5000,"input_tokens_details":{"cached_tokens":500,"cache_write_tokens":2000,"cache_write_tokens_details":{"ttl_30m_tokens":1000,"ttl_12h_tokens":1000}}}`, true, dto.OpenAIStandardUsage{InputTokensTotal: 4000, OutputTokens: 1000, CacheReadTokens: 500, CacheWrite30mTokens: 1000, CacheWrite12hTokens: 1000}},
+		{"responses_zero_write_no_split", `{"input_tokens":4000,"output_tokens":1000,"total_tokens":5000,"input_tokens_details":{"cached_tokens":500,"cache_write_tokens":0}}`, true, dto.OpenAIStandardUsage{InputTokensTotal: 4000, OutputTokens: 1000, CacheReadTokens: 500}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := ParseOpenAIStandardUsage([]byte(tt.raw), tt.responses)
+			if err != nil || got == nil || *got != tt.want {
+				t.Fatalf("got=%+v err=%v want=%+v", got, err, tt.want)
+			}
+		})
+	}
+}
+
+func TestParseOpenAIStandardUsageRejectsUnsettleableCounters(t *testing.T) {
+	tests := []struct {
+		name, raw string
+		responses bool
+	}{
+		{"absent", "", false}, {"null", "null", false}, {"empty", "{}", false},
+		{"missing_core", `{"prompt_tokens":2,"total_tokens":2}`, false},
+		{"null_core", `{"prompt_tokens":null,"completion_tokens":1,"total_tokens":1}`, false},
+		{"negative", `{"prompt_tokens":-1,"completion_tokens":1,"total_tokens":0}`, false},
+		{"fractional", `{"prompt_tokens":1.5,"completion_tokens":1,"total_tokens":2.5}`, false},
+		{"inconsistent_total", `{"prompt_tokens":3,"completion_tokens":1,"total_tokens":3}`, false},
+		{"unbounded", `{"prompt_tokens":1000000001,"completion_tokens":1,"total_tokens":1000000002}`, false},
+		{"null_optional", `{"prompt_tokens":3,"completion_tokens":1,"total_tokens":4,"prompt_tokens_details":{"cached_tokens":null}}`, false},
+		{"invalid_details", `{"prompt_tokens":3,"completion_tokens":1,"total_tokens":4,"prompt_tokens_details":[]}`, false},
+		{"overlap_read_write", `{"prompt_tokens":3,"completion_tokens":1,"total_tokens":4,"prompt_tokens_details":{"cached_tokens":2,"cache_write_tokens":2}}`, false},
+		{"responses_missing_split", `{"input_tokens":3,"output_tokens":1,"total_tokens":4,"input_tokens_details":{"cache_write_tokens":2}}`, true},
+		{"responses_partial_split", `{"input_tokens":3,"output_tokens":1,"total_tokens":4,"input_tokens_details":{"cache_write_tokens":2,"cache_write_tokens_details":{"ttl_30m_tokens":2}}}`, true},
+		{"responses_bad_split_sum", `{"input_tokens":3,"output_tokens":1,"total_tokens":4,"input_tokens_details":{"cache_write_tokens":2,"cache_write_tokens_details":{"ttl_30m_tokens":2,"ttl_12h_tokens":1}}}`, true},
+		{"chat_12h_unsupported", `{"prompt_tokens":3,"completion_tokens":1,"total_tokens":4,"prompt_tokens_details":{"cache_write_tokens":2,"cache_write_tokens_details":{"ttl_30m_tokens":0,"ttl_12h_tokens":2}}}`, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got, err := ParseOpenAIStandardUsage([]byte(tt.raw), tt.responses); err == nil || got != nil {
+				t.Fatalf("accepted invalid counters: %+v", got)
+			}
+		})
+	}
+}
+
+func TestOpenAIStandardUsageMetadataCannotArriveFromWire(t *testing.T) {
+	var usage dto.Usage
+	if err := common.Unmarshal([]byte(`{"StandardOpenAIUsage":{"InputTokensTotal":99},"prompt_tokens":1,"completion_tokens":0,"total_tokens":1}`), &usage); err != nil {
+		t.Fatal(err)
+	}
+	if usage.StandardOpenAIUsage != nil {
+		t.Fatal("untrusted wire populated verified metadata")
+	}
+}
