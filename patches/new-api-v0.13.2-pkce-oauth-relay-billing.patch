@@ -0,0 +1,51 @@
+package controller
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+// Discovery is free and follows the authenticated user's actual channel group.
+// Missing prices still fail in the unchanged paid relay/billing pipeline.
+func ListChatOAuthRelayModels(c *gin.Context) {
+	group := common.GetContextKeyString(c, constant.ContextKeyUsingGroup)
+	enabled := make(map[string]bool)
+	for _, name := range model.GetGroupEnabledModels(group) {
+		enabled[name] = true
+	}
+	models := make([]dto.OpenAIModels, 0, 3)
+	for _, name := range strings.Split(model.OAuthRelayModelLimits, ",") {
+		if enabled[name] {
+			models = append(models, dto.OpenAIModels{Id: name, Object: "model", OwnedBy: "custom"})
+		}
+	}
+	c.JSON(http.StatusOK, gin.H{"object": "list", "data": models})
+}
+
+// The root-only route never returns the key and does not recreate a missing or
+// revoked credential. Existing user-disable/unbind controls also revoke access.
+func RevokeChatOAuthRelayCredential(c *gin.Context) {
+	id, err := strconv.Atoi(c.Param("id"))
+	if err != nil || id <= 0 {
+		c.AbortWithStatusJSON(400, gin.H{"success": false, "message": "invalid user id"})
+		return
+	}
+	if err := model.RevokeOAuthRelayToken(id); err != nil {
+		status := 500
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			status = 404
+		}
+		c.JSON(status, gin.H{"success": false, "message": "internal credential not found or revocation failed"})
+		return
+	}
+	c.JSON(200, gin.H{"success": true, "message": ""})
+}
diff --git a/controller/openai_standard_error.go b/controller/openai_standard_error.go
new file mode 100644
index 0000000..2f4ef98
--- /dev/null
+++ b/controller/openai_standard_error.go
@@ -0,0 +1,33 @@
+package controller
+
+import (
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/relay/helper"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/types"
+	"github.com/gin-gonic/gin"
+)
+
+// Never append an ordinary HTTP JSON body after SSE has begun. This is only
+// used for this policy's explicit un-settled usage failure; native refund and
+// error auditing still run in the enclosing relay controller.
+func writeOpenAIStandardStreamError(c *gin.Context, format types.RelayFormat, err *types.NewAPIError) bool {
+	if err == nil || err.GetErrorCode() != service.OpenAIStandardUsageErrorCode || !c.Writer.Written() || !c.GetBool(string(constant.ContextKeyIsStream)) {
+		return false
+	}
+	if format == types.RelayFormatOpenAIResponses {
+		next := 0
+		if value, ok := c.Get("openai_standard_last_sequence"); ok {
+			if n, valid := value.(int); valid && n >= 0 && n < 1000000000 {
+				next = n + 1
+			}
+		}
+		c.Render(-1, common.CustomEvent{Data: "event: error\n"})
+		_ = helper.ObjectData(c, gin.H{"type": "error", "code": string(err.GetErrorCode()), "message": err.ToOpenAIError().Message, "param": nil, "sequence_number": next})
+	} else {
+		_ = helper.ObjectData(c, gin.H{"error": err.ToOpenAIError()})
+		helper.Done(c)
+	}
+	return true
+}
