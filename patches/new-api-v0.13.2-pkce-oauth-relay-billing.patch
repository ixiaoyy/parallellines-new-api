@@ -0,0 +1,278 @@
+package middleware
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/dto"
+	"github.com/QuantumNous/new-api/i18n"
+	"github.com/QuantumNous/new-api/model"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm/logger"
+)
+
+type chatOAuthRoundTrip func(*http.Request) (*http.Response, error)
+
+func (f chatOAuthRoundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func fixtureChatClaims(sub string) map[string]any {
+	return map[string]any{"iss": chatOAuthIssuer, "aud": chatOAuthAudience, "sub": sub,
+		"pl_binding": "synthetic-session-binding", "pl_auth_exp": time.Now().Unix() + 300}
+}
+
+func mockChatUserInfo(t *testing.T, responder func(*http.Request) (int, any)) {
+	t.Helper()
+	old := chatOAuthHTTPClient
+	client := *old
+	client.Transport = chatOAuthRoundTrip(func(r *http.Request) (*http.Response, error) {
+		if r.URL.String() != chatOAuthUserInfoURL || r.Method != "GET" || r.Header.Get("Cookie") != "" {
+			t.Error("identity request escaped the fixed UserInfo contract")
+		}
+		status, value := responder(r)
+		body, err := common.Marshal(value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": {"application/json"}},
+			Body: io.NopCloser(strings.NewReader(string(body))), Request: r}, nil
+	})
+	chatOAuthHTTPClient = &client
+	t.Cleanup(func() { chatOAuthHTTPClient = old })
+}
+
+func TestChatOAuthRelayClaimsFailClosed(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		change func(map[string]any)
+	}{
+		{"wrong issuer", func(c map[string]any) { c["iss"] = "https://other.example" }},
+		{"legacy audience", func(c map[string]any) { c["aud"] = "legacy-client" }},
+		{"NewAPI audience", func(c map[string]any) { c["aud"] = "parallellines-newapi" }},
+		{"audience array", func(c map[string]any) { c["aud"] = []string{chatOAuthAudience} }},
+		{"missing subject", func(c map[string]any) { delete(c, "sub") }},
+		{"normalized subject", func(c map[string]any) { c["sub"] = " fixture-a" }},
+		{"missing binding", func(c map[string]any) { delete(c, "pl_binding") }},
+		{"expired", func(c map[string]any) { c["pl_auth_exp"] = time.Now().Unix() - 1 }},
+		{"string expiry", func(c map[string]any) { c["pl_auth_exp"] = "9999999999" }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			claims := fixtureChatClaims("fixture-a")
+			tc.change(claims)
+			mockChatUserInfo(t, func(*http.Request) (int, any) { return 200, claims })
+			if _, err := verifyChatOAuthToken(context.Background(), "synthetic-oauth-token"); err == nil {
+				t.Fatal("invalid identity accepted")
+			}
+		})
+	}
+	t.Run("valid", func(t *testing.T) {
+		mockChatUserInfo(t, func(*http.Request) (int, any) { return 200, fixtureChatClaims("fixture-a") })
+		if _, err := verifyChatOAuthToken(context.Background(), "synthetic-oauth-token"); err != nil {
+			t.Fatal(err)
+		}
+	})
+	t.Run("oversized", func(t *testing.T) {
+		claims := fixtureChatClaims("fixture-a")
+		claims["extra"] = strings.Repeat("x", 16384)
+		mockChatUserInfo(t, func(*http.Request) (int, any) { return 200, claims })
+		if _, err := verifyChatOAuthToken(context.Background(), "synthetic-oauth-token"); err == nil {
+			t.Fatal("oversized response accepted")
+		}
+	})
+	t.Run("redirect refused", func(t *testing.T) {
+		old := chatOAuthHTTPClient
+		client := *old
+		calls := 0
+		client.Transport = chatOAuthRoundTrip(func(r *http.Request) (*http.Response, error) {
+			calls++
+			return &http.Response{StatusCode: 302, Header: http.Header{"Location": {"https://untrusted.example/me"}}, Body: http.NoBody, Request: r}, nil
+		})
+		chatOAuthHTTPClient = &client
+		t.Cleanup(func() { chatOAuthHTTPClient = old })
+		if _, err := verifyChatOAuthToken(context.Background(), "synthetic-oauth-token"); err == nil || calls != 1 {
+			t.Fatal("UserInfo redirect followed")
+		}
+	})
+}
+
+func setupChatOAuthDB(t *testing.T) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	if err := i18n.Init(); err != nil {
+		t.Fatal(err)
+	}
+	oldDB, oldPath, oldMaster := model.DB, common.SQLitePath, common.IsMasterNode
+	oldRedis, oldBatch := common.RedisEnabled, common.BatchUpdateEnabled
+	t.Setenv("SQL_DSN", "local")
+	t.Setenv("SQL_MAX_OPEN_CONNS", "1")
+	t.Setenv("CHAT_OAUTH_RELAY_ENABLED", "true")
+	common.SQLitePath = "file:chat-oauth-" + t.Name() + "?mode=memory&cache=shared"
+	common.IsMasterNode, common.RedisEnabled, common.BatchUpdateEnabled = false, false, false
+	if err := model.InitDB(); err != nil {
+		t.Fatal(err)
+	}
+	model.DB.Logger = logger.Default.LogMode(logger.Silent)
+	if err := model.DB.AutoMigrate(&model.User{}, &model.Token{}, &model.CustomOAuthProvider{}, &model.UserOAuthBinding{}); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		sqlDB, _ := model.DB.DB()
+		_ = sqlDB.Close()
+		model.DB, common.SQLitePath, common.IsMasterNode = oldDB, oldPath, oldMaster
+		common.RedisEnabled, common.BatchUpdateEnabled = oldRedis, oldBatch
+	})
+	provider := model.CustomOAuthProvider{Id: 1, Slug: "pingxingxian", Name: "fixture", Enabled: true, UserIdField: "sub", UserInfoEndpoint: chatOAuthUserInfoURL}
+	if err := model.DB.Create(&provider).Error; err != nil {
+		t.Fatal(err)
+	}
+	for i, sub := range []string{"fixture-a", "fixture-b", "fixture-zero"} {
+		quota := 100
+		if i == 2 {
+			quota = 0
+		}
+		user := model.User{Id: 101 + i, Username: sub, AffCode: sub, Role: common.RoleCommonUser, Status: common.UserStatusEnabled, Group: "default", Quota: quota}
+		if err := model.DB.Create(&user).Error; err != nil {
+			t.Fatal(err)
+		}
+		binding := model.UserOAuthBinding{UserId: user.Id, ProviderId: 1, ProviderUserId: sub}
+		if err := model.DB.Create(&binding).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestChatOAuthRelayNativeIdentityAndQuotaIsolation(t *testing.T) {
+	setupChatOAuthDB(t)
+	userinfoCalls := 0
+	mockChatUserInfo(t, func(r *http.Request) (int, any) {
+		userinfoCalls++
+		sub := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer oauth-")
+		if !strings.HasPrefix(sub, "fixture-") {
+			return 401, map[string]any{"error": "invalid_token"}
+		}
+		return 200, fixtureChatClaims(sub)
+	})
+	r := gin.New()
+	r.Use(BodyStorageCleanup())
+	tokens := map[int]int{}
+	seenPaths := map[string]int{}
+	terminal := func(c *gin.Context) {
+		uid, tid := c.GetInt("id"), c.GetInt("token_id")
+		if old := tokens[uid]; old != 0 && old != tid {
+			t.Error("credential not reused for same owner")
+		}
+		tokens[uid] = tid
+		seenPaths[c.Request.URL.Path]++
+		if strings.Contains(c.GetHeader("Authorization"), "oauth-") || c.GetHeader("Cookie") != "" {
+			t.Error("source credentials survived mapping")
+		}
+		if c.Request.Method == "POST" {
+			info := &relaycommon.RelayInfo{UserId: uid, TokenId: tid, TokenKey: c.GetString("token_key"), TokenUnlimited: c.GetBool("token_unlimited_quota"), UserSetting: dto.UserSetting{BillingPreference: "wallet_only"}}
+			billing, apiErr := service.NewBillingSession(c, info, 10)
+			if apiErr != nil {
+				c.Status(apiErr.StatusCode)
+				return
+			}
+			if err := billing.Settle(7); err != nil {
+				t.Fatal(err)
+			}
+		}
+		c.JSON(200, gin.H{"ok": true})
+	}
+	r.GET("/oauth-relay/v1/models", ChatOAuthRelay("/v1/models"), TokenAuth(), terminal)
+	r.POST("/oauth-relay/v1/chat/completions", ChatOAuthRelay("/v1/chat/completions"), TokenAuth(), ChatOAuthRelayModelLimit(), terminal)
+	r.POST("/oauth-relay/v1/responses", ChatOAuthRelay("/v1/responses"), TokenAuth(), ChatOAuthRelayModelLimit(), terminal)
+	r.GET("/v1/models", TokenAuth(), terminal)
+	r.GET("/usage", TokenAuthReadOnly(), terminal)
+	request := func(method, path, bearer string, headers map[string]string, body string) int {
+		req := httptest.NewRequest(method, path, strings.NewReader(body))
+		if bearer != "" {
+			req.Header.Set("Authorization", "Bearer "+bearer)
+		}
+		req.Header.Set("Content-Type", "application/json")
+		for k, v := range headers {
+			req.Header.Set(k, v)
+		}
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		// The public test responses must never contain any persisted relay key.
+		var internal []model.Token
+		model.DB.Where("internal_purpose IS NOT NULL").Find(&internal)
+		for _, key := range internal {
+			if strings.Contains(w.Body.String(), key.Key) {
+				t.Fatal("relay key exposed in response")
+			}
+		}
+		return w.Code
+	}
+	for _, sub := range []string{"fixture-a", "fixture-b", "fixture-zero"} {
+		if status := request("GET", "/oauth-relay/v1/models", "oauth-"+sub, nil, ""); status != 200 {
+			t.Fatalf("free discovery status %d", status)
+		}
+	}
+	body := `{"model":"gpt-6-luna","messages":[{"role":"user","content":[{"type":"text","text":"fixture"},{"type":"image_url","image_url":{"url":"data:image/png;base64,fixture"}}]}]}`
+	for _, path := range []string{"/oauth-relay/v1/chat/completions", "/oauth-relay/v1/responses"} {
+		if status := request("POST", path, "oauth-fixture-a", nil, body); status != 200 {
+			t.Fatalf("native billing status %d", status)
+		}
+	}
+	if tokens[101] == 0 || tokens[101] == tokens[102] || tokens[102] == tokens[103] {
+		t.Fatal("different users shared an internal credential")
+	}
+	for uid, want := range map[int]int{101: 86, 102: 100, 103: 0} {
+		user, err := model.GetUserById(uid, false)
+		if err != nil || user.Quota != want {
+			t.Fatalf("user %d quota changed incorrectly", uid)
+		}
+	}
+	if status := request("POST", "/oauth-relay/v1/responses", "oauth-fixture-zero", nil, body); status != 403 {
+		t.Fatalf("zero quota was not rejected: %d", status)
+	}
+	if seenPaths["/v1/models"] != 3 || seenPaths["/v1/chat/completions"] != 1 || seenPaths["/v1/responses"] != 2 {
+		t.Fatal("canonical paths not preserved")
+	}
+	for _, h := range []string{"X-Api-Key", "X-Goog-Api-Key", "Sec-WebSocket-Protocol", "Mj-Api-Secret", "New-Api-User", "X-User-Id"} {
+		before := userinfoCalls
+		if status := request("GET", "/oauth-relay/v1/models", "oauth-fixture-a", map[string]string{h: "spoof"}, ""); status != 400 || userinfoCalls != before {
+			t.Fatal("alternate credential header accepted")
+		}
+	}
+	if status := request("GET", "/oauth-relay/v1/models?key=spoof", "oauth-fixture-a", nil, ""); status != 400 {
+		t.Fatal("query accepted")
+	}
+	if status := request("GET", "/oauth-relay/v1/models", "", nil, ""); status != 401 {
+		t.Fatal("anonymous request accepted")
+	}
+	if status := request("GET", "/oauth-relay/v1/models", "oauth-fixture-missing", nil, ""); status != 403 {
+		t.Fatal("missing native binding accepted")
+	}
+	if status := request("POST", "/oauth-relay/v1/responses", "oauth-fixture-a", nil, `{"model":"gpt-6-luna-thinking"}`); status != 403 {
+		t.Fatal("nonexact model accepted")
+	}
+	internal, err := model.GetOrCreateOAuthRelayToken(101)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{"/v1/models", "/usage"} {
+		if request("GET", path, internal.Key, nil, "") != 401 {
+			t.Fatal("internal key accepted outside verified adapter")
+		}
+	}
+	if err := model.RevokeOAuthRelayToken(101); err != nil {
+		t.Fatal(err)
+	}
+	if request("GET", "/oauth-relay/v1/models", "oauth-fixture-a", nil, "") != 403 {
+		t.Fatal("revoked internal key was renewed")
+	}
+	model.DB.Model(&model.User{}).Where("id = ?", 102).Update("status", common.UserStatusDisabled)
+	if request("GET", "/oauth-relay/v1/models", "oauth-fixture-b", nil, "") != 403 {
+		t.Fatal("disabled user accepted")
+	}
+}
diff --git a/model/oauth_relay.go b/model/oauth_relay.go
new file mode 100644
index 0000000..c460404
--- /dev/null
+++ b/model/oauth_relay.go
@@ -0,0 +1,183 @@
+package model
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"gorm.io/gorm/logger"
+)
+
+const OAuthRelayTokenPurpose = "chat-oauth-v1"
+const OAuthRelayModelLimits = "gpt-6-luna,gpt-6.1-terra,gpt-6.1-sol"
+const OAuthRelayUserInfoURL = "https://pingxingxian.space/auth/oidc/me"
+
+var (
+	ErrOAuthRelayIdentityDenied        = errors.New("OAuth relay identity is not bound to an active user")
+	ErrOAuthRelayCredentialUnavailable = errors.New("OAuth relay credential is unavailable")
+)
+
+// Internal credentials never enter the ordinary token-management surface, even
+// when the caller owns their billing account. NULL preserves all upstream tokens.
+func userManagedTokens(db *gorm.DB) *gorm.DB {
+	return db.Where("internal_purpose IS NULL")
+}
+
+func activeOAuthRelayRole(user *User) bool {
+	return user.Status == common.UserStatusEnabled && !user.DeletedAt.Valid &&
+		(user.Role == common.RoleCommonUser || user.Role == common.RoleAdminUser || user.Role == common.RoleRootUser)
+}
+
+func validOAuthRelayKey(key string) bool {
+	if len(key) != 48 {
+		return false
+	}
+	for _, c := range key {
+		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
+			return false
+		}
+	}
+	return true
+}
+
+// ResolveOAuthRelayUser accepts only an existing native provider/sub binding.
+// User creation, email matching, role changes and quota grants are intentionally
+// absent. Read the database on every resolution so binding/status changes are not
+// hidden by a cached OAuth identity or an old login session.
+func ResolveOAuthRelayUser(providerID int, slug string, sub string) (*User, error) {
+	if providerID <= 0 || slug == "" || sub == "" || strings.TrimSpace(sub) != sub {
+		return nil, ErrOAuthRelayIdentityDenied
+	}
+	var provider CustomOAuthProvider
+	if err := DB.First(&provider, "id = ?", providerID).Error; err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, ErrOAuthRelayIdentityDenied
+		}
+		return nil, fmt.Errorf("%w: OAuth provider lookup failed", ErrDatabase)
+	}
+	if !provider.Enabled || provider.Slug != slug || provider.UserIdField != "sub" || provider.UserInfoEndpoint != OAuthRelayUserInfoURL {
+		return nil, ErrOAuthRelayIdentityDenied
+	}
+	var bindings []UserOAuthBinding
+	if err := DB.Where("provider_id = ? AND provider_user_id = ?", providerID, sub).Limit(2).Find(&bindings).Error; err != nil {
+		return nil, fmt.Errorf("%w: OAuth binding lookup failed", ErrDatabase)
+	}
+	// Some MySQL installations use case-insensitive VARCHAR collations. OAuth
+	// subjects are opaque, case-sensitive identifiers regardless of DB collation.
+	if len(bindings) != 1 || bindings[0].ProviderId != providerID || bindings[0].ProviderUserId != sub {
+		return nil, ErrOAuthRelayIdentityDenied
+	}
+	user, err := GetUserById(bindings[0].UserId, false)
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, ErrOAuthRelayIdentityDenied
+		}
+		return nil, fmt.Errorf("%w: OAuth user lookup failed", ErrDatabase)
+	}
+	if !activeOAuthRelayRole(user) {
+		return nil, ErrOAuthRelayIdentityDenied
+	}
+	return user, nil
+}
+
+func loadOAuthRelayToken(userID int) (*Token, error) {
+	var token Token
+	err := DB.Unscoped().Where("user_id = ? AND internal_purpose = ?", userID, OAuthRelayTokenPurpose).First(&token).Error
+	if err != nil {
+		return nil, err
+	}
+	if token.UserId != userID || token.InternalPurpose == nil || *token.InternalPurpose != OAuthRelayTokenPurpose ||
+		token.DeletedAt.Valid || token.Status != common.TokenStatusEnabled || token.ExpiredTime != -1 ||
+		!validOAuthRelayKey(token.Key) || !token.UnlimitedQuota || !token.ModelLimitsEnabled || token.ModelLimits != OAuthRelayModelLimits ||
+		token.Group != "" || token.CrossGroupRetry || (token.AllowIps != nil && *token.AllowIps != "") {
+		return nil, ErrOAuthRelayCredentialUnavailable
+	}
+	return &token, nil
+}
+
+// GetOrCreateOAuthRelayToken creates one server-only credential per existing user.
+// The nullable-purpose unique index keeps ordinary NULL-purpose tokens unlimited
+// in number while making concurrent internal issuance single-winner on all three
+// supported databases. Disabled/expired/soft-deleted credentials are never renewed.
+// UnlimitedQuota removes only a redundant token budget; the unchanged relay
+// pipeline continues to enforce and settle the user's own wallet/subscription.
+func GetOrCreateOAuthRelayToken(userID int) (*Token, error) {
+	if userID <= 0 {
+		return nil, ErrOAuthRelayIdentityDenied
+	}
+	user, err := GetUserById(userID, false)
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, ErrOAuthRelayIdentityDenied
+		}
+		return nil, fmt.Errorf("%w: OAuth user lookup failed", ErrDatabase)
+	}
+	if !activeOAuthRelayRole(user) {
+		return nil, ErrOAuthRelayIdentityDenied
+	}
+	token, err := loadOAuthRelayToken(userID)
+	if err == nil || errors.Is(err, ErrOAuthRelayCredentialUnavailable) {
+		return token, err
+	}
+	if !errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, fmt.Errorf("%w: OAuth credential lookup failed", ErrDatabase)
+	}
+	key, err := common.GenerateKey()
+	if err != nil {
+		return nil, ErrOAuthRelayCredentialUnavailable
+	}
+	purpose := OAuthRelayTokenPurpose
+	token = &Token{
+		UserId: userID, InternalPurpose: &purpose, Key: key,
+		Name: "Chat OAuth internal", Status: common.TokenStatusEnabled,
+		CreatedTime: common.GetTimestamp(), AccessedTime: common.GetTimestamp(), ExpiredTime: -1,
+		RemainQuota: 0, UnlimitedQuota: true, ModelLimitsEnabled: true, ModelLimits: OAuthRelayModelLimits,
+	}
+	if err := DB.Session(&gorm.Session{Logger: DB.Logger.LogMode(logger.Silent)}).
+		Clauses(clause.OnConflict{DoNothing: true}).Create(token).Error; err != nil {
+		// Do not include driver/SQL details: some drivers interpolate credential keys.
+		return nil, fmt.Errorf("%w: OAuth credential creation failed", ErrDatabase)
+	}
+	// Always load the unique winner rather than returning an uncommitted candidate.
+	token, err = loadOAuthRelayToken(userID)
+	if err != nil {
+		if errors.Is(err, ErrOAuthRelayCredentialUnavailable) {
+			return nil, err
+		}
+		return nil, fmt.Errorf("%w: OAuth credential lookup failed", ErrDatabase)
+	}
+	return token, nil
+}
+
+// RevokeOAuthRelayToken disables an already issued internal credential. A missing
+// row is reported, not treated as a durable ban on future issuance. Revocation is
+// idempotent; retrieval never recreates or enables a disabled/deleted credential.
+func RevokeOAuthRelayToken(userID int) error {
+	if userID <= 0 {
+		return gorm.ErrRecordNotFound
+	}
+	var token Token
+	err := DB.Unscoped().Where("user_id = ? AND internal_purpose = ?", userID, OAuthRelayTokenPurpose).First(&token).Error
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return gorm.ErrRecordNotFound
+		}
+		return fmt.Errorf("%w: OAuth credential lookup failed", ErrDatabase)
+	}
+	if token.InternalPurpose == nil || *token.InternalPurpose != OAuthRelayTokenPurpose {
+		return ErrOAuthRelayCredentialUnavailable
+	}
+	if err := DB.Unscoped().Model(&Token{}).Where("id = ? AND user_id = ?", token.Id, userID).
+		Update("status", common.TokenStatusDisabled).Error; err != nil {
+		return fmt.Errorf("%w: OAuth credential revocation failed", ErrDatabase)
+	}
+	if common.RedisEnabled {
+		if err := cacheDeleteToken(token.Key); err != nil {
+			return fmt.Errorf("%w: OAuth credential cache invalidation failed", ErrDatabase)
+		}
+	}
+	return nil
+}
diff --git a/model/oauth_relay_test.go b/model/oauth_relay_test.go
new file mode 100644
index 0000000..ac7e519
--- /dev/null
+++ b/model/oauth_relay_test.go
@@ -0,0 +1,417 @@
+package model
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/glebarez/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func oauthRelayTestDB(t *testing.T) *gorm.DB {
+	t.Helper()
+	oldDB, oldRedis := DB, common.RedisEnabled
+	oldKeyCol, oldGroupCol := commonKeyCol, commonGroupCol
+	dsn := "file:oauth_relay_" + strings.ReplaceAll(t.Name(), "/", "_") + "?mode=memory&cache=shared"
+	db, err := gorm.Open(sqlite.Open(dsn), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, err := db.DB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB.SetMaxOpenConns(1)
+	sqlDB.SetMaxIdleConns(1)
+	DB, common.RedisEnabled = db, false
+	commonKeyCol, commonGroupCol = "`key`", "`group`"
+	t.Cleanup(func() {
+		DB, common.RedisEnabled = oldDB, oldRedis
+		commonKeyCol, commonGroupCol = oldKeyCol, oldGroupCol
+		_ = sqlDB.Close()
+	})
+	if err := db.AutoMigrate(&User{}, &CustomOAuthProvider{}, &UserOAuthBinding{}, &Token{}); err != nil {
+		t.Fatal(err)
+	}
+	return db
+}
+
+func oauthRelayFixture(t *testing.T, db *gorm.DB, userID int, sub string) *User {
+	t.Helper()
+	user := &User{
+		Id: userID, Username: fmt.Sprintf("relay-fixture-%d", userID), AffCode: fmt.Sprintf("relay-aff-%d", userID),
+		Role: common.RoleCommonUser, Status: common.UserStatusEnabled, Group: "default", Quota: 1000 + userID,
+	}
+	if err := db.Create(user).Error; err != nil {
+		t.Fatal(err)
+	}
+	var count int64
+	if err := db.Model(&CustomOAuthProvider{}).Where("id = ?", 1).Count(&count).Error; err != nil {
+		t.Fatal(err)
+	}
+	if count == 0 {
+		provider := &CustomOAuthProvider{Id: 1, Slug: "pingxingxian", Name: "Fixture", Enabled: true, UserIdField: "sub", UserInfoEndpoint: OAuthRelayUserInfoURL}
+		if err := db.Create(provider).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := db.Create(&UserOAuthBinding{UserId: userID, ProviderId: 1, ProviderUserId: sub}).Error; err != nil {
+		t.Fatal(err)
+	}
+	return user
+}
+
+func oauthRelayNormalToken(t *testing.T, userID int, name string) *Token {
+	t.Helper()
+	key, err := common.GenerateKey()
+	if err != nil {
+		t.Fatal("failed to generate fixture token")
+	}
+	token := &Token{UserId: userID, Key: key, Name: name, Status: common.TokenStatusEnabled, ExpiredTime: -1, UnlimitedQuota: true}
+	if err := token.Insert(); err != nil {
+		t.Fatal(err)
+	}
+	return token
+}
+
+type oauthRelayLegacyToken struct {
+	Id     int
+	UserId int    `gorm:"index"`
+	Key    string `gorm:"type:varchar(128);uniqueIndex"`
+	Status int    `gorm:"default:1"`
+}
+
+func (oauthRelayLegacyToken) TableName() string { return "tokens" }
+
+func TestOAuthRelayMigratesLegacyTokensWithoutClaimingThem(t *testing.T) {
+	db := oauthRelayTestDB(t)
+	user := oauthRelayFixture(t, db, 11, "stable-sub-A")
+	if err := db.Migrator().DropTable(&Token{}); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&oauthRelayLegacyToken{}); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		key, err := common.GenerateKey()
+		if err != nil {
+			t.Fatal("fixture credential generation failed")
+		}
+		if err := db.Create(&oauthRelayLegacyToken{UserId: user.Id, Key: key, Status: common.TokenStatusEnabled}).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := db.AutoMigrate(&Token{}); err != nil {
+		t.Fatal(err)
+	}
+	if count, err := CountUserTokens(user.Id); err != nil || count != 2 {
+		t.Fatal("migration did not preserve both existing NULL-purpose tokens")
+	}
+	internal, err := GetOrCreateOAuthRelayToken(user.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := db.AutoMigrate(&Token{}); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := GetOrCreateOAuthRelayToken(user.Id)
+	if err != nil || loaded.Id != internal.Id || loaded.Key != internal.Key {
+		t.Fatal("repeated migration changed the issued internal credential")
+	}
+	if count, err := CountUserTokens(user.Id); err != nil || count != 2 {
+		t.Fatal("migration exposed or consumed a normal token slot")
+	}
+}
+
+func TestOAuthRelayResolveOnlyExistingExactActiveBinding(t *testing.T) {
+	for _, role := range []int{common.RoleCommonUser, common.RoleAdminUser, common.RoleRootUser} {
+		t.Run(fmt.Sprintf("role_%d", role), func(t *testing.T) {
+			db := oauthRelayTestDB(t)
+			user := oauthRelayFixture(t, db, 11, "stable-sub-A")
+			if err := db.Model(user).Updates(map[string]any{"role": role, "quota": 0}).Error; err != nil {
+				t.Fatal(err)
+			}
+			resolved, err := ResolveOAuthRelayUser(1, "pingxingxian", "stable-sub-A")
+			if err != nil || resolved.Id != user.Id || resolved.Role != role || resolved.Quota != 0 {
+				t.Fatal("existing active binding was not resolved without changing role/quota")
+			}
+		})
+	}
+	cases := []struct {
+		name   string
+		mutate func(*gorm.DB, *User) error
+		id     int
+		slug   string
+		sub    string
+	}{
+		{"unknown_provider", nil, 2, "pingxingxian", "stable-sub-A"},
+		{"wrong_slug", nil, 1, "another", "stable-sub-A"},
+		{"missing_sub", nil, 1, "pingxingxian", ""},
+		{"unknown_sub", nil, 1, "pingxingxian", "stable-sub-B"},
+		{"case_changed_sub", nil, 1, "pingxingxian", "stable-sub-a"},
+		{"disabled_provider", func(db *gorm.DB, _ *User) error {
+			return db.Model(&CustomOAuthProvider{}).Where("id = ?", 1).Update("enabled", false).Error
+		}, 1, "pingxingxian", "stable-sub-A"},
+		{"non_sub_mapping", func(db *gorm.DB, _ *User) error {
+			return db.Model(&CustomOAuthProvider{}).Where("id = ?", 1).Update("user_id_field", "email").Error
+		}, 1, "pingxingxian", "stable-sub-A"},
+		{"wrong_provider_issuer", func(db *gorm.DB, _ *User) error {
+			return db.Model(&CustomOAuthProvider{}).Where("id = ?", 1).Update("user_info_endpoint", "https://other.example/me").Error
+		}, 1, "pingxingxian", "stable-sub-A"},
+		{"missing_binding", func(db *gorm.DB, _ *User) error {
+			return db.Where("provider_id = ?", 1).Delete(&UserOAuthBinding{}).Error
+		}, 1, "pingxingxian", "stable-sub-A"},
+		{"disabled_user", func(db *gorm.DB, u *User) error { return db.Model(u).Update("status", common.UserStatusDisabled).Error }, 1, "pingxingxian", "stable-sub-A"},
+		{"deleted_user", func(db *gorm.DB, u *User) error { return db.Delete(u).Error }, 1, "pingxingxian", "stable-sub-A"},
+		{"guest_role", func(db *gorm.DB, u *User) error { return db.Model(u).Update("role", 0).Error }, 1, "pingxingxian", "stable-sub-A"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			db := oauthRelayTestDB(t)
+			user := oauthRelayFixture(t, db, 11, "stable-sub-A")
+			if tc.mutate != nil {
+				if err := tc.mutate(db, user); err != nil {
+					t.Fatal(err)
+				}
+			}
+			resolved, err := ResolveOAuthRelayUser(tc.id, tc.slug, tc.sub)
+			if resolved != nil || !errors.Is(err, ErrOAuthRelayIdentityDenied) {
+				t.Fatal("invalid binding unexpectedly resolved")
+			}
+			var count int64
+			if err := db.Model(&Token{}).Count(&count).Error; err != nil || count != 0 {
+				t.Fatal("identity resolution created credentials")
+			}
+		})
+	}
+}
+
+func TestOAuthRelayResolveRejectsAmbiguousBinding(t *testing.T) {
+	db := oauthRelayTestDB(t)
+	oauthRelayFixture(t, db, 11, "stable-sub-A")
+	oauthRelayFixture(t, db, 12, "stable-sub-B")
