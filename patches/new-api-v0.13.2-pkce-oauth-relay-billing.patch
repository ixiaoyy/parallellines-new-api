+func TestOAuthRelayCredentialConcurrentIssuanceAndNullableMigration(t *testing.T) {
+	db := oauthRelayTestDB(t)
+	user := oauthRelayFixture(t, db, 11, "stable-sub-A")
+	normal1 := oauthRelayNormalToken(t, user.Id, "normal-one")
+	normal2 := oauthRelayNormalToken(t, user.Id, "normal-two")
+	if normal1.Id == normal2.Id {
+		t.Fatal("NULL-purpose normal tokens collided")
+	}
+	const workers = 24
+	start := make(chan struct{})
+	ids, failures := make(chan int, workers), make(chan error, workers)
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			token, err := GetOrCreateOAuthRelayToken(user.Id)
+			if err != nil {
+				failures <- err
+				return
+			}
+			ids <- token.Id
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(ids)
+	close(failures)
+	for err := range failures {
+		t.Fatalf("concurrent issuance failed: %v", err)
+	}
+	winner, results := 0, 0
+	for id := range ids {
+		results++
+		if winner == 0 {
+			winner = id
+		} else if id != winner {
+			t.Fatal("concurrent issuance returned different credentials")
+		}
+	}
+	var count int64
+	if err := db.Model(&Token{}).Where("user_id = ? AND internal_purpose = ?", user.Id, OAuthRelayTokenPurpose).Count(&count).Error; err != nil || count != 1 || results != workers {
+		t.Fatal("unique internal credential invariant failed")
+	}
+}
