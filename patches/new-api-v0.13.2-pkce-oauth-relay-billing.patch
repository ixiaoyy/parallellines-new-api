+			}
+		}
+	})
+	t.Run("native relay billing rejects zero quota for both protocols", func(t *testing.T) {
+		for _, tc := range []struct{ path, body string }{
+			{"/chat/completions", `{"model":"gpt-6-luna","messages":[{"role":"user","content":"synthetic"}]}`},
+			{"/responses", `{"model":"gpt-6-luna","input":"synthetic"}`},
+		} {
+			res := request("POST", "/oauth-relay/v1"+tc.path, "fixture-zero", tc.body)
+			if res.Code != 403 || !strings.Contains(res.Body.String(), "insufficient_user_quota") {
+				t.Fatalf("native quota rejection missing: HTTP %d %s", res.Code, res.Body.String())
+			}
+		}
+	})
+	t.Run("anonymous and invalid identities rejected", func(t *testing.T) {
+		for _, identity := range []string{"", "untrusted"} {
