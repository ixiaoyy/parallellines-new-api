+				t.Fatalf("untrusted identity HTTP %d", res.Code)
+			}
+		}
+	})
+	var tokens []model.Token
+	if err := model.DB.Where("internal_purpose = ?", model.OAuthRelayTokenPurpose).Order("user_id").Find(&tokens).Error; err != nil {
+		t.Fatal(err)
+	}
+	if len(tokens) != 2 || tokens[0].UserId != 501 || tokens[1].UserId != 502 || tokens[0].Key == tokens[1].Key {
+		t.Fatal("router identities did not receive separate native token owners")
+	}
+	for _, token := range tokens {
+		res := request("GET", "/oauth-relay/v1/models", "fixture-zero", "")
+		if strings.Contains(res.Body.String(), token.Key) {
+			t.Fatal("internal credential leaked in client response")
+		}
+		var user model.User
+		if err := model.DB.First(&user, token.UserId).Error; err != nil || user.Quota != 0 || user.UsedQuota != 0 {
+			t.Fatal("read/denied request changed quota")
+		}
+	}
+	if userinfoCalls == 0 || forbiddenCalls != 0 {
+		t.Fatalf("unexpected request counts: UserInfo=%d blocked-other=%d", userinfoCalls, forbiddenCalls)
+	}
+}
