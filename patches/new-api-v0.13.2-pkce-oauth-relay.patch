+		states = append(states, state)
+		challenges = append(challenges, challenge)
+	}
+	requireCapacity(t, store, binding)
+	other := binding
+	other.Session = "other-browser"
+	otherState, otherChallenge := requireIssue(t, store, other)
+	requireConsume(t, store, states[0], binding, challenges[0])
+	replacement, replacementChallenge := requireIssue(t, store, binding)
+	for i := 1; i < len(states); i++ {
+		requireConsume(t, store, states[i], binding, challenges[i])
+	}
+	requireConsume(t, store, replacement, binding, replacementChallenge)
+	requireConsume(t, store, otherState, other, otherChallenge)
+}
+
+func TestStoreExpiryReleasesCapacity(t *testing.T) {
+	const ttl = 5 * time.Minute
+	for _, tt := range []struct {
+		name     string
+		capacity int
+		count    int
+	}{
+		{"global capacity", 2, 2},
+		{"per binding capacity", 32, 8},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			now := time.Date(2026, time.January, 1, 0, 0, 0, 0, time.UTC)
+			store := NewStore(ttl, tt.capacity)
+			store.now = func() time.Time { return now }
+			binding := testBinding()
+			var oldStates []string
+			for i := 0; i < tt.count; i++ {
+				state, _ := requireIssue(t, store, binding)
+				oldStates = append(oldStates, state)
+			}
+			requireCapacity(t, store, binding)
+			now = now.Add(ttl)
+			// Issue must recover expired capacity without a prior Consume call.
+			state, challenge := requireIssue(t, store, binding)
+			for _, oldState := range oldStates {
+				requireInvalidState(t, store, oldState, binding)
+			}
+			requireConsume(t, store, state, binding, challenge)
+		})
+	}
+}
+
+func TestStoreConcurrentIssueHonorsCapacity(t *testing.T) {
+	for _, tt := range []struct {
+		name        string
+		capacity    int
+		wantIssued  int
+		sameBinding bool
+	}{
+		{"global capacity", 16, 16, false},
+		{"per binding capacity", 64, 8, true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			store := NewStore(5*time.Minute, tt.capacity)
+			const attempts = 64
+			type result struct {
+				state     string
+				challenge string
+				binding   Binding
+				err       error
+			}
+			start := make(chan struct{})
+			results := make(chan result, attempts)
+			var wg sync.WaitGroup
+			for i := 0; i < attempts; i++ {
+				binding := testBinding()
+				if !tt.sameBinding {
+					binding.Session = "test-browser-" + strconv.Itoa(i)
+				}
+				wg.Add(1)
+				go func(binding Binding) {
+					defer wg.Done()
+					<-start
+					state, challenge, err := store.Issue(binding)
+					results <- result{state, challenge, binding, err}
+				}(binding)
+			}
+			close(start)
+			wg.Wait()
+			close(results)
+			seen := make(map[string]bool)
+			for result := range results {
+				if result.err != nil {
+					if !errors.Is(result.err, ErrCapacity) || result.state != "" || result.challenge != "" {
+						t.Fatalf("rejected Issue() returned unexpected result: %v", result.err)
+					}
+					continue
+				}
+				if seen[result.state] {
+					t.Fatal("concurrent Issue() repeated a pending state")
+				}
+				seen[result.state] = true
+				requireConsume(t, store, result.state, result.binding, result.challenge)
+			}
+			if len(seen) != tt.wantIssued {
+				t.Fatalf("successful concurrent issues = %d, want %d", len(seen), tt.wantIssued)
+			}
+		})
+	}
+}
