+func TestStorePerBindingCapacityDoesNotEvictPendingTransactions(t *testing.T) {
+	store := NewStore(5*time.Minute, 32)
+	binding := testBinding()
+	var states, challenges []string
+	for i := 0; i < 8; i++ {
