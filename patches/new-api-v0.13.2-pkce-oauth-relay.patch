+func TestStoreBindingMismatchDoesNotConsume(t *testing.T) {
+	tests := []struct {
+		name   string
+		change func(*Binding)
+	}{
+		{"other session", func(b *Binding) { b.Session = "other-browser" }},
+		{"missing session", func(b *Binding) { b.Session = "" }},
+		{"other user", func(b *Binding) { b.UserID++ }},
+		{"logged out", func(b *Binding) { b.UserID = 0 }},
+		{"other provider", func(b *Binding) { b.ProviderID++ }},
+		{"missing provider", func(b *Binding) { b.ProviderID = 0 }},
+		{"changed config", func(b *Binding) { b.Fingerprint = "changed-config" }},
+		{"missing config", func(b *Binding) { b.Fingerprint = "" }},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			store := NewStore(5*time.Minute, 16)
+			binding := testBinding()
+			state, challenge := requireIssue(t, store, binding)
+			wrong := binding
+			tt.change(&wrong)
+			requireInvalidState(t, store, state, wrong)
+			requireConsume(t, store, state, binding, challenge)
+		})
+	}
+	t.Run("anonymous initiation then login", func(t *testing.T) {
+		store := NewStore(5*time.Minute, 16)
+		anonymous := testBinding()
+		anonymous.UserID = 0
+		state, challenge := requireIssue(t, store, anonymous)
+		requireInvalidState(t, store, state, testBinding())
+		requireConsume(t, store, state, anonymous, challenge)
+	})
+}
