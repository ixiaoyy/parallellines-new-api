+func TestOAuthRelayRevokeIsPermanentAndDoesNotClaimMissingRows(t *testing.T) {
+	db := oauthRelayTestDB(t)
+	user := oauthRelayFixture(t, db, 11, "stable-sub-A")
+	if err := RevokeOAuthRelayToken(user.Id); !errors.Is(err, gorm.ErrRecordNotFound) {
+		t.Fatal("revoking an absent credential claimed success")
+	}
+	internal, err := GetOrCreateOAuthRelayToken(user.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	normal := oauthRelayNormalToken(t, user.Id, "normal-one")
+	for i := 0; i < 2; i++ {
+		if err := RevokeOAuthRelayToken(user.Id); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if token, err := GetOrCreateOAuthRelayToken(user.Id); token != nil || !errors.Is(err, ErrOAuthRelayCredentialUnavailable) {
+		t.Fatal("revoked credential was reissued")
+	}
+	var stored Token
+	if err := db.Unscoped().First(&stored, internal.Id).Error; err != nil || stored.Status != common.TokenStatusDisabled {
+		t.Fatal("internal credential was not disabled")
+	}
+	if found, err := GetTokenById(normal.Id); err != nil || found.Status != common.TokenStatusEnabled {
+		t.Fatal("revocation changed a normal user token")
+	}
+	if current, err := GetUserById(user.Id, false); err != nil || current.Quota != user.Quota || current.Role != user.Role {
+		t.Fatal("revocation modified user quota or role")
+	}
+}
