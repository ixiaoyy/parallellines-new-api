@@ -0,0 +1,61 @@
+package oauth
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"net/url"
+	"os"
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/QuantumNous/new-api/setting/system_setting"
+)
+
+const PKCEVerifierContextKey = "custom_oauth_pkce_verifier"
+const PKCERedirectContextKey = "custom_oauth_pkce_redirect"
+
+// CustomPKCEEnabled is explicitly opt-in per custom provider slug. Legacy providers
+// retain their upstream behavior; selected providers never fall back without PKCE.
+func CustomPKCEEnabled(slug string) bool {
+	for _, allowed := range strings.Split(os.Getenv("CUSTOM_OAUTH_PKCE_PROVIDERS"), ",") {
+		if strings.TrimSpace(allowed) == slug && slug != "" {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *GenericOAuthProvider) Snapshot() *GenericOAuthProvider {
+	config := *p.config
+	return NewGenericOAuthProvider(&config)
+}
+
+// PKCEConfiguration freezes the trusted redirect and all provider security settings.
+// The client secret is excluded from the model's JSON, so include it explicitly in
+// this internal hash. Neither the payload nor its digest is returned to browsers.
+func (p *GenericOAuthProvider) PKCEConfiguration() (string, string, error) {
+	base, err := url.Parse(system_setting.ServerAddress)
+	if err != nil || base.Scheme != "https" || base.Host == "" || base.User != nil ||
+		base.RawQuery != "" || base.Fragment != "" || (base.Path != "" && base.Path != "/") {
+		return "", "", fmt.Errorf("PKCE requires an HTTPS ServerAddress origin")
+	}
+	for _, endpoint := range []string{p.config.AuthorizationEndpoint, p.config.TokenEndpoint, p.config.UserInfoEndpoint} {
+		u, parseErr := url.Parse(endpoint)
+		if parseErr != nil || u.Scheme != "https" || u.Host == "" || u.User != nil || u.Fragment != "" {
+			return "", "", fmt.Errorf("PKCE requires HTTPS provider endpoints")
+		}
+	}
+	redirect := strings.TrimRight(system_setting.ServerAddress, "/") + "/oauth/" + p.config.Slug
+	payload, err := common.Marshal(struct {
+		Provider model.CustomOAuthProvider
+		Secret   string
+		Redirect string
+	}{*p.config, p.config.ClientSecret, redirect})
+	if err != nil {
+		return "", "", err
+	}
+	hash := sha256.Sum256(payload)
+	return redirect, hex.EncodeToString(hash[:]), nil
+}
diff --git a/pkg/oauthpkce/store.go b/pkg/oauthpkce/store.go
new file mode 100644
index 0000000..c273266
--- /dev/null
+++ b/pkg/oauthpkce/store.go
@@ -0,0 +1,111 @@
+// Package oauthpkce holds short-lived, single-use OAuth authorization transactions.
+// It deliberately stores verifiers on the server, never in the signed session cookie.
+package oauthpkce
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"sync"
+	"time"
+)
+
+var (
+	ErrInvalidState = errors.New("invalid or expired OAuth transaction")
+	ErrCapacity     = errors.New("too many pending OAuth transactions")
+)
+
+type Binding struct {
+	Session     string
+	UserID      int
+	ProviderID  int
+	Fingerprint string
+}
+
+type transaction struct {
+	binding  Binding
+	verifier string
+	expires  time.Time
+}
+
+type Store struct {
+	mu       sync.Mutex
+	pending  map[[32]byte]transaction
+	ttl      time.Duration
+	capacity int
+	now      func() time.Time
+}
+
+func NewStore(ttl time.Duration, capacity int) *Store {
+	return &Store{pending: make(map[[32]byte]transaction), ttl: ttl, capacity: capacity, now: time.Now}
+}
+
+func RandomValue() (string, error) {
+	var b [32]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(b[:]), nil
+}
+
+func Challenge(verifier string) string {
+	digest := sha256.Sum256([]byte(verifier))
+	return base64.RawURLEncoding.EncodeToString(digest[:])
+}
+
+func (s *Store) prune(now time.Time) {
+	for key, tx := range s.pending {
+		if !now.Before(tx.expires) {
+			delete(s.pending, key)
+		}
+	}
+}
+
+func (s *Store) Issue(binding Binding) (string, string, error) {
+	if binding.Session == "" || binding.ProviderID <= 0 || binding.Fingerprint == "" {
+		return "", "", ErrInvalidState
+	}
+	state, err := RandomValue()
+	if err != nil {
+		return "", "", err
+	}
+	verifier, err := RandomValue()
+	if err != nil {
+		return "", "", err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.now()
+	s.prune(now)
+	count := 0
+	for _, tx := range s.pending {
+		if tx.binding.Session == binding.Session {
+			count++
+		}
+	}
+	if len(s.pending) >= s.capacity || count >= 8 {
+		return "", "", ErrCapacity
+	}
+	key := sha256.Sum256([]byte(state))
+	if _, exists := s.pending[key]; exists {
+		return "", "", ErrCapacity
+	}
+	s.pending[key] = transaction{binding: binding, verifier: verifier, expires: now.Add(s.ttl)}
+	return state, Challenge(verifier), nil
+}
+
+// Consume rejects mismatched sessions without burning another browser's transaction.
+// A matched transaction is removed atomically before any token exchange is attempted.
+func (s *Store) Consume(state string, binding Binding) (string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.prune(s.now())
+	key := sha256.Sum256([]byte(state))
+	tx, ok := s.pending[key]
+	if !ok || state == "" || tx.binding != binding {
+		return "", ErrInvalidState
+	}
+	delete(s.pending, key)
+	return tx.verifier, nil
+}
diff --git a/pkg/oauthpkce/store_test.go b/pkg/oauthpkce/store_test.go
new file mode 100644
index 0000000..5a92279
--- /dev/null
+++ b/pkg/oauthpkce/store_test.go
@@ -0,0 +1,367 @@
+package oauthpkce
+
+import (
+	"encoding/base64"
+	"errors"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+)
+
+func testBinding() Binding {
+	return Binding{
+		Session:     "test-browser-binding",
+		UserID:      17,
+		ProviderID:  3,
+		Fingerprint: "test-config-fingerprint",
+	}
+}
+
+func requireRandomValue(t *testing.T, label, value string) {
+	t.Helper()
+	if len(value) != 43 {
+		t.Fatalf("%s length = %d, want 43", label, len(value))
+	}
+	decoded, err := base64.RawURLEncoding.DecodeString(value)
+	if err != nil {
+		t.Fatalf("%s is not unpadded base64url: %v", label, err)
+	}
+	if len(decoded) != 32 {
+		t.Fatalf("%s decodes to %d bytes, want 32", label, len(decoded))
+	}
+}
+
+func requireIssue(t *testing.T, store *Store, binding Binding) (string, string) {
+	t.Helper()
+	state, challenge, err := store.Issue(binding)
+	if err != nil {
+		t.Fatalf("Issue() error: %v", err)
+	}
+	requireRandomValue(t, "state", state)
+	requireRandomValue(t, "challenge", challenge)
+	return state, challenge
+}
+
+func requireConsume(t *testing.T, store *Store, state string, binding Binding, challenge string) {
+	t.Helper()
+	verifier, err := store.Consume(state, binding)
+	if err != nil {
+		t.Fatalf("Consume() error: %v", err)
+	}
+	requireRandomValue(t, "verifier", verifier)
+	if verifier == state {
+		t.Fatal("state and verifier must be generated independently")
+	}
+	if Challenge(verifier) != challenge {
+		t.Fatal("consumed verifier does not match the issued S256 challenge")
+	}
+}
+
+func requireInvalidState(t *testing.T, store *Store, state string, binding Binding) {
+	t.Helper()
+	verifier, err := store.Consume(state, binding)
+	if !errors.Is(err, ErrInvalidState) {
+		t.Fatalf("Consume() error = %v, want ErrInvalidState", err)
+	}
+	if verifier != "" {
+		t.Fatal("rejected Consume() returned a verifier")
+	}
+}
+
+func requireCapacity(t *testing.T, store *Store, binding Binding) {
+	t.Helper()
+	state, challenge, err := store.Issue(binding)
+	if !errors.Is(err, ErrCapacity) {
+		t.Fatalf("Issue() error = %v, want ErrCapacity", err)
+	}
+	if state != "" || challenge != "" {
+		t.Fatal("rejected Issue() returned transaction material")
+	}
+}
+
+func TestChallengeRFC7636(t *testing.T) {
+	// RFC 7636, Appendix B: public S256 example, not a real credential.
+	const verifier = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
+	const expected = "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
+	if got := Challenge(verifier); got != expected {
+		t.Fatalf("Challenge(RFC example) = %q, want %q", got, expected)
+	}
+}
+
