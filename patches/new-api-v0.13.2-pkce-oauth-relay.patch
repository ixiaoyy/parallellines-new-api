+	common.IsMasterNode, common.RedisEnabled, common.BatchUpdateEnabled, common.MemoryCacheEnabled = false, false, false, false
+	constant.CountToken = false // No tokenizer downloads; price fixtures are per-request, not production rates.
+	if err := model.InitDB(); err != nil {
