  * @param {boolean} options.shouldLogout - Whether to logout first
  */
 export async function onCustomOAuthClicked(provider, options = {}) {
+  if (provider.pkce_enabled) {
+    try {
+      if (options.shouldLogout) {
+        // Unlike the legacy flow, failed logout must not turn login into binding.
+        const { data } = await API.get('/api/user/logout', {
+          skipErrorHandler: true,
+        });
+        if (!data.success) throw new Error(data.message);
+        localStorage.removeItem('user');
+        updateAPI();
+      }
+      const aff = localStorage.getItem('aff');
+      const { data } = await API.post(
+        `/api/oauth/${encodeURIComponent(provider.slug)}/start`,
+        null,
+        { params: aff ? { aff } : {} },
+      );
+      if (!data.success) throw new Error(data.message);
+      redirectToOAuthUrl(data.data.authorization_url);
+    } catch (error) {
+      showError(error);
+    }
+    return;
+  }
   const state = await prepareOAuthState(options);
   if (!state) return;
 
diff --git a/web/src/helpers/api.pkce.test.js b/web/src/helpers/api.pkce.test.js
new file mode 100644
index 0000000..b7eff08
--- /dev/null
+++ b/web/src/helpers/api.pkce.test.js
@@ -0,0 +1,258 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { Script } from 'node:vm';
+
+// Exercise the actual helper bodies without importing React or starting an app.
+// Every browser and HTTP dependency is an in-memory stub; no requests are sent.
+const source = readFileSync(new URL('./api.js', import.meta.url), 'utf8');
+
+function extract(startMarker, endMarker) {
+  const start = source.indexOf(startMarker);
+  const end = source.indexOf(endMarker, start + startMarker.length);
+  assert.ok(
+    start >= 0 && end > start,
+    'OAuth helper source boundaries changed',
+  );
+  return source.slice(start, end).replace(/^export /, '');
+}
+
+const helperScript = new Script(
+  [
+    extract(
+      'export async function getOAuthState(',
+      '\nasync function prepareOAuthState(',
+    ),
+    extract(
+      'async function prepareOAuthState(',
+      '\nexport async function onDiscordOAuthClicked(',
+    ),
+    extract(
+      'export async function onCustomOAuthClicked(',
+      '\nlet channelModels =',
+    ),
+    'onCustomOAuthClicked;',
+  ].join('\n'),
+  { filename: 'api.js (isolated OAuth helpers)' },
+);
+
+const serverAuthorizationURL =
+  'https://issuer.example/authorize?state=fixture-state&code_challenge=fixture-challenge&code_challenge_method=S256';
+const provider = {
+  slug: 'fixture-provider',
+  pkce_enabled: true,
+  client_id: 'fixture-client',
+  authorization_endpoint:
+    'https://legacy.example/authorize?audience=fixture-audience',
+  scopes: 'openid profile offline_access',
+};
+
+function harness(options = {}) {
+  const calls = [];
+  const events = [];
+  const errors = [];
+  const redirects = [];
+  const storage = new Map([['user', 'fixture-local-user']]);
+  if (options.aff) storage.set('aff', options.aff);
+  const copy = (value) =>
+    value === undefined ? undefined : JSON.parse(JSON.stringify(value));
+  const record = (method, path, body, requestOptions) => {
+    calls.push({ method, path, body, options: copy(requestOptions) });
+    events.push(`${method}:${path}`);
+  };
+  const API = {
+    async get(path, requestOptions) {
+      record('get', path, undefined, requestOptions);
+      if (path === '/api/user/logout') {
+        if (options.logoutError) throw options.logoutError;
+        return { data: options.logoutResponse ?? { success: true } };
+      }
+      if (path.startsWith('/api/oauth/state')) {
+        return {
+          data: options.stateResponse ?? {
+            success: true,
+            data: 'fixture-legacy-state',
+          },
+        };
+      }
+      throw new Error(`Unexpected mocked GET: ${path}`);
+    },
+    async post(path, body, requestOptions) {
+      record('post', path, body, requestOptions);
+      if (path !== '/api/oauth/fixture-provider/start') {
+        throw new Error(`Unexpected mocked POST: ${path}`);
+      }
+      if (options.startError) throw options.startError;
+      return {
+        data: options.startResponse ?? {
+          success: true,
+          data: { authorization_url: serverAuthorizationURL },
+        },
+      };
+    },
+  };
+  const click = helperScript.runInNewContext({
+    API,
+    URL,
+    window: { location: { origin: 'https://candidate.example' } },
+    localStorage: {
+      getItem: (key) => storage.get(key) ?? null,
+      removeItem(key) {
+        events.push(`remove:${key}`);
+        storage.delete(key);
+      },
+    },
+    updateAPI: () => events.push('updateAPI'),
+    showError: (error) => errors.push(error),
+    redirectToOAuthUrl(url) {
+      redirects.push(url.toString());
+      events.push('redirect');
+    },
+    console: { error() {} },
+  });
+  return { click, calls, events, errors, redirects, storage };
+}
+
+function requestPaths(h) {
+  return h.calls.map(({ method, path }) => `${method}:${path}`);
+}
+
+test('PKCE uses the server URL and never requests legacy state', async () => {
+  const h = harness({ aff: 'fixture-affiliate+code' });
+  await h.click(provider);
+
+  assert.deepEqual(requestPaths(h), ['post:/api/oauth/fixture-provider/start']);
+  assert.equal(h.calls[0].body, null);
+  assert.deepEqual(h.calls[0].options, {
+    params: { aff: 'fixture-affiliate+code' },
+  });
+  assert.deepEqual(h.redirects, [serverAuthorizationURL]);
+  assert.deepEqual(h.errors, []);
+  assert.equal(h.storage.get('user'), 'fixture-local-user');
+  assert.ok(!h.events.includes('updateAPI'));
+});
+
+test('PKCE omits an absent affiliate and does not log out a binding flow', async () => {
+  const h = harness();
+  await h.click(provider, { shouldLogout: false });
+
+  assert.deepEqual(requestPaths(h), ['post:/api/oauth/fixture-provider/start']);
+  assert.deepEqual(h.calls[0].options, { params: {} });
+  assert.deepEqual(h.redirects, [serverAuthorizationURL]);
+  assert.equal(h.storage.get('user'), 'fixture-local-user');
+});
+
+test('PKCE waits for successful logout before clearing the user and starting', async () => {
+  const h = harness();
+  await h.click(provider, { shouldLogout: true });
+
+  assert.deepEqual(h.events, [
+    'get:/api/user/logout',
+    'remove:user',
+    'updateAPI',
+    'post:/api/oauth/fixture-provider/start',
+    'redirect',
+  ]);
+  assert.deepEqual(h.calls[0].options, { skipErrorHandler: true });
+  assert.equal(h.storage.has('user'), false);
+  assert.deepEqual(h.redirects, [serverAuthorizationURL]);
+  assert.deepEqual(h.errors, []);
+});
+
+for (const [name, failure] of [
+  [
+    'business rejection',
+    { logoutResponse: { success: false, message: 'fixture logout rejected' } },
+  ],
+  ['request failure', { logoutError: new Error('fixture logout unavailable') }],
+]) {
+  test(`PKCE stops after logout ${name}`, async () => {
+    const h = harness(failure);
+    await h.click(provider, { shouldLogout: true });
+
+    assert.deepEqual(h.events, ['get:/api/user/logout']);
+    assert.equal(h.storage.get('user'), 'fixture-local-user');
+    assert.deepEqual(h.redirects, []);
+    assert.equal(h.errors.length, 1);
+    assert.match(h.errors[0].message, /fixture logout/);
+  });
+}
+
+for (const [name, failure] of [
+  [
+    'business rejection',
+    { startResponse: { success: false, message: 'fixture start rejected' } },
+  ],
+  ['request failure', { startError: new Error('fixture start unavailable') }],
+]) {
+  test(`PKCE start ${name} does not redirect or fall back to legacy state`, async () => {
+    const h = harness(failure);
+    await h.click(provider);
+
+    assert.deepEqual(requestPaths(h), [
+      'post:/api/oauth/fixture-provider/start',
+    ]);
+    assert.deepEqual(h.redirects, []);
+    assert.equal(h.errors.length, 1);
+    assert.match(h.errors[0].message, /fixture start/);
+  });
+}
+
+for (const flag of [false, undefined]) {
+  test(`legacy provider with pkce_enabled=${flag} retains its authorization flow`, async () => {
+    const h = harness({ aff: 'fixture-affiliate' });
+    await h.click({ ...provider, pkce_enabled: flag });
+
+    assert.deepEqual(requestPaths(h), [
+      'get:/api/oauth/state?aff=fixture-affiliate',
+    ]);
+    assert.equal(h.redirects.length, 1);
+    const url = new URL(h.redirects[0]);
+    assert.equal(url.origin, 'https://legacy.example');
+    assert.equal(url.pathname, '/authorize');
+    assert.equal(url.searchParams.get('audience'), 'fixture-audience');
+    assert.equal(url.searchParams.get('client_id'), provider.client_id);
+    assert.equal(
+      url.searchParams.get('redirect_uri'),
+      'https://candidate.example/oauth/fixture-provider',
+    );
+    assert.equal(url.searchParams.get('response_type'), 'code');
+    assert.equal(url.searchParams.get('scope'), provider.scopes);
+    assert.equal(url.searchParams.get('state'), 'fixture-legacy-state');
+    assert.equal(url.searchParams.has('code_challenge'), false);
+    assert.equal(url.searchParams.has('code_challenge_method'), false);
+    assert.deepEqual(h.errors, []);
+  });
+}
+
+test('legacy logout ordering and default scope remain unchanged', async () => {
+  const h = harness();
+  await h.click(
+    { ...provider, pkce_enabled: false, scopes: '' },
+    { shouldLogout: true },
+  );
+
+  assert.deepEqual(h.events, [
+    'get:/api/user/logout',
+    'remove:user',
+    'updateAPI',
+    'get:/api/oauth/state',
+    'redirect',
+  ]);
+  assert.equal(
+    new URL(h.redirects[0]).searchParams.get('scope'),
+    'openid profile email',
+  );
+  assert.deepEqual(h.errors, []);
+});
+
+test('legacy state rejection still stops before authorization', async () => {
+  const h = harness({
+    stateResponse: { success: false, message: 'fixture state rejected' },
+  });
+  await h.click({ ...provider, pkce_enabled: false });
+
+  assert.deepEqual(requestPaths(h), ['get:/api/oauth/state']);
+  assert.deepEqual(h.redirects, []);
+  assert.deepEqual(h.errors, ['fixture state rejected']);
+});
