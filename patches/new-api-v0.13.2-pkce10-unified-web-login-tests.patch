+func TestUnifiedWebTrustedClaimsRequireExplicitBrowserBinding(t *testing.T) {
+	t.Setenv("MAIN_UNIFIED_WEB_LOGIN_ENABLED", "true")
+	p := profileTestProvider(t)
+	claims := profileTestClaims()
+	claims["pl_binding"] = "synthetic-binding"
+	claims["pl_auth_exp"] = time.Now().Add(time.Hour).Unix()
+	claims["pl_unified_browser"] = true
+	body, _ := common.Marshal(claims)
+	user, err := p.parseMainProfile(body)
+	if err != nil || user.Extra["main_web_binding"] != "synthetic-binding" {
+		t.Fatal("trusted new binding rejected", err)
+	}
+	for _, value := range []any{false, "true", nil, 0} {
+		claims["pl_unified_browser"] = value
+		body, _ = common.Marshal(claims)
+		if _, err := p.parseMainProfile(body); err == nil {
+			t.Fatal("old/untyped binding elevated")
+		}
+	}
+	claims["pl_unified_browser"] = true
+	claims["pl_auth_exp"] = time.Now().Add(-time.Second).Unix()
+	body, _ = common.Marshal(claims)
+	if _, err := p.parseMainProfile(body); err == nil {
+		t.Fatal("expired binding accepted")
+	}
+	t.Setenv("MAIN_UNIFIED_WEB_LOGIN_ENABLED", "false")
+	if _, err := p.parseMainProfile(body); err != nil {
+		t.Fatal("default-off old profile changed", err)
+	}
+}
+func TestUnifiedWebOpaqueStoreAndRecoveryAllowlist(t *testing.T) {
+	proof := MainWebProof{UserID: 7, Subject: "synthetic-sub", Binding: "synthetic-binding", Expires: time.Now().Add(48 * time.Hour).Unix()}
+	handle, err := SaveMainWebProof(proof)
+	if err != nil || len(handle) != 64 || strings.Contains(handle, "synthetic") {
+		t.Fatal("invalid opaque handle", err)
+	}
+	loaded, err := LoadMainWebProof(handle)
+	if err != nil || loaded != proof {
+		t.Fatal("proof lost")
+	}
+	DeleteMainWebProof(handle)
+	if _, err := LoadMainWebProof(handle); !errors.Is(err, ErrMainWebInactive) {
+		t.Fatal("deleted proof replay")
+	}
+	t.Setenv("MAIN_WEB_ROOT_RECOVERY_ENABLED", "true")
+	t.Setenv("MAIN_WEB_ROOT_RECOVERY_USER_IDS", "7,8")
+	if !MainRecoveryUser(7, 100) || MainRecoveryUser(8, 10) || MainRecoveryUser(9, 100) {
+		t.Fatal("recovery membership/role invalid")
+	}
+	for _, ids := range []string{"", "0,7", "7,x", strings.Repeat("7,", 16) + "7"} {
+		t.Setenv("MAIN_WEB_ROOT_RECOVERY_USER_IDS", ids)
+		if MainRecoveryUser(7, 100) {
+			t.Fatal("malformed allowlist accepted")
+		}
+	}
+	for _, host := range []string{"api.pingxingxian.space", "localhost.evil.invalid", "127.0.0.1.evil.invalid"} {
+		if MainRecoveryHost(host) {
+			t.Fatal("non-loopback host accepted")
+		}
+	}
+	if !MainRecoveryHost("127.0.0.1:3000") || !MainRecoveryHost("[::1]:3000") {
+		t.Fatal("tunnel host rejected")
+	}
+}
+func TestUnifiedWebLivenessNoPositiveCacheAndFixedBasicContract(t *testing.T) {
+	p := profileTestProvider(t)
+	p.config.ClientSecret = "synthetic-rp-only"
+	original := GetProvider("pingxingxian")
+	Register("pingxingxian", p)
+	oldClient := mainWebClient
+	t.Cleanup(func() {
+		mainWebClient = oldClient
+		if original != nil {
+			Register("pingxingxian", original)
+		} else {
+			Unregister("pingxingxian")
+		}
+	})
+	proof := MainWebProof{UserID: 7, Subject: "synthetic-sub", Binding: "synthetic-binding", Expires: time.Now().Add(time.Hour).Unix()}
+	calls := 0
+	active := true
+	unified := true
+	status := 200
+	payload := ""
+	mainWebClient = &http.Client{Timeout: time.Second, CheckRedirect: oldClient.CheckRedirect, Transport: profileRoundTrip(func(req *http.Request) (*http.Response, error) {
+		calls++
+		id, secret, ok := req.BasicAuth()
+		if !ok || id != mainProfileClient || secret != "synthetic-rp-only" || req.Method != "POST" || req.URL.String() != mainProfileIssuer+"/main-session-state" {
+			t.Fatal("RP endpoint or credentials drift")
+		}
+		var input map[string]string
+		if json.NewDecoder(req.Body).Decode(&input) != nil || input["binding_id"] != proof.Binding || input["subject"] != proof.Subject || len(input) != 2 {
+			t.Fatal("bad RP request")
+		}
+		body, _ := json.Marshal(map[string]any{"active": active, "sub": proof.Subject, "binding_id": proof.Binding, "auth_expires_at": proof.Expires, "unified_browser": unified})
+		if payload != "" {
+			body = []byte(payload)
+		}
+		return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(string(body))), Request: req}, nil
+	})}
+	if err := CheckMainWebProof(context.Background(), proof); err != nil {
+		t.Fatal(err)
+	}
+	active = false
+	if err := CheckMainWebProof(context.Background(), proof); !errors.Is(err, ErrMainWebInactive) || calls != 2 {
+		t.Fatal("positive liveness was cached")
+	}
+	active = true
+	unified = false
+	if err := CheckMainWebProof(context.Background(), proof); !errors.Is(err, ErrMainWebInactive) {
+		t.Fatal("old binding upgraded")
+	}
+	unified = true
+	status = 503
+	if err := CheckMainWebProof(context.Background(), proof); !errors.Is(err, ErrMainWebUnavailable) {
+		t.Fatal("authority outage became logout/success")
+	}
+	status = 200
+	payload = strings.Repeat(" ", 16385)
+	if err := CheckMainWebProof(context.Background(), proof); !errors.Is(err, ErrMainWebUnavailable) {
+		t.Fatal("unbounded authority body")
+	}
+}
+
+func TestUnifiedWebProofCapacityAndExpiryFailClosed(t *testing.T) {
+	mainWebProofs.Lock()
+	original := mainWebProofs.entries
+	mainWebProofs.entries = make(map[string]MainWebProof)
+	proof := MainWebProof{UserID: 7, Subject: "synthetic-sub", Binding: "synthetic-binding", Expires: time.Now().Add(time.Hour).Unix()}
+	for index := 0; index < 10000; index++ {
+		mainWebProofs.entries[fmt.Sprintf("%064d", index)] = proof
+	}
+	mainWebProofs.Unlock()
+	defer func() { mainWebProofs.Lock(); mainWebProofs.entries = original; mainWebProofs.Unlock() }()
+	if _, err := SaveMainWebProof(proof); !errors.Is(err, ErrMainWebUnavailable) {
+		t.Fatal("proof capacity did not fail closed")
+	}
+	mainWebProofs.Lock()
+	expired := proof
+	expired.Expires = time.Now().Add(-time.Second).Unix()
+	mainWebProofs.entries[fmt.Sprintf("%064d", 0)] = expired
+	mainWebProofs.Unlock()
+	handle, err := SaveMainWebProof(proof)
+	if err != nil {
+		t.Fatal("expired proof not reclaimed", err)
+	}
+	if _, err := LoadMainWebProof(handle); err != nil {
+		t.Fatal("new proof lost")
+	}
+	mainWebProofs.Lock()
+	count := len(mainWebProofs.entries)
+	mainWebProofs.Unlock()
+	if count != 10000 {
+		t.Fatal("store bound changed")
+	}
+}
