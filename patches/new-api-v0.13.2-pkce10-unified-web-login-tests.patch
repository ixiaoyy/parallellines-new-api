+func TestUnifiedWebLegacyCookieRejectedNativeKeysPreserved(t *testing.T) {
+	t.Setenv("MAIN_UNIFIED_WEB_LOGIN_ENABLED", "true")
+	r := sessionRevocationFixture(t)
+	login := sessionRevocationCookie(t, r, sessionRevocationRootClaims())
+	require.Equal(t, 401, sessionRevocationRequest(r, "/root", login, "", "1").Code)
+	require.Equal(t, 200, sessionRevocationRequest(r, "/pricing", nil, "", "").Code)
