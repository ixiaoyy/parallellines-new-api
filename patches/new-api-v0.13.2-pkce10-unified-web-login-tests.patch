+func TestUnifiedWebRootRecoveryUsesOriginalPasswordAndMFAOnlyOnPrivateRoute(t *testing.T) {
+	t.Setenv("MAIN_UNIFIED_WEB_LOGIN_ENABLED", "true")
+	t.Setenv("MAIN_WEB_ROOT_RECOVERY_ENABLED", "true")
+	t.Setenv("MAIN_WEB_ROOT_RECOVERY_USER_IDS", "1,2")
+	oldDB, oldPassword := model.DB, common.PasswordLoginEnabled
+	common.PasswordLoginEnabled = true
+	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	require.NoError(t, err)
+	model.DB = db
+	t.Cleanup(func() {
+		sql, _ := db.DB()
+		_ = sql.Close()
+		model.DB = oldDB
+		common.PasswordLoginEnabled = oldPassword
+	})
+	require.NoError(t, i18n.Init())
+	require.NoError(t, db.AutoMigrate(&model.User{}, &model.TwoFA{}, &model.TwoFABackupCode{}))
+	hash, err := common.Password2Hash("synthetic-private-password")
+	require.NoError(t, err)
+	require.NoError(t, db.Create(&model.User{Id: 1, Username: "synthetic-root", Password: hash, Role: 100, Status: 1, Group: "default", AffCode: "one"}).Error)
+	require.NoError(t, db.Create(&model.User{Id: 2, Username: "synthetic-ordinary", Password: hash, Role: 1, Status: 1, Group: "default", AffCode: "two"}).Error)
+	require.NoError(t, db.Create(&model.TwoFA{UserId: 1, Secret: "synthetic-unused", IsEnabled: true}).Error)
+	backup, err := common.HashBackupCode("ABCD-EFGH")
+	require.NoError(t, err)
+	require.NoError(t, db.Create(&model.TwoFABackupCode{UserId: 1, CodeHash: backup}).Error)
+	gin.SetMode(gin.TestMode)
+	r := gin.New()
+	r.Use(sessions.Sessions("session", cookie.NewStore([]byte("synthetic-recovery-cookie-key-32"))))
+	r.POST("/api/user/login", Login)
+	r.POST("/api/user/login/2fa", Verify2FALogin)
+	r.POST("/api/user/root-recovery/login", MainRootRecovery(false))
+	r.POST("/api/user/root-recovery/2fa", MainRootRecovery(true))
+	request := func(path, host, body string, cookies []*http.Cookie) *httptest.ResponseRecorder {
+		req := httptest.NewRequest("POST", path, strings.NewReader(body))
+		req.Host = host
+		req.Header.Set("Content-Type", "application/json")
+		for _, cookie := range cookies {
+			req.AddCookie(cookie)
+		}
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		return w
+	}
+	body := `{"username":"synthetic-root","password":"synthetic-private-password"}`
+	require.Equal(t, 403, request("/api/user/login", "localhost", body, nil).Code)
+	require.Equal(t, 404, request("/api/user/root-recovery/login", "api.pingxingxian.space", body, nil).Code)
+	require.Equal(t, 403, request("/api/user/root-recovery/login", "localhost", `{"username":"synthetic-ordinary","password":"synthetic-private-password"}`, nil).Code)
+	first := request("/api/user/root-recovery/login", "localhost", body, nil)
+	require.Contains(t, first.Body.String(), `"require_2fa":true`)
+	require.Equal(t, 403, request("/api/user/login/2fa", "localhost", `{"code":"ABCD-EFGH"}`, first.Result().Cookies()).Code)
+	second := request("/api/user/root-recovery/2fa", "localhost", `{"code":"ABCD-EFGH"}`, first.Result().Cookies())
+	require.Equal(t, 200, second.Code)
+	require.Contains(t, second.Body.String(), `"success":true`)
+	require.Contains(t, second.Body.String(), `"id":1`)
+	var code model.TwoFABackupCode
+	require.NoError(t, db.First(&code).Error)
+	require.True(t, code.IsUsed)
+	t.Setenv("MAIN_WEB_ROOT_RECOVERY_ENABLED", "false")
+	require.Equal(t, 404, request("/api/user/root-recovery/login", "localhost", body, nil).Code)
+}
