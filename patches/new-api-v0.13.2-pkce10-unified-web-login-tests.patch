+func TestUnifiedWebRecoveryRequiresLoopbackAllowlistAndCurrentRoot(t *testing.T) {
+	t.Setenv("MAIN_UNIFIED_WEB_LOGIN_ENABLED", "true")
+	t.Setenv("MAIN_WEB_ROOT_RECOVERY_ENABLED", "true")
+	t.Setenv("MAIN_WEB_ROOT_RECOVERY_USER_IDS", "1")
+	r := sessionRevocationFixture(t)
+	handle, err := oauth.SaveMainWebProof(oauth.MainWebProof{UserID: 1, Recovery: true, Expires: time.Now().Add(time.Hour).Unix()})
+	require.NoError(t, err)
+	defer oauth.DeleteMainWebProof(handle)
+	values := sessionRevocationRootClaims()
+	values[oauth.MainWebProofKey] = handle
+	login := sessionRevocationCookie(t, r, values)
+	request := func(host string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest("GET", "/root", nil)
+		req.Host = host
+		req.AddCookie(login)
+		req.Header.Set("New-Api-User", "1")
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, req)
+		return w
+	}
+	require.Equal(t, 401, request("api.pingxingxian.space").Code)
+	require.Contains(t, request("localhost:3000").Body.String(), `"handler":true`)
+	require.NoError(t, model.DB.Model(&model.User{}).Where("id = ?", 1).Update("role", 10).Error)
+	require.Equal(t, 401, request("localhost:3000").Code)
+}
