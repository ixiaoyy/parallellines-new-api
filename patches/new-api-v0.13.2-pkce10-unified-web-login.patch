@@ -0,0 +1,79 @@
+import { API, updateAPI } from './api';
+import { showError } from './utils';
+
+export const MAIN_ORIGIN = 'https://pingxingxian.space';
+export const RETURN_KEY = 'pl-unified-return';
+
+// 换号时清掉用户、游乐场消息/密钥及私有模块缓存；仅保留公开状态、语言和主题。
+export function clearUnifiedPrivateCache() {
+  for (const key of Object.keys(localStorage)) {
+    if (!['status', 'theme-mode', 'i18nextLng'].includes(key))
+      localStorage.removeItem(key);
+  }
+  updateAPI();
+}
+
+// 返回路径仅允许本站普通路径，不能把回调、恢复或凭据页变成重定向循环。
+export function safeUnifiedReturn(path) {
+  if (
+    typeof path !== 'string' ||
+    !path.startsWith('/') ||
+    path.startsWith('//') ||
+    path.includes('\\')
+  )
+    return '/';
+  const target = new URL(path, window.location.origin);
+  if (
+    target.origin !== window.location.origin ||
+    /^\/(?:oauth|root-recovery|login|register|reset)(?:\/|$)/.test(
+      target.pathname,
+    )
+  )
+    return '/';
+  return `${target.pathname}${target.search}${target.hash}`;
+}
+
+// 复用原 RP 的一次性 S256 PKCE；服务端清本地会话，不触发主站退出或账号绑定。
+export async function startMainUnifiedLogin(returnTo = '/', explicit = false) {
+  sessionStorage.setItem(RETURN_KEY, safeUnifiedReturn(returnTo));
+  if (explicit) sessionStorage.removeItem('pl-unified-attempt');
+  clearUnifiedPrivateCache();
+  const response = await API.post('/api/oauth/pingxingxian/start');
+  const url = response.data?.data?.authorization_url;
+  const target = url && new URL(url);
+  if (
+    !response.data?.success ||
+    !target ||
+    target.origin !== MAIN_ORIGIN ||
+    target.pathname !== '/auth/oidc/auth'
+  )
+    throw new Error('主站统一登录暂不可用，请重试');
+  window.location.assign(target.href);
+}
+
+// 退出票据只能回固定 Main；true 表示已重定向或已报告失败，调用方不可继续本地成功流程。
+export async function logoutUnifiedOrNative() {
+  try {
+    const response = await API.get('/api/user/logout', {
+      skipErrorHandler: true,
+    });
+    if (!response.data?.success)
+      throw new Error(response.data?.message || '退出失败');
+    sessionStorage.removeItem('pl-root-recovery');
+    const url = response.data?.data?.logout_url;
+    if (!url) return false;
+    const target = new URL(url);
+    if (
+      target.origin !== MAIN_ORIGIN ||
+      target.pathname !== '/auth/unified/logout'
+    )
+      throw new Error('主站退出地址无效');
+    clearUnifiedPrivateCache();
+    window.location.assign(target.href);
+    return true;
+  } catch (error) {
+    // 已显示真实错误，调用方停止本地成功提示和跳转，不能伪报跨站退出。
+    showError(error);
+    return true;
+  }
+}
