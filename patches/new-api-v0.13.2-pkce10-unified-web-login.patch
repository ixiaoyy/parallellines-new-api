+package oauth
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+const MainWebProofKey = "main_web_handle"
+
+var ErrMainWebInactive = errors.New("Main browser session is inactive")
+var ErrMainWebUnavailable = errors.New("Main browser session authority is unavailable")
+
+// MainUnifiedWebEnabled 默认关闭；只约束浏览器登录，不改变普通 API key 或 Chat relay。
+func MainUnifiedWebEnabled() bool { return os.Getenv("MAIN_UNIFIED_WEB_LOGIN_ENABLED") == "true" }
+
+// MainWebProof 仅在单实例服务内保存，不把主站绑定或访问令牌写入浏览器 cookie。
+type MainWebProof struct {
+	UserID   int
+	Subject  string
+	Binding  string
+	Expires  int64
+	Recovery bool
+}
+
+var mainWebProofs = struct {
+	sync.Mutex
+	entries map[string]MainWebProof
+}{entries: make(map[string]MainWebProof)}
+
+// SaveMainWebProof 返回随机浏览器句柄；过期清理后最多保留一万个会话，容量满时明确失败。
+func SaveMainWebProof(proof MainWebProof) (string, error) {
+	now := time.Now().Unix()
+	if proof.UserID <= 0 || proof.Expires <= now || (!proof.Recovery && (proof.Subject == "" || proof.Binding == "")) {
+		return "", ErrMainWebInactive
+	}
+	raw := make([]byte, 32)
+	if _, err := rand.Read(raw); err != nil {
+		return "", err
+	}
+	handle := hex.EncodeToString(raw)
+	mainWebProofs.Lock()
+	defer mainWebProofs.Unlock()
+	for key, value := range mainWebProofs.entries {
+		if value.Expires <= now {
+			delete(mainWebProofs.entries, key)
+		}
+	}
+	if len(mainWebProofs.entries) >= 10000 {
+		return "", ErrMainWebUnavailable
+	}
+	mainWebProofs.entries[handle] = proof
+	return handle, nil
+}
+
+// LoadMainWebProof 只读取有效句柄；重启丢失证明后必须重新走原有 Main OIDC。
+func LoadMainWebProof(handle string) (MainWebProof, error) {
+	mainWebProofs.Lock()
+	defer mainWebProofs.Unlock()
+	proof, ok := mainWebProofs.entries[handle]
+	if !ok || len(handle) != 64 || proof.Expires <= time.Now().Unix() {
+		delete(mainWebProofs.entries, handle)
+		return MainWebProof{}, ErrMainWebInactive
+	}
+	return proof, nil
+}
+
+// DeleteMainWebProof 仅移除本 RP 的内存证明；不向主站发送撤销或退出。
+func DeleteMainWebProof(handle string) {
+	mainWebProofs.Lock()
+	delete(mainWebProofs.entries, handle)
+	mainWebProofs.Unlock()
+}
+
+// MainRootRecoveryEnabled 显式启用应急入口，默认关闭。
+func MainRootRecoveryEnabled() bool { return os.Getenv("MAIN_WEB_ROOT_RECOVERY_ENABLED") == "true" }
+
+// MainRecoveryHost 只接受原始 Host 的回环名字；不采信 X-Forwarded-For/Host，仍须外层私有监听及公开代理拒绝。
+func MainRecoveryHost(host string) bool {
+	if h, _, err := net.SplitHostPort(host); err == nil {
+		host = h
+	}
+	host = strings.ToLower(strings.Trim(host, "[]"))
+	return host == "localhost" || host == "127.0.0.1" || host == "::1"
+}
+
+// MainRecoveryUser 要求显式正 UID 白名单（最多十六个）及真实 Root 角色；配置非法时全部拒绝。
+func MainRecoveryUser(id, role int) bool {
+	if !MainRootRecoveryEnabled() || id <= 0 || role != 100 {
+		return false
+	}
+	parts := strings.Split(os.Getenv("MAIN_WEB_ROOT_RECOVERY_USER_IDS"), ",")
+	if len(parts) > 16 {
+		return false
+	}
+	found := false
+	for _, part := range parts {
+		n, err := strconv.Atoi(strings.TrimSpace(part))
+		if err != nil || n <= 0 {
+			return false
+		}
+		if n == id {
+			found = true
+		}
+	}
+	return found
+}
+
+type mainWebState struct {
+	Active    bool   `json:"active"`
+	Subject   string `json:"sub"`
+	Binding   string `json:"binding_id"`
+	Expires   int64  `json:"auth_expires_at"`
+	Unified   bool   `json:"unified_browser"`
+	LogoutURL string `json:"logout_url"`
+	ExpiresIn int    `json:"expires_in"`
+}
+
+var mainWebClient = &http.Client{
+	Timeout:       5 * time.Second,
+	Transport:     &http.Transport{Proxy: http.ProxyFromEnvironment, DialContext: (&net.Dialer{Timeout: 2 * time.Second, KeepAlive: 30 * time.Second}).DialContext, TLSHandshakeTimeout: 2 * time.Second, ResponseHeaderTimeout: 3 * time.Second, MaxIdleConns: 16, MaxIdleConnsPerHost: 8, IdleConnTimeout: 30 * time.Second},
+	CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+}
+
+// requestMainWeb 仅调用固定发行方、原 RP Basic 凭据；无重试、无重定向，响应上限 16KiB。
+func requestMainWeb(ctx context.Context, proof MainWebProof, path string) (mainWebState, error) {
+	provider, ok := GetProvider("pingxingxian").(*GenericOAuthProvider)
+	if !ok {
+		return mainWebState{}, ErrMainWebUnavailable
+	}
+	provider = provider.Snapshot()
+	if provider.ValidateMainProfileConfiguration() != nil || provider.config.ClientSecret == "" {
+		return mainWebState{}, ErrMainWebUnavailable
+	}
+	payload, _ := json.Marshal(map[string]string{"binding_id": proof.Binding, "subject": proof.Subject})
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, mainProfileIssuer+path, bytes.NewReader(payload))
+	if err != nil {
+		return mainWebState{}, ErrMainWebUnavailable
+	}
+	req.SetBasicAuth(provider.config.ClientId, provider.config.ClientSecret)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	res, err := mainWebClient.Do(req)
+	if err != nil {
+		return mainWebState{}, ErrMainWebUnavailable
+	}
+	defer res.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(res.Body, 16385))
+	if err != nil || len(body) > 16384 || res.StatusCode != 200 {
+		return mainWebState{}, ErrMainWebUnavailable
+	}
+	var state mainWebState
+	var required struct {
+		Active *bool `json:"active"`
+	}
+	if json.Unmarshal(body, &required) != nil || required.Active == nil {
+		return state, ErrMainWebUnavailable
+	}
+	if json.Unmarshal(body, &state) != nil {
+		return state, ErrMainWebUnavailable
+	}
+	if !state.Active {
+		return state, ErrMainWebInactive
+	}
+	return state, nil
+}
+
+// CheckMainWebProof 每个私有 Web 请求实时复核，不缓存主站正向存活结果。
+func CheckMainWebProof(ctx context.Context, proof MainWebProof) error {
+	state, err := requestMainWeb(ctx, proof, "/main-session-state")
+	if err != nil {
+		return err
+	}
+	if !state.Unified || state.Subject != proof.Subject || state.Binding != proof.Binding || state.Expires <= time.Now().Unix() || state.Expires != proof.Expires {
+		return ErrMainWebInactive
+	}
+	return nil
+}
+
+// MainWebLogoutURL 换取一次性同浏览器退出票据；不持有或撤销其他设备会话。
+func MainWebLogoutURL(ctx context.Context, proof MainWebProof) (string, error) {
+	state, err := requestMainWeb(ctx, proof, "/unified-logout-ticket")
+	if err != nil {
+		return "", err
+	}
+	u, parseErr := url.Parse(state.LogoutURL)
+	if parseErr != nil || u.Scheme != "https" || u.Host != "pingxingxian.space" || u.User != nil || u.Fragment != "" || u.Path != "/auth/unified/logout" || len(u.Query()) != 1 || len(u.Query()["ticket"]) != 1 || u.Query().Get("ticket") == "" || state.ExpiresIn <= 0 || state.ExpiresIn > 60 {
+		return "", ErrMainWebUnavailable
+	}
+	return u.String(), nil
+}
