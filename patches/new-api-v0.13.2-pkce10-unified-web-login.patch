+import React, { useState } from 'react';
+import { useLocation } from 'react-router-dom';
+import { Button } from '@douyinfe/semi-ui';
+import { MAIN_ORIGIN, startMainUnifiedLogin } from '../../helpers/unified-web';
+
+// 公开入口保留返回首页；登录、注册、找回统一交由主站，不展示第二套密码框。
+export default function MainUnifiedLogin() {
+  const location = useLocation();
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const login = async () => {
+    setBusy(true);
+    setError('');
+    try {
+      await startMainUnifiedLogin(location.state?.from?.pathname || '/', true);
+    } catch (e) {
+      setError(e.message);
+      setBusy(false);
+    }
+  };
+  return (
+    <section
+      style={{
+        width: 'calc(100% - 32px)',
+        maxWidth: 480,
+        margin: '112px auto 48px',
+        padding: 32,
+        border: '1px solid var(--semi-color-border)',
+        borderRadius: 16,
+        background: 'var(--semi-color-bg-1)',
+        boxShadow: '0 8px 32px rgba(0,0,0,0.04)',
+      }}
+    >
+      <h1 style={{ fontSize: 26, fontWeight: 600, marginBottom: 16 }}>登录</h1>
+      <Button
+        htmlType='button'
+        type='primary'
+        theme='solid'
+        size='large'
+        block
+        disabled={busy}
+        onClick={login}
+      >
+        {busy ? '正在登录…' : '使用平行线账号登录'}
+      </Button>
+      <p style={{ marginTop: 20, fontSize: 14, lineHeight: 1.8 }}>
+        <a href={`${MAIN_ORIGIN}/auth?mode=register`}>注册账号</a> ·{' '}
+        <a href={`${MAIN_ORIGIN}/auth?mode=forgot`}>忘记密码</a> ·{' '}
+        <a href='/'>返回首页</a>
+      </p>
+      {error && <p role='alert'>{error}</p>}
+    </section>
+  );
+}
