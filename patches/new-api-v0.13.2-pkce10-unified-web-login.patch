+package middleware
+
+import (
+	"github.com/QuantumNous/new-api/oauth"
+	"github.com/gin-gonic/gin"
+	"strings"
+)
+
+// MainPublicCredentialBoundary 保持匿名公开页面；仅阻断会创建第二套凭据的公开 API，默认关闭兼容旧模式。
+func MainPublicCredentialBoundary() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		path := c.Request.URL.Path
+		if strings.HasPrefix(path, "/api/user/root-recovery") {
+			if !oauth.MainRecoveryHost(c.Request.Host) {
+				c.AbortWithStatus(404)
+				return
+			}
+			c.Next()
+			return
+		}
+		if !oauth.MainUnifiedWebEnabled() {
+			c.Next()
+			return
+		}
+		blocked := path == "/api/verification" || path == "/api/reset_password" || path == "/api/user/reset" || path == "/api/user/register" || path == "/api/setup" && c.Request.Method == "POST" || path == "/api/user/login" || strings.HasPrefix(path, "/api/user/login/") || strings.HasPrefix(path, "/api/user/passkey/login/")
+		if strings.HasPrefix(path, "/api/oauth/") && path != "/api/oauth/pingxingxian" && path != "/api/oauth/pingxingxian/start" {
+			blocked = true
+		}
+		if blocked {
+			c.AbortWithStatusJSON(403, gin.H{"success": false, "message": "请前往主站管理登录、注册和密码", "login_url": "https://pingxingxian.space/auth"})
+			return
+		}
+		c.Next()
+	}
+}
+
+// MainRecoveryWebBoundary 补充应用层 Host 检查；公开反向代理仍必须无条件拒绝整个恢复路径树。
+func MainRecoveryWebBoundary() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if strings.HasPrefix(c.Request.URL.Path, "/root-recovery") && !oauth.MainRecoveryHost(c.Request.Host) {
+			c.AbortWithStatus(404)
+			return
+		}
+		c.Next()
+	}
+}
