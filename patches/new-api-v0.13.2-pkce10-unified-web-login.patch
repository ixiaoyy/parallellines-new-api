+package controller
+
+import (
+	"errors"
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/oauth"
+	"github.com/gin-contrib/sessions"
+	"github.com/gin-gonic/gin"
+	"net/http"
+)
+
+// rejectMainCredentials 统一模式下所有公开凭据入口仅指向 Main，不对 Root 开例外。
+func rejectMainCredentials(c *gin.Context) {
+	c.AbortWithStatusJSON(403, gin.H{"success": false, "message": "请前往主站管理登录、注册和密码", "login_url": "https://pingxingxian.space/auth"})
+}
+
+// MainUnifiedLocalClear 只清当前 RP 的 cookie/证明；用于匿名化与换号，不能撤销主站或其他设备。
+func MainUnifiedLocalClear(c *gin.Context) {
+	if !oauth.MainUnifiedWebEnabled() {
+		c.AbortWithStatus(404)
+		return
+	}
+	if err := clearMainWebSession(c); err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	common.ApiSuccess(c, nil)
+}
+
+// clearMainWebSession 销毁当前浏览器 RP cookie/证明；保存失败由调用方明确返回。
+func clearMainWebSession(c *gin.Context) error {
+	session := sessions.Default(c)
+	handle, _ := session.Get(oauth.MainWebProofKey).(string)
+	oauth.DeleteMainWebProof(handle)
+	session.Clear()
+	return session.Save()
+}
+
+// MainUnifiedState 由 TryUserAuth 先完成实时主站及本地账号校验；只返回 UI 匹配所需的主体。
+func MainUnifiedState(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	if !oauth.MainUnifiedWebEnabled() {
+		c.AbortWithStatus(404)
+		return
+	}
+	session := sessions.Default(c)
+	handle, _ := session.Get(oauth.MainWebProofKey).(string)
+	proof, err := oauth.LoadMainWebProof(handle)
+	if err != nil || session.Get("id") != proof.UserID {
+		common.ApiSuccess(c, gin.H{"authenticated": false})
+		return
+	}
+	common.ApiSuccess(c, gin.H{"authenticated": true, "subject": proof.Subject, "recovery": proof.Recovery})
+}
+
+// MainUnifiedLogout 先换票再清 RP；发行方不可用明确失败，不能伪报已退出所有站点。
+func MainUnifiedLogout(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	session := sessions.Default(c)
+	handle, _ := session.Get(oauth.MainWebProofKey).(string)
+	proof, err := oauth.LoadMainWebProof(handle)
+	// 重启或旧 cookie 缺少证明时不能伪报跨站退出；先回 Main 重接再取得同浏览器票据。
+	if err != nil && (session.Get("id") != nil || c.GetHeader("New-Api-User") != "" && c.GetHeader("New-Api-User") != "0") {
+		c.AbortWithStatusJSON(401, gin.H{"success": false, "message": "登录已过期，请刷新后重试"})
+		return
+	}
+	logoutURL := ""
+	if err == nil && !proof.Recovery {
+		if session.Get("id") != proof.UserID {
+			c.AbortWithStatus(401)
+			return
+		}
+		logoutURL, err = oauth.MainWebLogoutURL(c.Request.Context(), proof)
+		if err != nil && !errors.Is(err, oauth.ErrMainWebInactive) {
+			c.AbortWithStatusJSON(503, gin.H{"success": false, "message": "主站退出暂不可用，请稍后重试"})
+			return
+		}
+	}
+	if err := clearMainWebSession(c); err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	common.ApiSuccess(c, gin.H{"logout_url": logoutURL})
+}
+
+// MainRootRecovery 只在显式开关和回环 Host 上复用原生密码/MFA，不向公开登录入口添加豁免。
+func MainRootRecovery(twoFA bool) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if !oauth.MainRootRecoveryEnabled() || !oauth.MainRecoveryHost(c.Request.Host) {
+			c.AbortWithStatus(http.StatusNotFound)
+			return
+		}
+		c.Set("main_root_recovery", true)
+		if twoFA {
+			Verify2FALogin(c)
+		} else {
+			Login(c)
+		}
+	}
+}
