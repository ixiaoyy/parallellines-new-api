+import React, { useContext, useState } from 'react';
+import { Button, Input } from '@douyinfe/semi-ui';
+import { API, updateAPI } from '../../helpers/api';
+import { UserContext } from '../../context/User';
+
+// 专用应急页没有公开导航；必须经私有回环监听/隧道，服务端还会核开关、UID、Root 与原 MFA。
+export default function MainRootRecovery() {
+  const [, dispatch] = useContext(UserContext);
+  const [username, setUsername] = useState(''),
+    [password, setPassword] = useState(''),
+    [code, setCode] = useState('');
+  const [twoFA, setTwoFA] = useState(false),
+    [error, setError] = useState(''),
+    [busy, setBusy] = useState(false);
+  const local = ['localhost', '127.0.0.1', '[::1]'].includes(
+    window.location.hostname,
+  );
+  const submit = async (event) => {
+    event.preventDefault();
+    setBusy(true);
+    setError('');
+    try {
+      const response = await API.post(
+        `/api/user/root-recovery/${twoFA ? '2fa' : 'login'}`,
+        twoFA ? { code } : { username, password },
+      );
+      if (!response.data?.success)
+        throw new Error(response.data?.message || '恢复登录失败');
+      if (response.data.data?.require_2fa) {
+        setTwoFA(true);
+        setPassword('');
+        return;
+      }
+      localStorage.setItem('user', JSON.stringify(response.data.data));
+      dispatch({ type: 'login', payload: response.data.data });
+      updateAPI();
+      // 保持在同一私有 Host；恢复模式不会触发主站自动登录或跨站退出。
+      sessionStorage.setItem('pl-root-recovery', 'true');
+      window.location.assign('/console');
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setBusy(false);
+    }
+  };
+  if (!local) return <p>此页面不可用。</p>;
+  return (
+    <section
+      style={{
+        width: 'calc(100% - 32px)',
+        maxWidth: 480,
+        margin: '112px auto 48px',
+        padding: 32,
+        border: '1px solid var(--semi-color-border)',
+        borderRadius: 16,
+        background: 'var(--semi-color-bg-1)',
+      }}
+    >
+      <h1 style={{ fontSize: 26, fontWeight: 600, marginBottom: 24 }}>
+        管理员登录
+      </h1>
+
+      <form onSubmit={submit}>
+        {twoFA ? (
+          <label style={{ display: 'block', marginBottom: 16 }}>
+            验证码或备用码
+            <Input
+              value={code}
+              onChange={setCode}
+              autoComplete='one-time-code'
+              required
+            />
+          </label>
+        ) : (
+          <>
+            <label style={{ display: 'block', marginBottom: 16 }}>
+              账号
+              <Input
+                value={username}
+                onChange={setUsername}
+                autoComplete='username'
+                required
+              />
+            </label>
+            <label style={{ display: 'block', marginBottom: 16 }}>
+              密码
+              <Input
+                type='password'
+                value={password}
+                onChange={setPassword}
+                autoComplete='current-password'
+                required
+              />
+            </label>
+          </>
+        )}
+        <Button
+          htmlType='submit'
+          type='primary'
+          theme='solid'
+          size='large'
+          block
+          disabled={busy}
+        >
+          {busy ? '验证中…' : '登录'}
+        </Button>
+      </form>
+      {error && <p role='alert'>{error}</p>}
+    </section>
+  );
+}
