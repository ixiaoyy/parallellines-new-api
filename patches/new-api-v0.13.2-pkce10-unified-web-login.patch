+import React, { useContext, useEffect, useRef, useState } from 'react';
+import { useLocation } from 'react-router-dom';
+import { StatusContext } from '../../context/Status';
+import { UserContext } from '../../context/User';
+import { API } from '../../helpers/api';
+import {
+  MAIN_ORIGIN,
+  clearUnifiedPrivateCache,
+  startMainUnifiedLogin,
+} from '../../helpers/unified-web';
+
+// Main iframe 只传 UI 状态，不传令牌；所有私有 API 仍由后端实时复核原绑定。
+export default function MainUnifiedBoundary({ children }) {
+  const [statusState] = useContext(StatusContext);
+  const [, dispatch] = useContext(UserContext);
+  const location = useLocation();
+  const locationRef = useRef(location);
+  locationRef.current = location;
+  const frame = useRef(null);
+  const [requestId] = useState(() =>
+    Array.from(crypto.getRandomValues(new Uint8Array(16)), (b) =>
+      b.toString(16).padStart(2, '0'),
+    ).join(''),
+  );
+  const [ready, setReady] = useState(false);
+  const [error, setError] = useState('');
+  const enabled = statusState?.status?.main_unified_web_login_enabled === true;
+  const recovery =
+    ['localhost', '127.0.0.1', '[::1]'].includes(window.location.hostname) &&
+    sessionStorage.getItem('pl-root-recovery') === 'true';
+  const bypass =
+    recovery || /^\/(?:oauth|root-recovery)(?:\/|$)/.test(location.pathname);
+  const privatePage =
+    location.pathname.startsWith('/console') ||
+    location.pathname === '/chat2link';
+
+  useEffect(() => {
+    if (!enabled || bypass) return;
+    let closed = false,
+      sequence = 0,
+      working = false,
+      pendingEvent = null,
+      received = false;
+    const accept = async (event) => {
+      const data = event.data;
+      if (
+        event.origin !== MAIN_ORIGIN ||
+        event.source !== frame.current?.contentWindow ||
+        data?.type !== 'pl:unified-session' ||
+        data.version !== 1 ||
+        data.request_id !== requestId ||
+        typeof data.available !== 'boolean'
+      )
+        return;
+      received = true;
+      if (!data.available) {
+        sequence++;
+        setReady(false);
+        setError('暂时无法确认登录状态，请稍后重试。');
+        return;
+      }
+      if (
+        typeof data.authenticated !== 'boolean' ||
+        (data.authenticated &&
+          (typeof data.subject !== 'string' ||
+            !data.subject ||
+            typeof data.auth_epoch !== 'string' ||
+            !/^[-_A-Za-z0-9]{32,128}$/.test(data.auth_epoch)))
+      )
+        return;
+      const own = ++sequence;
+      setReady(false);
+      if (working) {
+        pendingEvent = event;
+        return;
+      }
+      working = true;
+      try {
+        if (!data.authenticated) {
+          await API.post('/api/user/unified/local-clear');
+          if (closed || own !== sequence) return;
+          clearUnifiedPrivateCache();
+          dispatch({ type: 'logout' });
+          sessionStorage.removeItem('pl-unified-attempt');
+          sessionStorage.removeItem('pl-unified-epoch');
+          setError('');
+          setReady(true);
+          return;
+        }
+        const response = await API.get('/api/user/unified/state', {
+          disableDuplicate: true,
+          skipErrorHandler: true,
+        });
+        if (closed || own !== sequence) return;
+        const local = response.data?.data;
+        const epoch = sessionStorage.getItem('pl-unified-epoch');
+        if (
+          response.data?.success &&
+          local?.authenticated &&
+          local.subject === data.subject &&
+          (!epoch || epoch === data.auth_epoch) &&
+          localStorage.getItem('user')
+        ) {
+          sessionStorage.setItem('pl-unified-epoch', data.auth_epoch);
+          sessionStorage.removeItem('pl-unified-attempt');
+          setError('');
+          setReady(true);
+          return;
+        }
+        // 主体或浏览器登录代次不同，先销毁旧账号状态，再完整重走原 OIDC；不借旧身份静默恢复。
+        clearUnifiedPrivateCache();
+        dispatch({ type: 'logout' });
+        const attempt = JSON.stringify([data.subject, data.auth_epoch]);
+        if (sessionStorage.getItem('pl-unified-attempt') === attempt) {
+          setError('登录未完成，请重试。');
+          return;
+        }
+        sessionStorage.setItem('pl-unified-attempt', attempt);
+        sessionStorage.setItem('pl-unified-epoch', data.auth_epoch);
+        const here = locationRef.current;
+        await startMainUnifiedLogin(
+          `${here.pathname}${here.search}${here.hash}`,
+        );
+      } catch (e) {
+        if (!closed) setError('暂时无法确认登录状态，请稍后重试。');
+      } finally {
