+package router
+
+import (
+	"github.com/QuantumNous/new-api/controller"
+	"github.com/QuantumNous/new-api/middleware"
+	"github.com/gin-gonic/gin"
+)
+
+// setTavernFluxAPIRouter 单独挂载明确用途的 Synapse 与人类入口，不扩展现有 Chat OAuth。
+func setTavernFluxAPIRouter(api *gin.RouterGroup) {
+	flux := api.Group("/tavern-flux", controller.TavernFluxAvailable())
+	issuer := flux.Group("/intents", controller.TavernFluxServiceAuth(true))
+	issuer.POST("", controller.CreateTavernFluxIntent)
+	issuer.GET("/:id", controller.GetTavernFluxIntent)
+	issuer.POST("/:id/activate", controller.ActivateTavernFluxIntent)
+	owner := flux.Group("", middleware.UserAuth())
+	owner.GET("/confirm/:id", controller.GetTavernFluxConfirmation)
+	owner.POST("/confirm/:id", controller.ConfirmTavernFluxIntent)
+	owner.GET("/rooms", controller.ListTavernFluxRooms)
+	owner.DELETE("/rooms/:id", controller.RevokeTavernFluxRoom)
+}
+
+// setTavernFluxRelayRouter 避免把服务请求递给普通 /v1 或 Chat 路由。
+func setTavernFluxRelayRouter(router *gin.Engine) {
+	flux := router.Group("/tavern-flux/v1", controller.TavernFluxAvailable(), controller.TavernFluxServiceAuth(false))
+	flux.POST("/chat/completions", controller.TavernFluxChatCompletion)
+}
