diff --git a/controller/tavern_flux.go b/controller/tavern_flux.go
new file mode 100644
--- /dev/null
+++ b/controller/tavern_flux.go
@@ -0,0 +1,338 @@
+package controller
+
+import (
+	"crypto/subtle"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"regexp"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+const fluxMatrixServer = "matrix.pingxingxian.space"
+
+var (
+	fluxIntentID = regexp.MustCompile(`^[a-f0-9]{64}$`)
+	fluxRoomID   = regexp.MustCompile(`^![A-Za-z0-9_~.+/=:-]{1,254}$`)
+	fluxEventID  = regexp.MustCompile(`^\$[A-Za-z0-9_~.+/=:-]{1,254}$`)
+	fluxSubject  = regexp.MustCompile(`^[0-9]{1,128}$`)
+	fluxModelID  = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9/._:-]{0,127}$`)
+)
+
+type fluxIntentInput struct {
+	RoomID      string `json:"room_id"`
+	InviterMXID string `json:"inviter_mxid"`
+	Subject     string `json:"subject"`
+	RoomLabel   string `json:"room_label"`
+}
+
+type fluxActivationInput struct {
+	RoomID        string `json:"room_id"`
+	InviterMXID   string `json:"inviter_mxid"`
+	InviteEventID string `json:"invite_event_id"`
+}
+
+type fluxConfirmInput struct {
+	QuotaLimit int64 `json:"quota_limit"`
+}
+
+func fluxNow() int64 { return time.Now().Unix() }
+
+func fluxError(c *gin.Context, status int, code string) {
+	c.Header("Cache-Control", "no-store")
+	c.AbortWithStatusJSON(status, gin.H{"error": code})
+}
+
+func fluxResult(c *gin.Context, s int, value any) {
+	c.Header("Cache-Control", "no-store")
+	c.JSON(s, value)
+}
+
+// TavernFluxAvailable 默认关闭本功能；配置未就绪时不接受邀请或扣费授权。与 Chat OAuth 无关。
+func TavernFluxAvailable() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if os.Getenv("TAVERN_FLUX_ENABLED") != "true" {
+			fluxError(c, http.StatusNotFound, "flux_disabled")
+			return
+		}
+		issuer, bot := os.Getenv("TAVERN_FLUX_ISSUER_BEARER"), os.Getenv("TAVERN_FLUX_BOT_BEARER")
+		if len(issuer) < 32 || len(issuer) > 256 || len(bot) < 32 || len(bot) > 256 || issuer == bot ||
+			!fluxModelID.MatchString(os.Getenv("TAVERN_FLUX_MODEL_ID")) {
+			fluxError(c, http.StatusServiceUnavailable, "flux_configuration_unavailable")
+			return
+		}
+		c.Next()
+	}
+}
+
+// TavernFluxServiceAuth 给 Synapse 与 Bot 各自固定用途的服务授权；不接受个人或 Chat 凭据。
+func TavernFluxServiceAuth(issuer bool) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		key := "TAVERN_FLUX_BOT_BEARER"
+		if issuer {
+			key = "TAVERN_FLUX_ISSUER_BEARER"
+		}
+		expected := os.Getenv(key)
+		headers := c.Request.Header.Values("Authorization")
+		if len(expected) < 32 || len(headers) != 1 || !strings.HasPrefix(headers[0], "Bearer ") ||
+			subtle.ConstantTimeCompare([]byte(headers[0][7:]), []byte(expected)) != 1 {
+			fluxError(c, http.StatusUnauthorized, "flux_invalid_service_credential")
+			return
+		}
+		c.Next()
+	}
+}
+
+func fluxDecode(c *gin.Context, body any) bool {
+	if c.ContentType() != "application/json" {
+		fluxError(c, http.StatusUnsupportedMediaType, "flux_json_required")
+		return false
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(c.Writer, c.Request.Body, 8*1024))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(body); err != nil || decoder.Decode(new(any)) != io.EOF {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_input")
+		return false
+	}
+	return true
+}
+
+func fluxStoreError(c *gin.Context, err error) {
+	switch {
+	case errors.Is(err, gorm.ErrRecordNotFound):
+		fluxError(c, http.StatusNotFound, "flux_authorization_not_found")
+	case errors.Is(err, model.ErrFluxForbidden):
+		fluxError(c, http.StatusForbidden, "flux_authorization_denied")
+	case errors.Is(err, model.ErrFluxConflict), errors.Is(err, model.ErrFluxInvalid), errors.Is(err, model.ErrFluxDuplicate):
+		fluxError(c, http.StatusConflict, err.Error())
+	case errors.Is(err, model.ErrFluxQuota):
+		fluxError(c, http.StatusPaymentRequired, "flux_room_budget_exhausted")
+	default:
+		// 不把邀请、内部参数、余额或数据库错误正文返回给客户端。
+		fluxError(c, http.StatusServiceUnavailable, "flux_authority_unavailable")
+	}
+}
+
+func fluxGrantJSON(g *model.TavernFluxGrant) gin.H {
+	expiresAt := g.IntentExpiresAt
+	if g.GrantExpiresAt > 0 && (g.Status == model.TavernFluxActive || g.Status == model.TavernFluxConfirmed) {
+		expiresAt = g.GrantExpiresAt
+	}
+	return gin.H{"intent_id": g.ID, "room_id": g.RoomID, "room_label": g.RoomLabel, "inviter_mxid": g.InviterMXID,
+		"status": g.Status, "model_id": g.ModelID, "quota_limit": g.QuotaLimit, "quota_max": model.TavernFluxMaxQuota,
+		"quota_spent": g.QuotaSpent, "quota_reserved": g.QuotaReserved, "quota_unit": "native",
+		"quota_per_unit": common.QuotaPerUnit, "grant_duration_seconds": model.TavernFluxGrantTTL,
+		"intent_expires_at": g.IntentExpiresAt, "expires_at": expiresAt}
+}
+
+func fluxUserGrant(c *gin.Context) (*model.TavernFluxGrant, int, bool) {
+	if c.GetBool("use_access_token") || c.GetInt("id") <= 0 {
+		fluxError(c, http.StatusUnauthorized, "flux_browser_login_required")
+		return nil, 0, false
+	}
+	id := c.Param("id")
+	if !fluxIntentID.MatchString(id) {
+		fluxError(c, http.StatusNotFound, "flux_authorization_not_found")
+		return nil, 0, false
+	}
+	grant, err := model.GetTavernFluxGrant(model.DB, id, fluxNow())
+	if err != nil {
+		fluxStoreError(c, err)
+		return nil, 0, false
+	}
+	payer, err := model.ResolveTavernFluxPayer(grant.Subject)
+	if err != nil {
+		fluxStoreError(c, err)
+		return nil, 0, false
+	}
+	if payer != c.GetInt("id") || grant.PayerID != 0 && grant.PayerID != payer {
+		fluxError(c, http.StatusForbidden, "flux_authorization_denied")
+		return nil, 0, false
+	}
+	return grant, payer, true
+}
+
+// CreateTavernFluxIntent 由 Synapse 固定发行方发起；当前主站标识必须对应原生 Matrix 发起人。
+func CreateTavernFluxIntent(c *gin.Context) {
+	var body fluxIntentInput
+	if !fluxDecode(c, &body) {
+		return
+	}
+	label := strings.TrimSpace(body.RoomLabel)
+	if !fluxRoomID.MatchString(body.RoomID) || !fluxSubject.MatchString(body.Subject) ||
+		body.InviterMXID != "@pl_"+body.Subject+":"+fluxMatrixServer || !utf8.ValidString(label) ||
+		len(label) > 128 || strings.IndexFunc(label, unicode.IsControl) >= 0 {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_intent")
+		return
+	}
+	grant, err := model.CreateTavernFluxIntent(model.DB, body.RoomID, body.InviterMXID, body.Subject, label,
+		os.Getenv("TAVERN_FLUX_MODEL_ID"), fluxNow())
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	fluxResult(c, http.StatusCreated, gin.H{"intent_id": grant.ID, "status": grant.Status})
+}
+
+// GetTavernFluxIntent 给受信 Synapse 发行方返回确认状态，不返回用户余额或凭据。
+func GetTavernFluxIntent(c *gin.Context) {
+	id := c.Param("id")
+	if !fluxIntentID.MatchString(id) {
+		fluxError(c, http.StatusNotFound, "flux_authorization_not_found")
+		return
+	}
+	grant, err := model.GetTavernFluxGrant(model.DB, id, fluxNow())
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	fluxResult(c, http.StatusOK, gin.H{"intent_id": grant.ID, "status": grant.Status, "room_id": grant.RoomID,
+		"inviter_mxid": grant.InviterMXID, "invite_event_id": grant.InvitationEventID(), "subject": grant.Subject})
+}
+
+// GetTavernFluxConfirmation 只向匹配当前受信主站绑定的登录人显示本次邀请和预算单位。
+func GetTavernFluxConfirmation(c *gin.Context) {
+	grant, _, ok := fluxUserGrant(c)
+	if ok {
+		fluxResult(c, http.StatusOK, fluxGrantJSON(grant))
+	}
+}
+
+// ConfirmTavernFluxIntent 仅登录本人明确提交额度后写入确认状态；不会加入房间或提前产生费用。
+func ConfirmTavernFluxIntent(c *gin.Context) {
+	grant, payer, ok := fluxUserGrant(c)
+	if !ok {
+		return
+	}
+	var body fluxConfirmInput
+	if !fluxDecode(c, &body) {
+		return
+	}
+	if body.QuotaLimit < 1 || body.QuotaLimit > model.TavernFluxMaxQuota {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_quota_limit")
+		return
+	}
+	if grant.ModelID != os.Getenv("TAVERN_FLUX_MODEL_ID") {
+		fluxError(c, http.StatusConflict, "flux_model_changed")
+		return
+	}
+	grant, err := model.ConfirmTavernFluxIntent(model.DB, grant.ID, payer, body.QuotaLimit, fluxNow())
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	fluxResult(c, http.StatusOK, fluxGrantJSON(grant))
+}
+
+// ActivateTavernFluxIntent 只接受 Synapse 核实后的实际邀请事件，生效时复核付款人绑定。
+func ActivateTavernFluxIntent(c *gin.Context) {
+	id := c.Param("id")
+	if !fluxIntentID.MatchString(id) {
+		fluxError(c, http.StatusNotFound, "flux_authorization_not_found")
+		return
+	}
+	var body fluxActivationInput
+	if !fluxDecode(c, &body) {
+		return
+	}
+	if !fluxRoomID.MatchString(body.RoomID) || !fluxEventID.MatchString(body.InviteEventID) {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_invitation_event")
+		return
+	}
+	grant, err := model.GetTavernFluxGrant(model.DB, id, fluxNow())
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	if grant.ModelID != os.Getenv("TAVERN_FLUX_MODEL_ID") {
+		fluxError(c, http.StatusConflict, "flux_model_changed")
+		return
+	}
+	payer, err := model.ResolveTavernFluxPayer(grant.Subject)
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	grant, err = model.ActivateTavernFluxIntent(model.DB, id, body.RoomID, body.InviterMXID, body.InviteEventID, payer, fluxNow())
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	fluxResult(c, http.StatusOK, fluxGrantJSON(grant))
+}
+
+// ListTavernFluxRooms 只列付款人当前有效的确认/授权，提供用户能实际操作的撤销入口。
+func ListTavernFluxRooms(c *gin.Context) {
+	payer := c.GetInt("id")
+	if c.GetBool("use_access_token") || payer <= 0 {
+		fluxError(c, http.StatusUnauthorized, "flux_browser_login_required")
+		return
+	}
+	var grants []model.TavernFluxGrant
+	now := fluxNow()
+	err := model.DB.Where("payer_id = ?", payer).Where("(status = ? AND grant_expires_at > ?) OR (status = ? AND intent_expires_at > ?)",
+		model.TavernFluxActive, now, model.TavernFluxConfirmed, now).Order("intent_expires_at DESC, id").Limit(100).Find(&grants).Error
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	items := make([]gin.H, 0, len(grants))
+	for i := range grants {
+		items = append(items, fluxGrantJSON(&grants[i]))
+	}
+	fluxResult(c, http.StatusOK, gin.H{"items": items})
+}
+
+// RevokeTavernFluxRoom 只撤销登录者自己的授权；即使主站绑定已变更也允许原付款账户止付。
+func RevokeTavernFluxRoom(c *gin.Context) {
+	payer := c.GetInt("id")
+	if c.GetBool("use_access_token") || payer <= 0 {
+		fluxError(c, http.StatusUnauthorized, "flux_browser_login_required")
+		return
+	}
+	id := c.Param("id")
+	if !fluxIntentID.MatchString(id) {
+		fluxError(c, http.StatusNotFound, "flux_authorization_not_found")
+		return
+	}
+	if err := model.RevokeTavernFluxGrant(model.DB, id, payer); err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	fluxResult(c, http.StatusOK, gin.H{"intent_id": id, "status": model.TavernFluxRevoked})
+}
+
+// TavernFluxChatCompletion 在原生结算仍未接通硬上限前明确停止；绝不把请求转投普通/Chat凭据。
+func TavernFluxChatCompletion(c *gin.Context) {
+	roomHeaders := c.Request.Header.Values("X-Tavern-Room-Id")
+	eventHeaders := c.Request.Header.Values("X-Tavern-Event-Id")
+	if len(roomHeaders) != 1 || len(eventHeaders) != 1 || !fluxRoomID.MatchString(roomHeaders[0]) || !fluxEventID.MatchString(eventHeaders[0]) {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_message_scope")
+		return
+	}
+	grant, err := model.GetTavernFluxActiveRoom(model.DB, roomHeaders[0], fluxNow())
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	payer, err := model.ResolveTavernFluxPayer(grant.Subject)
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	if payer != grant.PayerID || grant.ModelID != os.Getenv("TAVERN_FLUX_MODEL_ID") {
+		fluxError(c, http.StatusForbidden, "flux_authorization_denied")
+		return
+	}
+	fluxError(c, http.StatusServiceUnavailable, "flux_billing_hard_cap_unavailable")
+}
