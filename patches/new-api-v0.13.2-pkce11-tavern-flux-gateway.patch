diff --git a/model/tavern_flux.go b/model/tavern_flux.go
new file mode 100644
--- /dev/null
+++ b/model/tavern_flux.go
@@ -0,0 +1,304 @@
+package model
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+const (
+	TavernFluxPending   = "pending"
+	TavernFluxConfirmed = "confirmed"
+	TavernFluxActive    = "active"
+	TavernFluxRevoked   = "revoked"
+	TavernFluxExpired   = "expired"
+	TavernFluxIntentTTL = 10 * 60
+	TavernFluxGrantTTL  = 24 * 60 * 60
+	TavernFluxMaxQuota  = 1_000_000
+)
+
+var (
+	ErrFluxForbidden = errors.New("flux_authorization_denied")
+	ErrFluxConflict  = errors.New("flux_room_already_authorized")
+	ErrFluxInvalid   = errors.New("flux_invalid_authorization_state")
+	ErrFluxDuplicate = errors.New("flux_event_already_registered")
+	ErrFluxQuota     = errors.New("flux_room_budget_exhausted")
+)
+
+// TavernFluxGrant 以同一行保存邀请意向、本人确认和房间激活；唯一活动房键阻止重入或替他人换付款账户。
+type TavernFluxGrant struct {
+	ID              string  `gorm:"type:varchar(64);primaryKey"`
+	RoomID          string  `gorm:"type:varchar(255);not null;uniqueIndex:ux_tavern_flux_grant_invite"`
+	ActiveRoomID    *string `gorm:"type:varchar(255);uniqueIndex"`
+	InviterMXID     string  `gorm:"type:varchar(255);not null"`
+	Subject         string  `gorm:"type:varchar(128);not null"`
+	RoomLabel       string  `gorm:"type:varchar(128);not null"`
+	InviteEventID   *string `gorm:"type:varchar(255);uniqueIndex:ux_tavern_flux_grant_invite"`
+	PayerID         int     `gorm:"not null;default:0;index"`
+	ModelID         string  `gorm:"type:varchar(128);not null"`
+	Status          string  `gorm:"type:varchar(16);not null"`
+	QuotaLimit      int64   `gorm:"not null;default:0"`
+	QuotaReserved   int64   `gorm:"not null;default:0"`
+	QuotaSpent      int64   `gorm:"not null;default:0"`
+	IntentExpiresAt int64   `gorm:"not null"`
+	GrantExpiresAt  int64   `gorm:"not null;default:0"`
+}
+
+// TavernFluxInvocation 按 Matrix 房间和事件防重；保留预留与实际额度，不复制消息正文或凭据。
+type TavernFluxInvocation struct {
+	RoomID      string `gorm:"type:varchar(255);primaryKey"`
+	EventID     string `gorm:"type:varchar(255);primaryKey"`
+	GrantID     string `gorm:"type:varchar(64);not null;index"`
+	Reserved    int64  `gorm:"not null"`
+	Actual      int64  `gorm:"not null;default:0"`
+	State       string `gorm:"type:varchar(16);not null"`
+	CreatedAt   int64  `gorm:"not null;autoCreateTime:false"`
+	CompletedAt int64  `gorm:"not null;default:0"`
+}
+
+// MigrateTavernFlux 在当前版本一次准备两张专用表，不改变任何现有收费表。
+func MigrateTavernFlux(db *gorm.DB) error {
+	return db.AutoMigrate(&TavernFluxGrant{}, &TavernFluxInvocation{})
+}
+
+// ResolveTavernFluxPayer 复用当前主站 provider/sub 绑定的只读解析，不创建用户或发放额度。
+func ResolveTavernFluxPayer(subject string) (int, error) {
+	u, err := ResolveOAuthRelayUser(1, "pingxingxian", subject)
+	if errors.Is(err, ErrOAuthRelayIdentityDenied) {
+		return 0, ErrFluxForbidden
+	}
+	if err != nil {
+		return 0, err
+	}
+	return u.Id, nil
+}
+
+// CreateTavernFluxIntent 只记录经受信发行方验证的邀请准备，不产生预算或付款人。
+func CreateTavernFluxIntent(db *gorm.DB, room, inviter, subject, label, model string, now int64) (*TavernFluxGrant, error) {
+	var id [32]byte
+	if _, err := rand.Read(id[:]); err != nil {
+		return nil, err
+	}
+	grant := &TavernFluxGrant{ID: hex.EncodeToString(id[:]), RoomID: room, InviterMXID: inviter, Subject: subject,
+		RoomLabel: label, ModelID: model, Status: TavernFluxPending, IntentExpiresAt: now + TavernFluxIntentTTL}
+	if err := db.Create(grant).Error; err != nil {
+		return nil, err
+	}
+	return grant, nil
+}
+
+// GetTavernFluxGrant 只取一条；返回的过期状态不自动触发余额或表写入。
+func GetTavernFluxGrant(db *gorm.DB, intentID string, now int64) (*TavernFluxGrant, error) {
+	grant, err := getTavernFluxGrant(db, intentID)
+	if err == nil && grant.Expired(now) {
+		grant.Status = TavernFluxExpired
+	}
+	return grant, err
+}
+
+func getTavernFluxGrant(db *gorm.DB, intentID string) (*TavernFluxGrant, error) {
+	var grant TavernFluxGrant
+	if err := db.Take(&grant, "id = ?", intentID).Error; err != nil {
+		return nil, err
+	}
+	return &grant, nil
+}
+
+// Expired 在邀请前用短期意向截止，激活后用授权截止。
+func (g *TavernFluxGrant) Expired(now int64) bool {
+	switch g.Status {
+	case TavernFluxPending, TavernFluxConfirmed:
+		return now >= g.IntentExpiresAt
+	case TavernFluxActive:
+		return now >= g.GrantExpiresAt
+	default:
+		return false
+	}
+}
+
+// InvitationEventID 保持 HTTP 合同：未激活的意向不含邀请事件，输出空字符串。
+func (g *TavernFluxGrant) InvitationEventID() string {
+	if g.InviteEventID == nil {
+		return ""
+	}
+	return *g.InviteEventID
+}
+
+// ConfirmTavernFluxIntent 仅绑定已校验身份的付款人及明确上限；同一确认请求可安全重试，不可改额度。
+func ConfirmTavernFluxIntent(db *gorm.DB, intentID string, payerID int, limit, now int64) (*TavernFluxGrant, error) {
+	if payerID <= 0 || limit <= 0 || limit > TavernFluxMaxQuota {
+		return nil, ErrFluxInvalid
+	}
+	write := db.Model(&TavernFluxGrant{}).Where("id = ? AND status = ? AND intent_expires_at > ?", intentID, TavernFluxPending, now).
+		Updates(map[string]any{"status": TavernFluxConfirmed, "payer_id": payerID, "quota_limit": limit, "grant_expires_at": now + TavernFluxGrantTTL})
+	if write.Error != nil {
+		return nil, write.Error
+	}
+	g, err := GetTavernFluxGrant(db, intentID, now)
+	if err != nil {
+		return nil, err
+	}
+	if g.PayerID != payerID || g.Status != TavernFluxConfirmed || g.QuotaLimit != limit {
+		return nil, ErrFluxInvalid
+	}
+	return g, nil
+}
+
+// ActivateTavernFluxIntent 只接受已确认、同房同邀请人的真实邀请事件，并防止给已授权房换付款人。
+func ActivateTavernFluxIntent(db *gorm.DB, intentID, room, inviter, event string, payerID int, now int64) (*TavernFluxGrant, error) {
+	err := db.Transaction(func(tx *gorm.DB) error {
+		g, err := getTavernFluxGrant(tx, intentID)
+		if err != nil {
+			return err
+		}
+		if g.RoomID != room || g.InviterMXID != inviter || g.PayerID <= 0 || g.PayerID != payerID {
+			return ErrFluxForbidden
+		}
+		if g.Expired(now) {
+			return ErrFluxInvalid
+		}
+		if g.Status == TavernFluxActive && g.InvitationEventID() == event {
+			return nil
+		}
+		if g.Status != TavernFluxConfirmed || g.QuotaLimit <= 0 || g.GrantExpiresAt <= now {
+			return ErrFluxInvalid
+		}
+		// 只有确实过期的旧授权让出唯一房键；撤销与结算记录仍留存。
+		if err := tx.Model(&TavernFluxGrant{}).Where("active_room_id = ? AND status = ? AND grant_expires_at <= ?", room, TavernFluxActive, now).
+			Updates(map[string]any{"active_room_id": nil, "status": TavernFluxExpired}).Error; err != nil {
+			return err
+		}
+		var count int64
+		if err := tx.Model(&TavernFluxGrant{}).Where("active_room_id = ?", room).Count(&count).Error; err != nil {
+			return err
+		}
+		if count != 0 {
+			return ErrFluxConflict
+		}
+		// 同一条 Matrix 邀请只能激活一次；撤销后重新加入须用一条新的真实邀请。
+		if err := tx.Model(&TavernFluxGrant{}).Where("room_id = ? AND invite_event_id = ?", room, event).Count(&count).Error; err != nil {
+			return err
+		}
+		if count != 0 {
+			return ErrFluxConflict
+		}
+		result := tx.Model(&TavernFluxGrant{}).Where("id = ? AND status = ? AND intent_expires_at > ?", intentID, TavernFluxConfirmed, now).
+			Updates(map[string]any{"status": TavernFluxActive, "active_room_id": room, "invite_event_id": event})
+		if result.Error != nil {
+			// 唯一索引是竞态的最终守卫；不得重试覆盖别人刚激活的记录。
+			if errors.Is(result.Error, gorm.ErrDuplicatedKey) {
+				return ErrFluxConflict
+			}
+			return result.Error
+		}
+		if result.RowsAffected != 1 {
+			return ErrFluxInvalid
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return GetTavernFluxGrant(db, intentID, now)
+}
+
+// RevokeTavernFluxGrant 仅付款人可以撤销；已在途的预留不返还给新授权，结算仍归原记录。
+func RevokeTavernFluxGrant(db *gorm.DB, intentID string, payerID int) error {
+	result := db.Model(&TavernFluxGrant{}).Where("id = ? AND payer_id = ? AND status IN ?", intentID, payerID,
+		[]string{TavernFluxConfirmed, TavernFluxActive}).Updates(map[string]any{"status": TavernFluxRevoked, "active_room_id": nil})
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected == 1 {
+		return nil
+	}
+	var g TavernFluxGrant
+	if err := db.Select("id", "status").Take(&g, "id = ? AND payer_id = ?", intentID, payerID).Error; err != nil {
+		return err
+	}
+	if g.Status != TavernFluxRevoked {
+		return ErrFluxInvalid
+	}
+	return nil
+}
+
+// GetTavernFluxActiveRoom 只接受未过期的唯一活动授权；调用方另验当前主站付款主体仍匹配。
+func GetTavernFluxActiveRoom(db *gorm.DB, room string, now int64) (*TavernFluxGrant, error) {
+	var g TavernFluxGrant
+	if err := db.Take(&g, "active_room_id = ? AND status = ? AND grant_expires_at > ?", room, TavernFluxActive, now).Error; err != nil {
+		return nil, err
+	}
+	if g.RoomID != room || g.PayerID <= 0 {
+		return nil, ErrFluxInvalid
+	}
+	return &g, nil
+}
+
+// ReserveTavernFluxInvocation 将事件去重与房间预算扣留放在同一事务；仅预留，不在此直接变更账户余额。
+func ReserveTavernFluxInvocation(db *gorm.DB, grantID, room, event string, amount, now int64) error {
+	if amount <= 0 || amount > TavernFluxMaxQuota {
+		return ErrFluxQuota
+	}
+	return db.Transaction(func(tx *gorm.DB) error {
+		entry := TavernFluxInvocation{RoomID: room, EventID: event, GrantID: grantID, Reserved: amount, State: "reserved", CreatedAt: now}
+		insert := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&entry)
+		if insert.Error != nil {
+			return insert.Error
+		}
+		if insert.RowsAffected != 1 {
+			return ErrFluxDuplicate
+		}
+		result := tx.Model(&TavernFluxGrant{}).Where("id = ? AND active_room_id = ? AND status = ? AND grant_expires_at > ? AND quota_spent + quota_reserved <= quota_limit - ?",
+			grantID, room, TavernFluxActive, now, amount).Update("quota_reserved", gorm.Expr("quota_reserved + ?", amount))
+		if result.Error != nil {
+			return result.Error
+		}
+		if result.RowsAffected != 1 {
+			return ErrFluxQuota
+		}
+		return nil
+	})
+}
+
+// FinishTavernFluxInvocation 记录已完成的额度结算；不允许执行超预留补扣，已完成事件不能再次返还或计费。
+func FinishTavernFluxInvocation(db *gorm.DB, grantID, room, event string, actual, now int64, charged bool) error {
+	if actual < 0 || !charged && actual != 0 {
+		return ErrFluxInvalid
+	}
+	return db.Transaction(func(tx *gorm.DB) error {
+		var entry TavernFluxInvocation
+		if err := tx.Take(&entry, "room_id = ? AND event_id = ? AND grant_id = ?", room, event, grantID).Error; err != nil {
+			return err
+		}
+		if actual > entry.Reserved {
+			return ErrFluxQuota
+		}
+		state := "failed"
+		if charged {
+			state = "settled"
+		}
+		if entry.State == state && entry.Actual == actual {
+			return nil
+		}
+		update := tx.Model(&TavernFluxInvocation{}).Where("room_id = ? AND event_id = ? AND grant_id = ? AND state = ?", room, event, grantID, "reserved").
+			Updates(map[string]any{"state": state, "actual": actual, "completed_at": now})
+		if update.Error != nil {
+			return update.Error
+		}
+		if update.RowsAffected != 1 {
+			return ErrFluxInvalid
+		}
+		roomUpdate := tx.Model(&TavernFluxGrant{}).Where("id = ? AND quota_reserved >= ?", grantID, entry.Reserved).
+			Updates(map[string]any{"quota_reserved": gorm.Expr("quota_reserved - ?", entry.Reserved), "quota_spent": gorm.Expr("quota_spent + ?", actual)})
+		if roomUpdate.Error != nil {
+			return roomUpdate.Error
+		}
+		if roomUpdate.RowsAffected != 1 {
+			return ErrFluxInvalid
+		}
+		return nil
+	})
+}
