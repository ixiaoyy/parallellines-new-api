+package service
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/types"
+	"github.com/gin-gonic/gin"
+)
+
+func TestTavernFluxNativeOpenAIPrice(t *testing.T) {
+	t.Setenv("OPENAI_STANDARD_BILLING_ENABLED", "true")
+	old := common.QuotaPerUnit
+	common.QuotaPerUnit = 500_000
+	t.Cleanup(func() { common.QuotaPerUnit = old })
+	info := &relaycommon.RelayInfo{OriginModelName: "gpt-6-luna", ChannelMeta: &relaycommon.ChannelMeta{
+		ChannelType: constant.ChannelTypeOpenAI, ChannelId: 1, ChannelBaseUrl: "https://api.openai.com",
+	}}
+	_, err := OpenAIStandardPriceData(info, 1000, &types.TokenCountMeta{MaxTokens: 100}, types.GroupRatioInfo{GroupRatio: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	usage := &dto.OpenAIStandardUsage{InputTokensTotal: 1000, OutputTokens: 100, CacheReadTokens: 200}
+	quota, err := TavernFluxNativeTextQuota(ctx, info, usage)
+	if err != nil || quota != 66 {
+		t.Fatalf("native verified usage was not priced identically: quota=%d err=%v", quota, err)
+	}
+	usage.CacheReadTokens = 1001
+	if _, err := TavernFluxNativeTextQuota(ctx, info, usage); err == nil {
+		t.Fatal("invalid usage partition was accepted")
+	}
+}
