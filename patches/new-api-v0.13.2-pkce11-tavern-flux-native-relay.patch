diff --git a/controller/tavern_flux_native.go b/controller/tavern_flux_native.go
new file mode 100644
--- /dev/null
+++ b/controller/tavern_flux_native.go
@@ -0,0 +1,308 @@
+package controller
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	"github.com/QuantumNous/new-api/logger"
+	"github.com/QuantumNous/new-api/model"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	relayconstant "github.com/QuantumNous/new-api/relay/constant"
+	"github.com/QuantumNous/new-api/relay/helper"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/QuantumNous/new-api/setting/model_setting"
+	"github.com/QuantumNous/new-api/types"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm/clause"
+)
+
+const fluxMaxOutputTokens = 384
+const fluxMaxResponseBytes = 256 * 1024
+
+var fluxNativeHTTP = &http.Client{
+	Timeout: 65 * time.Second,
+	// 不跟随重定向及不复用已可能被服务方关闭的连接，调用失败不换渠道重试。
+	CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	Transport: &http.Transport{DialContext: (&net.Dialer{Timeout: 5 * time.Second}).DialContext,
+		TLSHandshakeTimeout: 5 * time.Second, ResponseHeaderTimeout: 60 * time.Second,
+		MaxResponseHeaderBytes: 32 * 1024, DisableKeepAlives: true},
+}
+
+type fluxTextMessage struct {
+	Role    string `json:"role"`
+	Content string `json:"content"`
+}
+
+type fluxModelInput struct {
+	Model               string            `json:"model"`
+	Messages            []fluxTextMessage `json:"messages"`
+	Stream              bool              `json:"stream,omitempty"`
+	Temperature         *float64          `json:"temperature,omitempty"`
+	MaxTokens           *int              `json:"max_tokens,omitempty"`
+	MaxCompletionTokens *int              `json:"max_completion_tokens,omitempty"`
+}
+
+type fluxModelOutput struct {
+	ID          string          `json:"id"`
+	Object      string          `json:"object"`
+	Created     int64           `json:"created"`
+	Model       string          `json:"model"`
+	ServiceTier string          `json:"service_tier"`
+	Error       json.RawMessage `json:"error"`
+	Usage       json.RawMessage `json:"usage"`
+	Choices     []struct {
+		Index        int    `json:"index"`
+		FinishReason string `json:"finish_reason"`
+		Message      struct {
+			Role         string          `json:"role"`
+			Content      string          `json:"content"`
+			ToolCalls    json.RawMessage `json:"tool_calls"`
+			FunctionCall json.RawMessage `json:"function_call"`
+		} `json:"message"`
+	} `json:"choices"`
+}
+
+func fluxEmptyJSON(raw json.RawMessage) bool {
+	value := strings.TrimSpace(string(raw))
+	return value == "" || value == "null" || value == "[]"
+}
+
+func fluxTextInput(c *gin.Context, modelID string) (*fluxModelInput, int, int, bool) {
+	var body fluxModelInput
+	if !fluxDecode(c, &body) {
+		return nil, 0, 0, false
+	}
+	maxOutput := 0
+	if body.MaxTokens != nil && body.MaxCompletionTokens == nil {
+		maxOutput = *body.MaxTokens
+	} else if body.MaxCompletionTokens != nil && body.MaxTokens == nil {
+		maxOutput = *body.MaxCompletionTokens
+	}
+	if body.Model != modelID || body.Stream || len(body.Messages) != 2 || maxOutput < 1 || maxOutput > fluxMaxOutputTokens ||
+		body.Messages[0].Role != "system" || body.Messages[1].Role != "user" ||
+		strings.TrimSpace(body.Messages[0].Content) == "" || strings.TrimSpace(body.Messages[1].Content) == "" ||
+		body.Temperature != nil && (*body.Temperature < 0 || *body.Temperature > 2) {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_plain_text_request")
+		return nil, 0, 0, false
+	}
+	// 用有界输入字节数及额外消息封装量做保守估算；费用最终只来自核验后的真实用量。
+	inputBound := len(body.Messages[0].Content) + len(body.Messages[1].Content) + 128
+	return &body, maxOutput, inputBound, true
+}
+
+type fluxChannel struct {
+	info     *relaycommon.RelayInfo
+	channel  *model.Channel
+	endpoint string
+}
+
+// fluxNativeChannel 只使用部署时评审的已有 OpenAI 兼容渠道；仍要求付款人原生组有该模型的能力记录。
+// 不进入普通 token 入口，也不使用可能改变模型、提示或费用的转换、覆写、代理和自动分组。
+func fluxNativeChannel(c *gin.Context, payer *model.User, modelID string) (*fluxChannel, error) {
+	channelID, err := strconv.Atoi(os.Getenv("TAVERN_FLUX_CHANNEL_ID"))
+	if err != nil || channelID <= 0 || payer.Group == "" || payer.Group == "auto" ||
+		model_setting.GetGlobalSettings().PassThroughRequestEnabled || common.TLSInsecureSkipVerify {
+		return nil, errors.New("flux_native_channel_unavailable")
+	}
+	var ability model.Ability
+	lookup := model.DB.WithContext(c.Request.Context()).Where(clause.Eq{Column: clause.Column{Name: "group"}, Value: payer.Group}).
+		Where("model = ? AND channel_id = ? AND enabled = ?", modelID, channelID, true).Take(&ability)
+	if lookup.Error != nil || ability.Group != payer.Group || ability.Model != modelID {
+		return nil, errors.New("flux_native_channel_not_in_payer_group")
+	}
+	ch, err := model.GetChannelById(channelID, true)
+	if err != nil || ch == nil || ch.Status != common.ChannelStatusEnabled || ch.Type != constant.ChannelTypeOpenAI ||
+		ch.ChannelInfo.IsMultiKey || !slices.Contains(ch.GetModels(), modelID) || strings.TrimSpace(ch.Key) == "" ||
+		strings.ContainsAny(ch.Key, "\r\n") {
+		return nil, errors.New("flux_native_channel_unavailable")
+	}
+	settings, other := ch.GetSetting(), ch.GetOtherSettings()
+	if settings.Proxy != "" || settings.PassThroughBodyEnabled || settings.SystemPrompt != "" || settings.SystemPromptOverride ||
+		settings.ThinkingToContent || other.AllowServiceTier || !fluxEmptyJSON(json.RawMessage(ch.GetModelMapping())) && strings.TrimSpace(ch.GetModelMapping()) != "{}" ||
+		len(ch.GetParamOverride()) > 0 || len(ch.GetHeaderOverride()) > 0 ||
+		service.ShouldChatCompletionsUseResponsesGlobal(ch.Id, ch.Type, modelID) {
+		return nil, errors.New("flux_native_channel_overrides_unsupported")
+	}
+	baseURL := ch.GetBaseURL()
+	if baseURL == "" {
+		baseURL = constant.ChannelBaseURLs[ch.Type]
+	}
+	base, err := url.Parse(baseURL)
+	if err != nil || base.Scheme != "https" || base.Hostname() == "" || base.User != nil ||
+		base.RawQuery != "" || base.Fragment != "" || base.ForceQuery || base.RawPath != "" ||
+		base.Port() != "" && base.Port() != "443" || !slices.Contains([]string{"", "/", "/v1", "/v1/"}, base.Path) {
+		return nil, errors.New("flux_native_channel_url_invalid")
+	}
+	info := &relaycommon.RelayInfo{
+		UserId: payer.Id, UserGroup: payer.Group, UsingGroup: payer.Group, TokenGroup: payer.Group,
+		OriginModelName: modelID, RelayMode: relayconstant.RelayModeChatCompletions, RelayFormat: types.RelayFormatOpenAI,
+		StartTime: time.Now(), BillingSource: service.BillingSourceWallet,
+		ChannelMeta: &relaycommon.ChannelMeta{ChannelType: ch.Type, ChannelId: ch.Id, ChannelBaseUrl: baseURL, UpstreamModelName: modelID},
+	}
+	base.Path = "/v1/chat/completions"
+	return &fluxChannel{info: info, channel: ch, endpoint: base.String()}, nil
+}
+
+func fluxReservation(c *gin.Context, info *relaycommon.RelayInfo, upperInput, maxOutput int) (int, error) {
+	meta := &types.TokenCountMeta{MaxTokens: maxOutput}
+	if service.OpenAIStandardBillingCandidate(info) {
+		p, err := service.OpenAIStandardPriceData(info, upperInput, meta, helper.HandleGroupRatio(c, info))
+		if err != nil || p.QuotaToPreConsume < 1 || p.QuotaToPreConsume > model.TavernFluxMaxQuota {
+			return 0, errors.New("flux_native_price_unavailable")
+		}
+		return p.QuotaToPreConsume, nil
+	}
+	if _, err := helper.ModelPriceHelper(c, info, upperInput, meta); err != nil {
+		return 0, errors.New("flux_native_price_unavailable")
+	}
+	usage := &dto.OpenAIStandardUsage{InputTokensTotal: upperInput, OutputTokens: maxOutput}
+	if info.PriceData.CacheRatio > 1 {
+		usage.CacheReadTokens = upperInput
+	}
+	return service.TavernFluxNativeTextQuota(c, info, usage)
+}
+
+// fluxNativeCompletion 只发一次受限纯文本调用；候选正文只在本函数缓冲，未结算不写响应。
+func fluxNativeCompletion(c *gin.Context, provider *fluxChannel, input *fluxModelInput, inputBound, outputBound int) (*fluxModelOutput, *dto.OpenAIStandardUsage, error) {
+	if provider.info.OpenAIStandardPolicy != "" {
+		// 原厂模型使用原生 Chat Completion 上限字段，避免使用旧的 max_tokens 形式。
+		input.MaxTokens = nil
+		input.MaxCompletionTokens = &outputBound
+	}
+	data, err := json.Marshal(input)
+	if err != nil {
+		return nil, nil, errors.New("flux_model_encoding_failed")
+	}
+	request, err := http.NewRequestWithContext(c.Request.Context(), http.MethodPost, provider.endpoint, bytes.NewReader(data))
+	if err != nil {
+		return nil, nil, errors.New("flux_model_request_invalid")
+	}
+	request.GetBody = nil
+	request.Header.Set("Authorization", "Bearer "+provider.channel.Key)
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("Accept", "application/json")
+	if org := provider.channel.OpenAIOrganization; org != nil && *org != "" {
+		request.Header.Set("OpenAI-Organization", *org)
+	}
+	response, err := fluxNativeHTTP.Do(request)
+	if err != nil {
+		return nil, nil, errors.New("flux_model_transport_failed")
+	}
+	defer response.Body.Close()
+	mediaType, _, _ := mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if response.StatusCode != http.StatusOK || mediaType != "application/json" {
+		return nil, nil, errors.New("flux_model_http_rejected")
+	}
+	raw, err := io.ReadAll(io.LimitReader(response.Body, fluxMaxResponseBytes+1))
+	if err != nil || len(raw) > fluxMaxResponseBytes {
+		return nil, nil, errors.New("flux_model_reply_unreadable")
+	}
+	var result fluxModelOutput
+	if json.Unmarshal(raw, &result) != nil || result.ID == "" || len(result.ID) > 256 || result.Object != "chat.completion" ||
+		result.Model != input.Model || result.ServiceTier != "" && result.ServiceTier != "default" || !fluxEmptyJSON(result.Error) ||
+		len(result.Choices) != 1 {
+		return nil, nil, errors.New("flux_model_plain_text_reply_required")
+	}
+	choice := result.Choices[0]
+	if choice.Index != 0 || choice.Message.Role != "assistant" || strings.TrimSpace(choice.Message.Content) == "" ||
+		len(choice.Message.Content) > 16384 || choice.FinishReason != "stop" && choice.FinishReason != "length" ||
+		!fluxEmptyJSON(choice.Message.ToolCalls) || !fluxEmptyJSON(choice.Message.FunctionCall) {
+		return nil, nil, errors.New("flux_model_plain_text_reply_required")
+	}
+	verified, err := service.ParseOpenAIStandardUsage(result.Usage, false)
+	if err != nil || verified.InputTokensTotal > inputBound || verified.OutputTokens > outputBound ||
+		verified.InputTokensTotal <= 0 || verified.OutputTokens <= 0 {
+		return nil, nil, errors.New("flux_model_usage_unverifiable")
+	}
+	var detail dto.Usage
+	if json.Unmarshal(result.Usage, &detail) != nil || detail.PromptTokensDetails.AudioTokens != 0 || detail.PromptTokensDetails.ImageTokens != 0 ||
+		detail.CompletionTokenDetails.AudioTokens != 0 || detail.CompletionTokenDetails.ImageTokens != 0 ||
+		detail.InputTokens != 0 || detail.OutputTokens != 0 || detail.PromptCacheHitTokens != 0 ||
+		detail.PromptTokensDetails.CachedCreationTokens != 0 || detail.ClaudeCacheCreation5mTokens != 0 || detail.ClaudeCacheCreation1hTokens != 0 ||
+		detail.UsageSemantic != "" && detail.UsageSemantic != "openai" {
+		return nil, nil, errors.New("flux_model_text_usage_required")
+	}
+	return &result, verified, nil
+}
+
+// finishFluxNative 费率校验后的唯一钱包终态；断开请求不妨碍有界的结算或失败退款。
+func finishFluxNative(c *gin.Context, grant *model.TavernFluxGrant, eventID string, quota int, charged bool) error {
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(c.Request.Context()), 5*time.Second)
+	defer cancel()
+	return model.SettleTavernFluxWallet(model.DB.WithContext(ctx), grant.ID, grant.RoomID, eventID, int64(quota), fluxNow(), charged)
+}
+
+func failFluxNative(c *gin.Context, grant *model.TavernFluxGrant, eventID string, detected string) {
+	if err := finishFluxNative(c, grant, eventID, 0, false); err != nil {
+		logger.LogError(c, "flux_wallet_refund_unconfirmed")
+		fluxError(c, http.StatusServiceUnavailable, "flux_wallet_refund_unconfirmed")
+		return
+	}
+	fluxError(c, http.StatusBadGateway, detected)
+}
+
+func runFluxNativeRelay(c *gin.Context, grant *model.TavernFluxGrant, payer *model.User, eventID string) {
+	input, outputBound, inputBound, ok := fluxTextInput(c, grant.ModelID)
+	if !ok {
+		return
+	}
+	provider, err := fluxNativeChannel(c, payer, grant.ModelID)
+	if err != nil {
+		fluxError(c, http.StatusServiceUnavailable, "flux_native_channel_unavailable")
+		return
+	}
+	reserved, err := fluxReservation(c, provider.info, inputBound, outputBound)
+	if err != nil {
+		fluxError(c, http.StatusServiceUnavailable, "flux_native_price_unavailable")
+		return
+	}
+	if err := model.ReserveTavernFluxWallet(model.DB.WithContext(c.Request.Context()), grant.ID, grant.RoomID, eventID, int64(reserved), fluxNow()); err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	result, usage, err := fluxNativeCompletion(c, provider, input, inputBound, outputBound)
+	if err != nil {
+		failFluxNative(c, grant, eventID, err.Error())
+		return
+	}
+	quota, err := service.TavernFluxNativeTextQuota(c, provider.info, usage)
+	if err != nil {
+		failFluxNative(c, grant, eventID, "flux_model_usage_unsettleable")
+		return
+	}
+	if err := finishFluxNative(c, grant, eventID, quota, true); err != nil {
+		if errors.Is(err, model.ErrTavernFluxActualExceedsReservation) {
+			fluxError(c, http.StatusBadGateway, "flux_unsettled_model_response")
+			return
+		}
+		// 数据库结果未知时不擅自退款或给成功正文，保留原账供核对。
+		logger.LogError(c, "flux_wallet_settlement_unconfirmed")
+		fluxError(c, http.StatusServiceUnavailable, "flux_wallet_settlement_unconfirmed")
+		return
+	}
+	model.UpdateChannelUsedQuota(provider.channel.Id, quota)
+	model.RecordConsumeLog(c, grant.PayerID, model.RecordConsumeLogParams{
+		ChannelId: provider.channel.Id, PromptTokens: usage.InputTokensTotal, CompletionTokens: usage.OutputTokens,
+		ModelName: grant.ModelID, TokenName: "Tavern Flux", Quota: quota, UseTimeSeconds: int(time.Since(provider.info.StartTime).Seconds()),
+		Group: payer.Group, Other: map[string]any{"billing_source": service.BillingSourceWallet, "tavern_flux": true},
+	})
+	choice := result.Choices[0]
+	fluxResult(c, http.StatusOK, gin.H{"id": result.ID, "object": result.Object, "created": result.Created, "model": grant.ModelID,
+		"choices": []gin.H{{"index": 0, "message": fluxTextMessage{Role: "assistant", Content: choice.Message.Content}, "finish_reason": choice.FinishReason}},
+		"usage":   gin.H{"prompt_tokens": usage.InputTokensTotal, "completion_tokens": usage.OutputTokens, "total_tokens": usage.InputTokensTotal + usage.OutputTokens}})
+}
