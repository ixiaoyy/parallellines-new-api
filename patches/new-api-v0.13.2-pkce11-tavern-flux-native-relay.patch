+		t.Fatal(err)
+	}
+	if _, err := model.ActivateTavernFluxIntent(db, grant.ID, room, inviter, "$invite", 501, now); err != nil {
+		t.Fatal(err)
+	}
+	var requests int
+	usage := `,"usage":{"prompt_tokens":16,"completion_tokens":2,"total_tokens":18}`
+	fluxNativeHTTP = &http.Client{Transport: fluxFixtureTransport(func(r *http.Request) (*http.Response, error) {
+		requests++
+		if r.URL.String() != base+"/v1/chat/completions" || r.Header.Get("Authorization") != "Bearer fixture-channel-key" || r.Header.Get("X-Tavern-Room-Id") != "" {
+			t.Fatal("scoped call used the wrong channel credentials or leaked room identity")
+		}
+		text := `{"id":"fixture-result","object":"chat.completion","model":"fixture-model","choices":[{"index":0,"message":{"role":"assistant","content":"meow"},"finish_reason":"stop"}]` + usage + `}`
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(text)), Header: http.Header{"Content-Type": {"application/json"}}, Request: r}, nil
+	})}
+	r := gin.New()
+	r.POST("/tavern-flux/v1/chat/completions", TavernFluxAvailable(), TavernFluxServiceAuth(false), TavernFluxChatCompletion)
+	input := `{"model":"fixture-model","messages":[{"role":"system","content":"Role"},{"role":"user","content":"Hi"}],"max_tokens":8}`
+	call := func(event, payload string, want int) string {
+		t.Helper()
+		request := httptest.NewRequest(http.MethodPost, "/tavern-flux/v1/chat/completions", strings.NewReader(payload))
+		request.Header.Set("Authorization", "Bearer "+bot)
+		request.Header.Set("Content-Type", "application/json")
+		request.Header.Set("X-Tavern-Room-Id", room)
+		request.Header.Set("X-Tavern-Event-Id", event)
+		w := httptest.NewRecorder()
+		r.ServeHTTP(w, request)
+		if w.Code != want {
+			t.Fatalf("request status for %s = %d want %d: %s", event, w.Code, want, w.Body.String())
+		}
+		if want != http.StatusOK && strings.Contains(w.Body.String(), "meow") {
+			t.Fatal("unsuccessful request disclosed the buffered model response")
+		}
+		return w.Body.String()
+	}
+	payerQuota := func(id int) int {
+		t.Helper()
+		var u model.User
+		if db.Select("quota").Take(&u, "id = ?", id).Error != nil {
+			t.Fatal("cannot read fixture wallet")
+		}
+		return u.Quota
+	}
+	call("$stream", input[:len(input)-1]+`,"stream":true}`, http.StatusBadRequest)
+	if requests != 0 {
+		t.Fatal("disallowed request reached the fixture provider")
+	}
+	if output := call("$success", input, http.StatusOK); !strings.Contains(output, "meow") || payerQuota(501) != 990 || payerQuota(502) != 1000 {
+		t.Fatal("successful response did not charge precisely the inviter")
+	}
+	call("$success", input, http.StatusConflict)
+	if requests != 1 || payerQuota(501) != 990 {
+		t.Fatal("duplicate event invoked or charged again")
+	}
+	usage = ""
+	call("$missing_usage", input, http.StatusBadGateway)
+	if payerQuota(501) != 990 {
+		t.Fatal("unverified usage was charged")
+	}
+	usage = `,"usage":{"prompt_tokens":16,"completion_tokens":2,"total_tokens":18}`
+	if err := db.Exec(`CREATE TRIGGER flux_fixture_fail_settlement BEFORE UPDATE ON tavern_flux_invocations WHEN NEW.state='wallet_settled' BEGIN SELECT RAISE(ABORT,'fixture settlement failure'); END;`).Error; err != nil {
+		t.Fatal(err)
+	}
+	call("$unknown_settlement", input, http.StatusServiceUnavailable)
+	if payerQuota(501) != 980 {
+		t.Fatal("uncertain settlement did not retain its original reservation")
+	}
+	var consumeCount int64
+	if err := db.Model(&model.Log{}).Where("type = ?", model.LogTypeConsume).Count(&consumeCount).Error; err != nil || consumeCount != 1 {
+		t.Fatalf("expected only one settled native log: %d %v", consumeCount, err)
+	}
+}
