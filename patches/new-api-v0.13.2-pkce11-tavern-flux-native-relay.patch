diff --git a/service/tavern_flux_text_billing.go b/service/tavern_flux_text_billing.go
new file mode 100644
--- /dev/null
+++ b/service/tavern_flux_text_billing.go
@@ -0,0 +1,65 @@
+package service
+
+import (
+	"errors"
+	"math"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/dto"
+	"github.com/QuantumNous/new-api/model"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/gin-gonic/gin"
+)
+
+// TavernFluxNativeTextQuota 复用原生纯文本价格和舍入，不写钱包、统计或通用 Relay 日志。
+// 本入口不接受任务、阶梯、音视频、工具附加费或未核实的消费计数。
+func TavernFluxNativeTextQuota(c *gin.Context, info *relaycommon.RelayInfo, usage *dto.OpenAIStandardUsage) (int, error) {
+	if info == nil || usage == nil || usage.InputTokensTotal <= 0 || usage.OutputTokens <= 0 ||
+		usage.CacheReadTokens < 0 || usage.CacheReadTokens > usage.InputTokensTotal || info.TieredBillingSnapshot != nil ||
+		info.PriceData.FreeModel || len(info.PriceData.OtherRatios) != 0 || !finitePositive(info.PriceData.GroupRatioInfo.GroupRatio) || !finitePositive(common.QuotaPerUnit) {
+		return 0, errors.New("flux_invalid_native_price")
+	}
+	var quota int
+	if info.OpenAIStandardPolicy != "" {
+		var err error
+		quota, err = CalculateOpenAIStandardQuota(info, usage)
+		if err != nil {
+			return 0, err
+		}
+	} else {
+		price := info.PriceData
+		// 非原厂用量的写缓存分段并无已核验的 Chat 规范映射，不能按普通输入推测该部分费用。
+		if usage.CacheWrite30mTokens != 0 || usage.CacheWrite12hTokens != 0 ||
+			price.UsePrice && !finitePositive(price.ModelPrice) || !price.UsePrice && (!finitePositive(price.ModelRatio) || !finitePositive(price.CompletionRatio)) {
+			return 0, errors.New("flux_unsupported_native_price")
+		}
+		for _, ratio := range []float64{price.CompletionRatio, price.CacheRatio, price.ImageRatio, price.ModelRatio,
+			price.ModelPrice, price.CacheCreationRatio, price.CacheCreation5mRatio, price.CacheCreation1hRatio} {
+			if math.IsNaN(ratio) || math.IsInf(ratio, 0) || ratio < 0 || ratio > 1e9 {
+				return 0, errors.New("flux_invalid_native_ratio")
+			}
+		}
+		// 在原生 decimal 转换 int 前，先用保守的数量级限制挡住异常管理配置。
+		potential := price.ModelPrice * common.QuotaPerUnit
+		if !price.UsePrice {
+			potential = (float64(usage.InputTokensTotal)*math.Max(1, price.CacheRatio) +
+				float64(usage.OutputTokens)*price.CompletionRatio) * price.ModelRatio
+		}
+		if upper := potential * price.GroupRatioInfo.GroupRatio; math.IsInf(upper, 0) || math.IsNaN(upper) || upper >= 1e12 {
+			return 0, errors.New("flux_native_quota_overflow")
+		}
+		summary := calculateTextQuotaSummary(c, info, &dto.Usage{
+			PromptTokens: usage.InputTokensTotal, CompletionTokens: usage.OutputTokens,
+			TotalTokens:         usage.InputTokensTotal + usage.OutputTokens,
+			PromptTokensDetails: dto.InputTokenDetails{CachedTokens: usage.CacheReadTokens},
+		})
+		if summary.CalculationError || !summary.ToolCallSurchargeQuota.IsZero() {
+			return 0, errors.New("flux_unsupported_native_charge")
+		}
+		quota = summary.Quota
+	}
+	if quota < 1 || quota > model.TavernFluxMaxQuota {
+		return 0, model.ErrFluxQuota
+	}
+	return quota, nil
+}
