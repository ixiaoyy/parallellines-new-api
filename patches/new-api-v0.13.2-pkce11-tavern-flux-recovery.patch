@@ -0,0 +1,43 @@
+package controller
+
+import (
+	"context"
+	"os"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+)
+
+// StartTavernFluxWalletRecovery 只在部署过本角色功能的主实例回收崩溃遗留的占资。
+// 显式关停时保留 TAVERN_FLUX_ENABLED=false，避免未结算占资在回退前滞留。
+func StartTavernFluxWalletRecovery() func() {
+	enabled, configured := os.LookupEnv("TAVERN_FLUX_ENABLED")
+	if !configured || (enabled != "true" && enabled != "false") || !common.IsMasterNode {
+		return func() {}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(time.Minute)
+		defer ticker.Stop()
+		for {
+			// 每轮最多 8 条，只退款给原邀请人；未知结算会由同一事件账决定。
+			run, stop := context.WithTimeout(ctx, 5*time.Second)
+			if _, err := model.RecoverStaleTavernFluxWallet(model.DB.WithContext(run), time.Now().Unix()); err != nil && ctx.Err() == nil {
+				common.SysError("Tavern Flux wallet recovery failed; will retry on the next bounded pass")
+			}
+			stop()
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+			}
+		}
+	}()
+	return func() {
+		cancel()
+		<-done
+	}
+}
