+func createFluxWalletUser(t *testing.T, db *gorm.DB, id, quota, status int) {
+	t.Helper()
+	mustFluxWallet(t, db.Create(&User{
+		Id: id, Username: fmt.Sprintf("flux-wallet-%d", id), AffCode: fmt.Sprintf("flux-aff-%d", id),
+		Quota: quota, Status: status,
+	}).Error)
+}
+
+func createFluxWalletGrant(t *testing.T, db *gorm.DB, id, room string, payerID int, limit int64) {
+	t.Helper()
+	mustFluxWallet(t, db.Create(&TavernFluxGrant{
+		ID: id, RoomID: room, ActiveRoomID: &room, InviterMXID: "@fixture:example.test", Subject: "fixture",
+		PayerID: payerID, Status: TavernFluxActive, ModelID: "fixture", QuotaLimit: limit,
+		GrantExpiresAt: fluxWalletTestNow + TavernFluxGrantTTL,
+	}).Error)
+}
+
+func mustFluxWallet(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func expectFluxWalletError(t *testing.T, got, want error) {
+	t.Helper()
+	if !errors.Is(got, want) {
+		t.Fatalf("error=%v want %v", got, want)
+	}
+}
+
+func assertFluxWalletBalance(t *testing.T, db *gorm.DB, id, want int) {
+	t.Helper()
+	var user User
+	mustFluxWallet(t, db.Unscoped().Select("quota").Take(&user, "id = ?", id).Error)
+	if user.Quota != want {
+		t.Fatalf("user=%d wallet=%d want %d", id, user.Quota, want)
+	}
+}
+
+func assertFluxWalletUsage(t *testing.T, db *gorm.DB, id, used, count int) {
+	t.Helper()
+	var user User
+	mustFluxWallet(t, db.Select("used_quota", "request_count").Take(&user, "id = ?", id).Error)
+	if user.UsedQuota != used || user.RequestCount != count {
+		t.Fatalf("user=%d used/count=%d/%d want %d/%d", id, user.UsedQuota, user.RequestCount, used, count)
+	}
+}
+
+func assertFluxWalletGrant(t *testing.T, db *gorm.DB, id string, reserved, spent int64) {
+	t.Helper()
+	grant, err := getTavernFluxGrant(db, id)
+	mustFluxWallet(t, err)
+	if grant.QuotaReserved != reserved || grant.QuotaSpent != spent {
+		t.Fatalf("grant=%s reserved=%d spent=%d want %d/%d", id, grant.QuotaReserved, grant.QuotaSpent, reserved, spent)
+	}
+}
