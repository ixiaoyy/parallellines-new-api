+func TestTavernFluxWalletConcurrentRoomsCannotOverdrawSamePayer(t *testing.T) {
+	db := newFluxWalletTestDB(t)
+	createFluxWalletUser(t, db, 55, 100, common.UserStatusEnabled)
+	const a, b = "!concurrent-a:example.test", "!concurrent-b:example.test"
+	createFluxWalletGrant(t, db, "a", a, 55, 100)
+	createFluxWalletGrant(t, db, "b", b, 55, 100)
+	type result struct {
+		id, room string
+		err      error
+	}
+	output := make(chan result, 2)
+	start := make(chan struct{})
+	var ready sync.WaitGroup
+	ready.Add(2)
+	for id, room := range map[string]string{"a": a, "b": b} {
+		go func() {
+			ready.Done()
+			<-start
+			output <- result{id, room, ReserveTavernFluxWallet(db, id, room, id, 70, fluxWalletTestNow)}
+		}()
+	}
+	ready.Wait()
+	close(start)
+	r1, r2 := <-output, <-output
+	if r1.err != nil {
+		r1, r2 = r2, r1
+	}
+	mustFluxWallet(t, r1.err)
+	expectFluxWalletError(t, r2.err, ErrFluxQuota)
+	assertFluxWalletBalance(t, db, 55, 30)
+	assertFluxWalletGrant(t, db, r1.id, 70, 0)
+	assertFluxWalletGrant(t, db, r2.id, 0, 0)
+	var count int64
+	mustFluxWallet(t, db.Model(&TavernFluxInvocation{}).Count(&count).Error)
+	if count != 1 {
+		t.Fatalf("failed debit left a durable invocation: %d", count)
+	}
+	mustFluxWallet(t, SettleTavernFluxWallet(db, r1.id, r1.room, r1.id, 0, fluxWalletTestNow, false))
+	assertFluxWalletBalance(t, db, 55, 100)
+}
