+func TestTavernFluxWalletExcessRefundsOnceAndCannotUseLegacyReservation(t *testing.T) {
+	db := newFluxWalletTestDB(t)
+	const room = "!cap:example.test"
+	createFluxWalletUser(t, db, 44, 500, common.UserStatusEnabled)
+	createFluxWalletGrant(t, db, "cap", room, 44, 300)
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, "cap", room, "over", 80, fluxWalletTestNow))
+	assertFluxWalletBalance(t, db, 44, 420)
+	expectFluxWalletError(t, SettleTavernFluxWallet(db, "cap", room, "over", 81, fluxWalletTestNow, true), ErrTavernFluxActualExceedsReservation)
+	expectFluxWalletError(t, SettleTavernFluxWallet(db, "cap", room, "over", 81, fluxWalletTestNow, true), ErrTavernFluxActualExceedsReservation)
+	expectFluxWalletError(t, SettleTavernFluxWallet(db, "cap", room, "over", 0, fluxWalletTestNow, false), ErrFluxInvalid)
+	assertFluxWalletBalance(t, db, 44, 500)
+	assertFluxWalletGrant(t, db, "cap", 0, 0)
+	var entry TavernFluxInvocation
+	mustFluxWallet(t, db.Take(&entry, "room_id = ? AND event_id = ?", room, "over").Error)
+	if entry.State != fluxWalletRejected || entry.Actual != 0 {
+		t.Fatalf("rejected event was not terminal and uncharged: %+v", entry)
+	}
+	mustFluxWallet(t, ReserveTavernFluxInvocation(db, "cap", room, "legacy", 50, fluxWalletTestNow))
+	expectFluxWalletError(t, SettleTavernFluxWallet(db, "cap", room, "legacy", 0, fluxWalletTestNow, false), ErrFluxInvalid)
+	assertFluxWalletBalance(t, db, 44, 500)
+	assertFluxWalletGrant(t, db, "cap", 50, 0)
+	assertFluxWalletUsage(t, db, 44, 0, 0)
+}
