+func TestTavernFluxWalletRoomsReplayAndRevoke(t *testing.T) {
+	db := newFluxWalletTestDB(t)
+	const a, b, c = "!a:example.test", "!b:example.test", "!c:example.test"
+	createFluxWalletUser(t, db, 11, 1000, common.UserStatusEnabled)
+	createFluxWalletUser(t, db, 22, 800, common.UserStatusEnabled)
+	createFluxWalletUser(t, db, 33, 500, common.UserStatusEnabled)
+	createFluxWalletGrant(t, db, "first", a, 11, 400)
+	createFluxWalletGrant(t, db, "second", b, 11, 300)
+	createFluxWalletGrant(t, db, "third", c, 22, 200)
+
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, "first", a, "e-a", 300, fluxWalletTestNow))
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, "second", b, "e-b", 200, fluxWalletTestNow))
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, "third", c, "e-c", 100, fluxWalletTestNow))
+	assertFluxWalletBalance(t, db, 11, 500)
+	assertFluxWalletBalance(t, db, 22, 700)
+	assertFluxWalletBalance(t, db, 33, 500)
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, "first", a, "e-a", 300, fluxWalletTestNow), ErrFluxDuplicate)
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, "first", b, "wrong-room", 20, fluxWalletTestNow), ErrFluxForbidden)
+	expectFluxWalletError(t, SettleTavernFluxWallet(db, "first", b, "e-b", 90, fluxWalletTestNow, true), ErrFluxInvalid)
+	assertFluxWalletGrant(t, db, "first", 300, 0)
+	assertFluxWalletGrant(t, db, "second", 200, 0)
+
+	mustFluxWallet(t, RevokeTavernFluxGrant(db, "first", 11))
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, "first", a, "after-revoke", 10, fluxWalletTestNow), ErrFluxForbidden)
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, "second", b, "over-room", 101, fluxWalletTestNow), ErrFluxQuota)
+	// 已撤销房的在途记录仍归原授权与原付款账户，其他房保持独立且可用。
+	mustFluxWallet(t, SettleTavernFluxWallet(db, "first", a, "e-a", 120, fluxWalletTestNow, true))
+	mustFluxWallet(t, SettleTavernFluxWallet(db, "first", a, "e-a", 120, fluxWalletTestNow, true))
+	expectFluxWalletError(t, SettleTavernFluxWallet(db, "first", a, "e-a", 121, fluxWalletTestNow, true), ErrFluxInvalid)
+	mustFluxWallet(t, SettleTavernFluxWallet(db, "second", b, "e-b", 90, fluxWalletTestNow, true))
+	mustFluxWallet(t, SettleTavernFluxWallet(db, "third", c, "e-c", 0, fluxWalletTestNow, false))
+	mustFluxWallet(t, SettleTavernFluxWallet(db, "third", c, "e-c", 0, fluxWalletTestNow, false))
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, "second", b, "after-other-room-revoke", 10, fluxWalletTestNow))
+	mustFluxWallet(t, SettleTavernFluxWallet(db, "second", b, "after-other-room-revoke", 0, fluxWalletTestNow, false))
+	assertFluxWalletBalance(t, db, 11, 790)
+	assertFluxWalletBalance(t, db, 22, 800)
+	assertFluxWalletBalance(t, db, 33, 500)
+	assertFluxWalletGrant(t, db, "first", 0, 120)
+	assertFluxWalletGrant(t, db, "second", 0, 90)
+	assertFluxWalletGrant(t, db, "third", 0, 0)
+	assertFluxWalletUsage(t, db, 11, 210, 2)
+	assertFluxWalletUsage(t, db, 22, 0, 0)
+	assertFluxWalletUsage(t, db, 33, 0, 0)
+}
