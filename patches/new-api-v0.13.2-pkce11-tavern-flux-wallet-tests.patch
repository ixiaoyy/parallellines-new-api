+func TestTavernFluxWalletBatchDisabledForNewReservationOnly(t *testing.T) {
+	db := newFluxWalletTestDB(t)
+	const room = "!batch:example.test"
+	createFluxWalletUser(t, db, 66, 200, common.UserStatusEnabled)
+	createFluxWalletGrant(t, db, "batch", room, 66, 200)
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, "batch", room, "pre-existing", 100, fluxWalletTestNow))
+	oldBatch := common.BatchUpdateEnabled
+	common.BatchUpdateEnabled = true
+	t.Cleanup(func() { common.BatchUpdateEnabled = oldBatch })
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, "batch", room, "new", 30, fluxWalletTestNow), ErrTavernFluxWalletBatchEnabled)
+	mustFluxWallet(t, SettleTavernFluxWallet(db, "batch", room, "pre-existing", 10, fluxWalletTestNow, true))
+	assertFluxWalletBalance(t, db, 66, 190)
+	assertFluxWalletUsage(t, db, 66, 10, 1)
+}
