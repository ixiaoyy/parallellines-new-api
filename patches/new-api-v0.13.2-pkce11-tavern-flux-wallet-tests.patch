+func TestTavernFluxWalletRecoverySkipsNewOldKindAndLimitsBatch(t *testing.T) {
+	db := newFluxWalletTestDB(t)
+	const room = "!recover:example.test"
+	createFluxWalletUser(t, db, 77, 300, common.UserStatusEnabled)
+	createFluxWalletUser(t, db, 88, 100, common.UserStatusEnabled)
+	createFluxWalletGrant(t, db, "recover", room, 77, 300)
+	now := fluxWalletTestNow + fluxWalletStaleSeconds
+	for i := 0; i < fluxWalletRecoveryBatch+1; i++ {
+		event := fmt.Sprintf("stale-%02d", i)
+		mustFluxWallet(t, ReserveTavernFluxWallet(db, "recover", room, event, 10, fluxWalletTestNow-int64(fluxWalletRecoveryBatch-i)))
+	}
+	// 正好十五分钟可退，少一秒不可退；旧版本 room-only reservation 不在钱包补偿范围。
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, "recover", room, "fresh", 10, fluxWalletTestNow+1))
+	mustFluxWallet(t, ReserveTavernFluxInvocation(db, "recover", room, "old-kind", 10, fluxWalletTestNow-100))
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, "recover", room, "paid", 10, fluxWalletTestNow-100))
+	mustFluxWallet(t, SettleTavernFluxWallet(db, "recover", room, "paid", 7, now, true))
+	mustFluxWallet(t, RevokeTavernFluxGrant(db, "recover", 77))
+	assertFluxWalletBalance(t, db, 77, 193)
+
+	// 稳定顺序先取最早的八笔；正式扣过的、较新的和旧类型都不动。
+	n, err := RecoverStaleTavernFluxWallet(db, now)
+	mustFluxWallet(t, err)
+	if n != fluxWalletRecoveryBatch {
+		t.Fatalf("recovered=%d want %d", n, fluxWalletRecoveryBatch)
+	}
+	assertFluxWalletBalance(t, db, 77, 273)
+	assertFluxWalletGrant(t, db, "recover", 30, 7)
+	var entry TavernFluxInvocation
+	mustFluxWallet(t, db.Take(&entry, "room_id = ? AND event_id = ?", room, "stale-00").Error)
+	if entry.State != fluxWalletFailed || entry.Actual != 0 {
+		t.Fatalf("missing failed-event tombstone: %+v", entry)
+	}
+	expectFluxWalletError(t, SettleTavernFluxWallet(db, "recover", room, "stale-00", 8, now, true), ErrFluxInvalid)
+	n, err = RecoverStaleTavernFluxWallet(db, now)
+	mustFluxWallet(t, err)
+	if n != 1 {
+		t.Fatalf("subsequent recovered=%d want 1", n)
+	}
+	n, err = RecoverStaleTavernFluxWallet(db, now)
+	mustFluxWallet(t, err)
+	if n != 0 {
+		t.Fatalf("retried recovered=%d want 0", n)
+	}
+	assertFluxWalletBalance(t, db, 77, 283)
+	assertFluxWalletBalance(t, db, 88, 100)
+	assertFluxWalletGrant(t, db, "recover", 20, 7)
+	assertFluxWalletUsage(t, db, 77, 7, 1)
+}
