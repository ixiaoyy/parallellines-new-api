+package controller
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net/http"
+	"os"
+	"regexp"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+	"github.com/shopspring/decimal"
+)
+
+var fluxInviteRequestID = regexp.MustCompile(`^[a-f0-9]{32}$`)
+
+type fluxOneClickInput struct {
+	room, inviter, subject, label, request *string
+	limit                                  *int64
+}
+
+// decodeFluxOneClick 只接收明确、无重复、无未知且非空指针的字段；零必须显式确认。
+func decodeFluxOneClick(c *gin.Context) (*fluxOneClickInput, bool) {
+	if c.ContentType() != "application/json" {
+		return nil, false
+	}
+	body := &fluxOneClickInput{}
+	fields := map[string]any{
+		"room_id": &body.room, "inviter_mxid": &body.inviter, "subject": &body.subject,
+		"room_label": &body.label, "request_id": &body.request, "limit_usd_micros": &body.limit,
+	}
+	dec := json.NewDecoder(http.MaxBytesReader(c.Writer, c.Request.Body, 8*1024))
+	start, err := dec.Token()
+	if err != nil || start != json.Delim('{') {
+		return nil, false
+	}
+	for dec.More() {
+		key, err := dec.Token()
+		name, ok := key.(string)
+		out := fields[name]
+		if err != nil || !ok || out == nil || dec.Decode(out) != nil {
+			return nil, false
+		}
+		delete(fields, name)
+	}
+	end, err := dec.Token()
+	ok := err == nil && end == json.Delim('}') && len(fields) == 0 && dec.Decode(new(any)) == io.EOF &&
+		body.room != nil && body.inviter != nil && body.subject != nil && body.label != nil && body.request != nil && body.limit != nil
+	return body, ok
+}
+
+// fluxOneClickQuota 按当前原生单位和现有向下取整口径换算；正数小到不可表示时拒绝，不成为零。
+func fluxOneClickQuota(micros int64, perUnit float64) (int64, bool) {
+	if micros == 0 {
+		return 0, true
+	}
+	if micros < 0 || perUnit <= 0 || math.IsNaN(perUnit) || math.IsInf(perUnit, 0) {
+		return 0, false
+	}
+	q := decimal.NewFromInt(micros).Shift(-6).Mul(decimal.NewFromFloat(perUnit))
+	if q.LessThan(decimal.NewFromInt(1)) || q.GreaterThan(decimal.NewFromInt(model.TavernFluxMaxQuota)) {
+		return 0, false
+	}
+	return q.Floor().IntPart(), true
+}
+
+// ConfirmTavernFluxOneClick 只经 issuer 专用认证处理已由同源 Matrix 身份确认的邀请。
+// 只绑定钱包和额度，不发 Matrix 成员事件，也不提前扣费。
+func ConfirmTavernFluxOneClick(c *gin.Context) {
+	body, ok := decodeFluxOneClick(c)
+	if !ok {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_invite")
+		return
+	}
+	label := strings.TrimSpace(*body.label)
+	if !fluxRoomID.MatchString(*body.room) || !fluxSubject.MatchString(*body.subject) ||
+		*body.inviter != "@pl_"+*body.subject+":"+fluxMatrixServer || !fluxInviteRequestID.MatchString(*body.request) ||
+		!utf8.ValidString(label) || len(label) > 128 || strings.IndexFunc(label, unicode.IsControl) >= 0 {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_invite")
+		return
+	}
+	limit, ok := fluxOneClickQuota(*body.limit, common.QuotaPerUnit)
+	if !ok {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_quota_limit")
+		return
+	}
+	payer, err := model.ResolveTavernFluxPayer(*body.subject)
+	if errors.Is(err, model.ErrFluxForbidden) {
+		fluxError(c, http.StatusForbidden, "flux_wallet_unavailable")
+		return
+	}
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	g, err := model.ConfirmTavernFluxOneClick(model.DB.WithContext(c.Request.Context()), *body.room, *body.inviter,
+		*body.subject, label, os.Getenv("TAVERN_FLUX_MODEL_ID"), *body.request, payer, limit, fluxNow())
+	if err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	fluxResult(c, http.StatusOK, gin.H{"intent_id": g.ID, "status": g.Status})
+}
