+package model
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+func TestTavernFluxOneClickUnlimitedWallet(t *testing.T) {
+	db := newFluxWalletTestDB(t)
+	const n = fluxWalletTestNow
+	const room = "!unlimited:example.test"
+	const limited = "!limited:example.test"
+	const inviter = "@pl_11:matrix.pingxingxian.space"
+	const request = "0123456789abcdef0123456789abcdef"
+	createFluxWalletUser(t, db, 11, 700, common.UserStatusEnabled)
+	createFluxWalletUser(t, db, 22, 900, common.UserStatusEnabled)
+	makeGrant := func(room string, limit int64) *TavernFluxGrant {
+		t.Helper()
+		g, err := ConfirmTavernFluxOneClick(db, room, inviter, "11", "Fixture", "model", request, 11, limit, n)
+		mustFluxWallet(t, err)
+		if g.GrantExpiresAt != n+TavernFluxGrantTTL || g.IntentExpiresAt != n+TavernFluxIntentTTL || g.Status != TavernFluxConfirmed || g.QuotaLimit != limit {
+			t.Fatal("invalid grant", g)
+		}
+		return g
+	}
+	unlimited := makeGrant(room, 0)
+	capped := makeGrant(limited, 50)
+	replay, err := ConfirmTavernFluxOneClick(db, room, inviter, "11", "Renamed", "model", request, 11, 0, n+10)
+	mustFluxWallet(t, err)
+	if replay.ID != unlimited.ID || replay.GrantExpiresAt != unlimited.GrantExpiresAt {
+		t.Fatal("replay renewed or replaced grant", replay)
+	}
+	_, err = ConfirmTavernFluxOneClick(db, room, inviter, "11", "Fixture", "model", request, 22, 0, n)
+	expectFluxWalletError(t, err, ErrFluxInvalid)
+	_, err = ActivateTavernFluxIntent(db, unlimited.ID, room, inviter, "$new", 11, n)
+	mustFluxWallet(t, err)
+	_, err = ActivateTavernFluxIntent(db, capped.ID, limited, inviter, "$new2", 11, n)
+	mustFluxWallet(t, err)
+	_, err = ConfirmTavernFluxOneClick(db, room, inviter, "11", "Fixture", "model", request, 11, 0, n+TavernFluxGrantTTL)
+	expectFluxWalletError(t, err, ErrFluxInvalid)
+
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, capped.ID, limited, "$cap", 51, n), ErrFluxQuota)
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, unlimited.ID, room, "$big", TavernFluxMaxQuota+1, n), ErrFluxQuota)
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, unlimited.ID, room, "$msg", 650, n))
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, unlimited.ID, room, "$msg", 50, n), ErrFluxDuplicate)
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, unlimited.ID, room, "$wallet", 51, n), ErrFluxQuota)
+	assertFluxWalletBalance(t, db, 11, 50)
+	assertFluxWalletBalance(t, db, 22, 900)
+	mustFluxWallet(t, RevokeTavernFluxGrant(db, unlimited.ID, 11))
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, unlimited.ID, room, "$revoked", 40, n), ErrFluxForbidden)
+	mustFluxWallet(t, SettleTavernFluxWallet(db, unlimited.ID, room, "$msg", 320, n, true))
+	mustFluxWallet(t, SettleTavernFluxWallet(db, unlimited.ID, room, "$msg", 320, n, true))
+	assertFluxWalletBalance(t, db, 11, 380)
+	assertFluxWalletBalance(t, db, 22, 900)
+	assertFluxWalletUsage(t, db, 11, 320, 1)
+	assertFluxWalletGrant(t, db, unlimited.ID, 0, 320)
+
+	// 旧授权即使错误存为 active/0，也不会使用新零额度授权。
+	legacy := strings.Repeat("f", 64)
+	const oldRoom = "!legacy:example.test"
+	createFluxWalletGrant(t, db, legacy, oldRoom, 11, 0)
+	_, err = GetTavernFluxActiveRoom(db, oldRoom, n)
+	expectFluxWalletError(t, err, ErrFluxInvalid)
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, legacy, oldRoom, "$legacy", 40, n), ErrFluxQuota)
+}
