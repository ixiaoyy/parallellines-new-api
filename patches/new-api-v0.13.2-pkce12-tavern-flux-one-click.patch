+			if json.Unmarshal(result.Body.Bytes(), &out) != nil || len(out) != 2 || out["status"] != status || len(out["intent_id"]) != 63 || !strings.HasPrefix(out["intent_id"], "mx_") {
+				t.Fatal(result.Body.String())
+			}
+			return out["intent_id"]
+		}
+		click := get(zero, model.TavernFluxConfirmed)
+		if again := get(zero, model.TavernFluxConfirmed); again != click {
+			t.Fatal("request did not replay confirmed intent")
+		}
+		mustError(base+`,"limit_usd_micros":100}`, http.StatusConflict, "flux_invalid_authorization_state")
+		clickActivation := strings.NewReplacer("!fixture:", "!click:", "$invite", "$clickInvite").Replace(activation)
+		call(http.MethodPost, api+"/intents/"+click+"/activate", clickActivation, issuerHeaders, nil, http.StatusOK)
+		if again := get(zero, model.TavernFluxActive); again != click {
+			t.Fatal("request did not replay active intent")
+		}
+		mustError(strings.ReplaceAll(strings.ReplaceAll(zero, "501", "502"), "0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdea"), http.StatusConflict, "flux_room_already_authorized")
+		call(http.MethodDelete, api+"/rooms/"+click, "", ownerHeaders, owner, http.StatusOK)
+		mustError(zero, http.StatusConflict, "flux_invalid_authorization_state")
+	})
 	t.Setenv("TAVERN_FLUX_ENABLED", "false")
 	call(http.MethodPost, api+"/intents", intent, issuerHeaders, nil, http.StatusNotFound)
 }
