diff --git a/model/tavern_flux_one_click.go b/model/tavern_flux_one_click.go
new file mode 100644
--- /dev/null
+++ b/model/tavern_flux_one_click.go
@@ -0,0 +1,89 @@
+package model
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"math"
+	"strings"
+
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// 同一房间、邀请人与请求具有固定的新命名空间；旧随机意向不具备不设房间上限的权限。
+const tavernFluxInvitePrefix = "mx_"
+const tavernFluxInviteIDLen = len(tavernFluxInvitePrefix) + 60
+
+func tavernFluxOneClickID(room, inviter, request string) string {
+	hash := sha256.Sum256([]byte("pingxingxian:tavern-flux:invite:v1\x00" + room + "\x00" + inviter + "\x00" + request))
+	return tavernFluxInvitePrefix + hex.EncodeToString(hash[:30])
+}
+
+func (g *TavernFluxGrant) validAuthorizedLimit() bool {
+	return g.QuotaLimit > 0 && g.QuotaLimit <= TavernFluxMaxQuota ||
+		g.QuotaLimit == 0 && len(g.ID) == tavernFluxInviteIDLen && strings.HasPrefix(g.ID, tavernFluxInvitePrefix) &&
+			(g.Status == TavernFluxConfirmed || g.Status == TavernFluxActive)
+}
+
+// ConfirmTavernFluxOneClick 仅供受信邀请入口，将首次确认和重试核对固定到同一已绑定钱包及原生上限。
+// 默认零仅由此入口写入已确认状态；重试不续期，不接管现有活动房，不改变原付款人或额度。
+func ConfirmTavernFluxOneClick(db *gorm.DB, room, inviter, subject, label, model, request string, payerID int, limit, now int64) (*TavernFluxGrant, error) {
+	if payerID <= 0 || limit < 0 || limit > TavernFluxMaxQuota {
+		return nil, ErrFluxInvalid
+	}
+	candidate := &TavernFluxGrant{
+		ID: tavernFluxOneClickID(room, inviter, request), RoomID: room, InviterMXID: inviter,
+		Subject: subject, RoomLabel: label, ModelID: model, PayerID: payerID, Status: TavernFluxConfirmed,
+		QuotaLimit: limit, IntentExpiresAt: now + TavernFluxIntentTTL, GrantExpiresAt: now + TavernFluxGrantTTL,
+	}
+	var out *TavernFluxGrant
+	err := db.Transaction(func(tx *gorm.DB) error {
+		// 在 SQLite 先写固定主键并以唯一约束确认归属；即使冲突也读取并核对全部授权条件。
+		if err := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(candidate).Error; err != nil {
+			return err
+		}
+		grant, err := getTavernFluxGrant(tx, candidate.ID)
+		if err != nil {
+			return err
+		}
+		if grant.RoomID != room || grant.InviterMXID != inviter || grant.Subject != subject {
+			return ErrFluxForbidden
+		}
+		if grant.PayerID != payerID || grant.ModelID != model || grant.QuotaLimit != limit ||
+			grant.Expired(now) || !grant.validAuthorizedLimit() {
+			return ErrFluxInvalid
+		}
+		if grant.Status != TavernFluxConfirmed && grant.Status != TavernFluxActive ||
+			grant.Status == TavernFluxActive && (grant.ActiveRoomID == nil || *grant.ActiveRoomID != room) {
+			return ErrFluxInvalid
+		}
+		var active TavernFluxGrant
+		err = tx.Select("id").Take(&active, "active_room_id = ? AND status = ? AND grant_expires_at > ?", room, TavernFluxActive, now).Error
+		if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		if err == nil && active.ID != grant.ID {
+			return ErrFluxConflict
+		}
+		out = grant
+		return nil
+	})
+	return out, err
+}
+
+// fluxReserveRoomBudget 保留原子房间限制和单次独立金额检查；仅确认的新零上限可跳过房间总额限制。
+func fluxReserveRoomBudget(q *gorm.DB, amount int64) *gorm.DB {
+	return q.Where("quota_reserved >= 0 AND quota_reserved <= ? AND quota_spent >= 0 AND quota_spent <= ? - quota_reserved",
+		int64(math.MaxInt64)-amount, int64(math.MaxInt64)-amount).
+		Where("((quota_limit BETWEEN 1 AND ? AND quota_reserved <= quota_limit - ? AND quota_spent <= quota_limit - quota_reserved - ?) OR (quota_limit = 0 AND SUBSTR(id,1,3) = ? AND LENGTH(id) = ?))",
+			TavernFluxMaxQuota, amount, amount, tavernFluxInvitePrefix, tavernFluxInviteIDLen)
+}
+
+// fluxSettleRoomBudget 终结原房预留，即使撤销也能按原记录退回；汇总相加不得溢出。
+func fluxSettleRoomBudget(q *gorm.DB, reserved, actual int64) *gorm.DB {
+	return q.Where("quota_reserved >= ? AND quota_spent >= 0 AND quota_spent <= ?",
+		reserved, int64(math.MaxInt64)-actual).
+		Where("((quota_limit BETWEEN 1 AND ? AND quota_spent <= quota_limit - ?) OR (quota_limit = 0 AND SUBSTR(id,1,3) = ? AND LENGTH(id) = ? AND status IN ?))",
+			TavernFluxMaxQuota, actual, tavernFluxInvitePrefix, tavernFluxInviteIDLen, []string{TavernFluxActive, TavernFluxRevoked, TavernFluxExpired})
+}
