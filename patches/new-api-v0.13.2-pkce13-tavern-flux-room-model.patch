new file mode 100644
--- /dev/null
+++ b/model/tavern_flux_room_model.go
@@ -0,0 +1,47 @@
+package model
+
+import (
+	"errors"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// SetTavernFluxRoomModel 只更新同一活动授权的型号。调用方须先核实新型号及付款人渠道；
+// expected 是操作者看到的旧型号，所有其他授权和费用字段保持不变。
+func SetTavernFluxRoomModel(db *gorm.DB, grant *TavernFluxGrant, expected, next, payerGroup string, channelID int, now int64) error {
+	if expected == "" || next == "" || grant.PayerID <= 0 || payerGroup == "" || channelID <= 0 || !grant.validAuthorizedLimit() {
+		return ErrFluxInvalid
+	}
+	// 检查旧型号和活动房键与更新合并，避免过期、撤销、替换授权或并发编辑覆盖原选择。
+	scope := db.Model(&TavernFluxGrant{}).Where(
+		"id = ? AND room_id = ? AND active_room_id = ? AND status = ? AND grant_expires_at > ? AND payer_id = ? AND model_id = ?",
+		grant.ID, grant.RoomID, grant.RoomID, TavernFluxActive, now, grant.PayerID, expected,
+	).Where(&TavernFluxGrant{InviterMXID: grant.InviterMXID, Subject: grant.Subject})
+	// 价格先核验；实际更新还须匹配核价时的用户组和仍启用的专用渠道能力。
+	group := clause.Eq{Column: clause.Column{Name: "group"}, Value: payerGroup}
+	dbScope := db.Session(&gorm.Session{NewDB: true})
+	scope = scope.
+		Where("EXISTS (?)", dbScope.Model(&User{}).Select("1").Where("id = ? AND status = ?", grant.PayerID, common.UserStatusEnabled).Where(group)).
+		Where("EXISTS (?)", dbScope.Model(&Ability{}).Select("1").Where("model = ? AND channel_id = ? AND enabled = ?", next, channelID, true).Where(group)).
+		Where("EXISTS (?)", dbScope.Model(&Channel{}).Select("1").Where("id = ? AND status = ? AND type = ?", channelID, common.ChannelStatusEnabled, constant.ChannelTypeOpenAI))
+	if expected == next {
+		// 同一选择的无写操作也要通过同一授权和旧型号核对。
+		var found TavernFluxGrant
+		err := scope.Select("id").Take(&found).Error
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return ErrFluxModelChanged
+		}
+		return err
+	}
+	changed := scope.Update("model_id", next)
+	if changed.Error != nil {
+		return changed.Error
+	}
+	if changed.RowsAffected != 1 {
+		return ErrFluxModelChanged
+	}
+	return nil
+}
