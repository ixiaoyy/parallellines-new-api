+
+func TestTavernFluxRoomModelRejectsStaleReservation(t *testing.T) {
+	db := newFluxWalletTestDB(t)
+	const n = fluxWalletTestNow
+	const room = "!room-model:example.test"
+	createFluxWalletUser(t, db, 71, 300, common.UserStatusEnabled)
+	createFluxWalletGrant(t, db, "change", room, 71, 200)
+	mustFluxWallet(t, db.AutoMigrate(&Channel{}, &Ability{}))
+	mustFluxWallet(t, db.Model(&User{}).Where("id = ?", 71).Update("group", "default").Error)
+	mustFluxWallet(t, db.Create(&Channel{Id: 9, Key: "fixture", Type: constant.ChannelTypeOpenAI, Status: common.ChannelStatusEnabled}).Error)
+	mustFluxWallet(t, db.Create(&Ability{Group: "default", Model: "new-model", ChannelId: 9, Enabled: true}).Error)
+	old, err := GetTavernFluxActiveRoom(db, room, n)
+	mustFluxWallet(t, err)
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, old.ID, room, "held-before-edit", old.ModelID, 20, n))
+	mustFluxWallet(t, SetTavernFluxRoomModel(db, old, old.ModelID, "new-model", "default", 9, n))
+	expectFluxWalletError(t, SetTavernFluxRoomModel(db, old, old.ModelID, "third-model", "default", 9, n), ErrFluxModelChanged)
+	expectFluxWalletError(t, ReserveTavernFluxWallet(db, old.ID, room, "arrived-after-edit", old.ModelID, 30, n), ErrFluxModelChanged)
+	var invocationCount int64
+	mustFluxWallet(t, db.Model(&TavernFluxInvocation{}).Where("event_id = ?", "arrived-after-edit").Count(&invocationCount).Error)
+	if invocationCount != 0 {
+		t.Fatal("stale pre-reservation left a deduplication or billing record")
+	}
+	assertFluxWalletBalance(t, db, 71, 280)
+	assertFluxWalletGrant(t, db, old.ID, 20, 0)
+	newGrant, err := GetTavernFluxActiveRoom(db, room, n)
+	mustFluxWallet(t, err)
+	if newGrant.ModelID != "new-model" || newGrant.GrantExpiresAt != old.GrantExpiresAt || newGrant.PayerID != old.PayerID || newGrant.QuotaLimit != old.QuotaLimit {
+		t.Fatal("model switch changed another grant field")
+	}
+	mustFluxWallet(t, SettleTavernFluxWallet(db, old.ID, room, "held-before-edit", 10, n, true))
+	mustFluxWallet(t, ReserveTavernFluxWallet(db, old.ID, room, "arrived-after-edit", newGrant.ModelID, 30, n))
+	mustFluxWallet(t, SettleTavernFluxWallet(db, old.ID, room, "arrived-after-edit", 10, n, true))
+	assertFluxWalletBalance(t, db, 71, 280)
+	assertFluxWalletUsage(t, db, 71, 20, 2)
+	assertFluxWalletGrant(t, db, old.ID, 0, 20)
+}
