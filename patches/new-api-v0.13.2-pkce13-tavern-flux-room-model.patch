new file mode 100644
--- /dev/null
+++ b/controller/tavern_flux_room_model.go
@@ -0,0 +1,154 @@
+package controller
+
+import (
+	"errors"
+	"net/http"
+	"os"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/model"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+type fluxRoomIdentity struct {
+	room, inviter, subject *string
+}
+
+func (i *fluxRoomIdentity) fields() map[string]any {
+	return map[string]any{"room_id": &i.room, "inviter_mxid": &i.inviter, "subject": &i.subject}
+}
+
+func (i *fluxRoomIdentity) valid() bool {
+	return i.room != nil && i.inviter != nil && i.subject != nil &&
+		fluxRoomID.MatchString(*i.room) && fluxSubject.MatchString(*i.subject) &&
+		*i.inviter == "@pl_"+*i.subject+":"+fluxMatrixServer
+}
+
+type fluxModelOption struct {
+	ID    string `json:"id"`
+	Label string `json:"label"`
+}
+
+var fluxPickerModels = [...]fluxModelOption{
+	{"gpt-6-luna", "GPT-6 Luna"},
+	{"gpt-6.1-terra", "GPT-6.1 Terra"},
+	{"gpt-6.1-sol", "GPT-6.1 Sol"},
+}
+
+// fluxLookupPayer 只解析当前已启用的主站绑定，不建账号、不读订阅，也不会写钱包。
+func fluxLookupPayer(c *gin.Context, subject string) *model.User {
+	payer, err := model.ResolveOAuthRelayUser(1, "pingxingxian", subject)
+	if errors.Is(err, model.ErrOAuthRelayIdentityDenied) {
+		fluxError(c, http.StatusForbidden, "flux_wallet_unavailable")
+		return nil
+	}
+	if err != nil {
+		fluxStoreError(c, err)
+		return nil
+	}
+	return payer
+}
+
+// fluxSelectableModel 返回已核价且当前付款组可用的专用渠道 ID；0 表示不可用，不调用供应商。
+func fluxSelectableModel(c *gin.Context, payer *model.User, id string) int {
+	for _, option := range fluxPickerModels {
+		if id == option.ID {
+			channel, err := fluxNativeChannel(c, payer, id)
+			if err == nil {
+				_, err = fluxReservation(c, channel.info, common.PreConsumedQuota, fluxMaxOutputTokens)
+				if err == nil {
+					return channel.channel.Id
+				}
+			}
+			return 0
+		}
+	}
+	return 0
+}
+
+func fluxActiveRoomForPayer(c *gin.Context, identity *fluxRoomIdentity, payer *model.User) (*model.TavernFluxGrant, bool) {
+	grant, err := model.GetTavernFluxActiveRoom(model.DB.WithContext(c.Request.Context()), *identity.room, fluxNow())
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, true
+	}
+	if err != nil {
+		fluxStoreError(c, err)
+		return nil, false
+	}
+	if grant.PayerID != payer.Id || grant.InviterMXID != *identity.inviter || grant.Subject != *identity.subject {
+		fluxStoreError(c, model.ErrFluxForbidden)
+		return nil, false
+	}
+	return grant, true
+}
+
+// TavernFluxModelOptions 返回发起人可选的已定价模型；活动房仅原授权付款人可读取、管理。
+func TavernFluxModelOptions(c *gin.Context) {
+	identity := &fluxRoomIdentity{}
+	if !decodeExactFluxFields(c, identity.fields(), "") || !identity.valid() {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_invite")
+		return
+	}
+	payer := fluxLookupPayer(c, *identity.subject)
+	if payer == nil {
+		return
+	}
+	grant, ok := fluxActiveRoomForPayer(c, identity, payer)
+	if !ok {
+		return
+	}
+	options := make([]fluxModelOption, 0, len(fluxPickerModels))
+	selected, configured := "", os.Getenv("TAVERN_FLUX_MODEL_ID")
+	for _, option := range fluxPickerModels {
+		if fluxSelectableModel(c, payer, option.ID) != 0 {
+			options = append(options, option)
+			if option.ID == configured {
+				selected = configured
+			}
+		}
+	}
+	if grant != nil {
+		selected = grant.ModelID
+	}
+	fluxResult(c, http.StatusOK, gin.H{"options": options, "selected_model_id": selected, "can_edit": grant != nil})
+}
+
+// SetTavernFluxModel 比较旧选择再更新，不把请求变成新邀请，也不重置额度或过期时间。
+func SetTavernFluxModel(c *gin.Context) {
+	identity := &fluxRoomIdentity{}
+	var expected, next *string
+	fields := identity.fields()
+	fields["expected_model_id"], fields["model_id"] = &expected, &next
+	if !decodeExactFluxFields(c, fields, "") || !identity.valid() || next == nil || expected == nil ||
+		!fluxModelID.MatchString(*expected) || !fluxModelID.MatchString(*next) {
+		fluxError(c, http.StatusBadRequest, "flux_invalid_invite")
+		return
+	}
+	payer := fluxLookupPayer(c, *identity.subject)
+	if payer == nil {
+		return
+	}
+	grant, ok := fluxActiveRoomForPayer(c, identity, payer)
+	if !ok {
+		return
+	}
+	if grant == nil {
+		fluxError(c, http.StatusConflict, "flux_room_not_active")
+		return
+	}
+	if grant.ModelID != *expected {
+		fluxStoreError(c, model.ErrFluxModelChanged)
+		return
+	}
+	channelID := fluxSelectableModel(c, payer, *next)
+	if channelID == 0 {
+		fluxStoreError(c, model.ErrFluxModelUnavailable)
+		return
+	}
+	if err := model.SetTavernFluxRoomModel(model.DB.WithContext(c.Request.Context()), grant, *expected, *next, payer.Group, channelID, fluxNow()); err != nil {
+		fluxStoreError(c, err)
+		return
+	}
+	fluxResult(c, http.StatusOK, gin.H{"model_id": *next})
+}
