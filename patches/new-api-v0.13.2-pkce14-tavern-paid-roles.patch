+	mustFluxWallet(t, db.AutoMigrate(&User{}, &legacyFluxGrant{}, &legacyFluxInvocation{}))
+	const room, inviter, request = "!legacy-room:test", "@pl_11:matrix.pingxingxian.space", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	const oldID = "mx_602faf0f58f7e5abc46bfc6475d3a7394e1c0170cacb57be56a581740d12"
+	const now = fluxWalletTestNow
+	invite := "$old_invite"
