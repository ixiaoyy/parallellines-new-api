+func TestTavernFluxRoleMigrationPreservesOriginalGrantAndWallet(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(filepath.ToSlash(filepath.Join(t.TempDir(), "pkce13.sqlite"))), &gorm.Config{TranslateError: true, Logger: logger.Default.LogMode(logger.Silent)})
