+	mustFluxWallet(t, db.Create(&legacy).Error)
+	held := legacyFluxInvocation{RoomID: room, EventID: "$shared", GrantID: oldID, Reserved: 25, State: fluxWalletReserved, CreatedAt: now - fluxWalletStaleSeconds - 1}
+	completed := legacyFluxInvocation{RoomID: room, EventID: "$prior", GrantID: oldID, Reserved: 13, Actual: 7, State: fluxWalletSettled, CreatedAt: now - 950, CompletedAt: now - 940}
+	mustFluxWallet(t, db.Create(&held).Error)
+	mustFluxWallet(t, db.Create(&completed).Error)
+	createFluxWalletUser(t, db, 11, 175, common.UserStatusEnabled)
+	createFluxWalletUser(t, db, 22, 300, common.UserStatusEnabled)
+
+	// 让复制表创建在前置 ALTER 和索引变动后失败；整个 Schema 必须回到旧版。
+	mustFluxWallet(t, db.Exec("CREATE TABLE tavern_flux_invocations_roles_v14 (fixture_id INTEGER)").Error)
+	if err := MigrateTavernFlux(db); err == nil || db.Migrator().HasColumn(&TavernFluxGrant{}, "role_id") ||
+		!db.Migrator().HasIndex(&TavernFluxGrant{}, fluxOldActiveIndex) {
+		t.Fatal("failed migration left partial schema")
+	}
+	mustFluxWallet(t, db.Exec("DROP TABLE tavern_flux_invocations_roles_v14").Error)
+	mustFluxWallet(t, MigrateTavernFlux(db))
+	mustFluxWallet(t, MigrateTavernFlux(db))
+	var copied legacyFluxGrant
+	mustFluxWallet(t, db.Take(&copied, "id = ?", oldID).Error)
+	if !reflect.DeepEqual(copied, legacy) {
+		t.Fatal("existing grant changed during migration")
+	}
+	for _, want := range []legacyFluxInvocation{held, completed} {
+		var got legacyFluxInvocation
+		mustFluxWallet(t, db.Take(&got, "room_id = ? AND event_id = ? AND role_id = ?", room, want.EventID, TavernRoleFlux).Error)
+		if !reflect.DeepEqual(got, want) {
+			t.Fatal("legacy invocation changed during migration")
+		}
+	}
+	assertFluxWalletBalance(t, db, 11, 175)
+	flux, err := ConfirmTavernFluxOneClick(db, room, inviter, "11", "retry label", "old-invite-model", request, 11, 90, now, false, TavernRoleFlux)
+	mustFluxWallet(t, err)
+	if flux.ID != oldID || flux.ModelID != "room-snapshot" || flux.GrantExpiresAt != legacy.GrantExpiresAt {
+		t.Fatal("old Flux retry changed")
+	}
+	sakana, err := ConfirmTavernFluxOneClick(db, room, inviter, "11", "second", "sakana-snapshot", request, 22, 65, now, true, TavernRoleSakana)
+	mustFluxWallet(t, err)
