@@ -0,0 +1,197 @@
+package model
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+
+	"gorm.io/gorm"
+)
+
+const (
+	fluxGrantTable           = "tavern_flux_grants"
+	fluxInvocationTable      = "tavern_flux_invocations"
+	fluxOldActiveIndex       = "idx_tavern_flux_grants_active_room_id"
+	fluxActiveRoleIndex      = "ux_tavern_flux_grant_active_role_room"
+	fluxInviteIndex          = "ux_tavern_flux_grant_invite"
+	fluxPayerIndex           = "idx_tavern_flux_grants_payer_id"
+	fluxInvocationGrantIndex = "idx_tavern_flux_invocations_grant_id"
+	fluxRecoveryIndex        = "idx_tavern_flux_wallet_recovery"
+)
+
+type fluxSQLiteColumn struct {
+	Name         string
+	PK           int
+	NotNull      int     `gorm:"column:notnull"`
+	DefaultValue *string `gorm:"column:dflt_value"`
+}
+
+func fluxSQLiteColumns(db *gorm.DB, table string) ([]fluxSQLiteColumn, error) {
+	var out []fluxSQLiteColumn
+	err := db.Raw("SELECT name, pk, [notnull], dflt_value FROM pragma_table_info(?) ORDER BY cid", table).Scan(&out).Error
+	return out, err
+}
+
+func fluxColumnNames(columns []fluxSQLiteColumn) (names []string) {
+	for _, c := range columns {
+		names = append(names, c.Name)
+	}
+	return names
+}
+
+func fluxPrimaryKey(columns []fluxSQLiteColumn) (names []string) {
+	for key := 1; key <= len(columns); key++ {
+		for _, c := range columns {
+			if c.PK == key {
+				names = append(names, c.Name)
+			}
+		}
+	}
+	return names
+}
+
+func fluxVerifyIndex(db *gorm.DB, table, index string, unique bool, columns ...string) error {
+	var count int64
+	if err := db.Raw("SELECT COUNT(*) FROM pragma_index_list(?) WHERE name = ? AND [unique] = ? AND partial = 0", table, index, unique).Scan(&count).Error; err != nil {
+		return err
+	}
+	var names []string
+	if err := db.Raw("SELECT name FROM pragma_index_info(?) ORDER BY seqno", index).Scan(&names).Error; err != nil {
+		return err
+	}
+	if count != 1 || !slices.Equal(names, columns) {
+		return fmt.Errorf("unexpected Tavern role index: %s", index)
+	}
+	return nil
+}
+
+func fluxVerifyRolesSchema(db *gorm.DB, grants, invocations []fluxSQLiteColumn, upgraded bool) error {
+	grantColumns := []string{"id", "room_id", "active_room_id", "inviter_mx_id", "subject", "room_label", "invite_event_id", "payer_id", "model_id", "status", "quota_limit", "quota_reserved", "quota_spent", "intent_expires_at", "grant_expires_at"}
+	invocationColumns := []string{"room_id", "event_id", "grant_id", "reserved", "actual", "state", "created_at", "completed_at"}
+	invocationKey := []string{"room_id", "event_id"}
+	for _, entry := range []struct {
+		table    string
+		columns  []fluxSQLiteColumn
+		expected []string
+	}{
+		{fluxGrantTable, grants, grantColumns}, {fluxInvocationTable, invocations, invocationColumns},
+	} {
+		want := append([]string(nil), entry.expected...)
+		if upgraded {
+			want = append(want, "role_id")
+			for _, c := range entry.columns {
+				if c.Name == "role_id" && (c.NotNull != 1 || c.DefaultValue == nil || *c.DefaultValue != "'flux-the-cat'" && *c.DefaultValue != "\"flux-the-cat\"") {
+					return errors.New("Tavern role column default or nullability changed")
+				}
+			}
+		}
+		got := fluxColumnNames(entry.columns)
+		slices.Sort(got)
+		slices.Sort(want)
+		if !slices.Equal(got, want) {
+			return fmt.Errorf("unexpected Tavern role columns: %s", entry.table)
+		}
+	}
+	if upgraded {
+		invocationKey = append(invocationKey, "role_id")
+	}
+	if !slices.Equal(fluxPrimaryKey(grants), []string{"id"}) || !slices.Equal(fluxPrimaryKey(invocations), invocationKey) {
+		return errors.New("unexpected Tavern role ledger key")
+	}
+	if err := fluxVerifyIndex(db, fluxGrantTable, fluxInviteIndex, true, "room_id", "invite_event_id"); err != nil {
+		return err
+	}
+	if err := fluxVerifyIndex(db, fluxGrantTable, fluxPayerIndex, false, "payer_id"); err != nil {
+		return err
+	}
+	if err := fluxVerifyIndex(db, fluxInvocationTable, fluxInvocationGrantIndex, false, "grant_id"); err != nil {
+		return err
+	}
+	if err := fluxVerifyIndex(db, fluxInvocationTable, fluxRecoveryIndex, false, "state", "created_at"); err != nil {
+		return err
+	}
+	if !upgraded {
+		return fluxVerifyIndex(db, fluxGrantTable, fluxOldActiveIndex, true, "active_room_id")
+	}
+	if db.Migrator().HasIndex(&TavernFluxGrant{}, fluxOldActiveIndex) {
+		return errors.New("old Tavern singleton index still present")
+	}
+	return fluxVerifyIndex(db, fluxGrantTable, fluxActiveRoleIndex, true, "active_room_id", "role_id")
+}
+
+// MigrateTavernFlux 只迁移两个专用表；SQLite 事务内保留所有原授权、事件与占资。
+// 半迁移、未知旧结构、额外触发器或可能丢失的事件表索引均停止，不尝试自动修复。
+func MigrateTavernFlux(db *gorm.DB) error {
+	return db.Transaction(func(tx *gorm.DB) error {
+		if tx.Dialector.Name() != "sqlite" {
+			return errors.New("Tavern role upgrade requires SQLite")
+		}
+		m := tx.Migrator()
+		hasGrants, hasInvocations := m.HasTable(&TavernFluxGrant{}), m.HasTable(&TavernFluxInvocation{})
+		if !hasGrants && !hasInvocations {
+			return tx.AutoMigrate(&TavernFluxGrant{}, &TavernFluxInvocation{})
+		}
+		if !hasGrants || !hasInvocations {
+			return errors.New("Tavern role upgrade requires the complete SQLite baseline")
+		}
+		grants, err := fluxSQLiteColumns(tx, fluxGrantTable)
+		if err != nil {
+			return err
+		}
+		invocations, err := fluxSQLiteColumns(tx, fluxInvocationTable)
+		if err != nil {
+			return err
+		}
+		upgraded := slices.Contains(fluxColumnNames(grants), "role_id")
+		if err := fluxVerifyRolesSchema(tx, grants, invocations, upgraded); err != nil || upgraded {
+			return err
+		}
+		var extras int64
+		if err := tx.Raw("SELECT COUNT(*) FROM sqlite_schema WHERE tbl_name = ? AND ((type = 'index' AND sql IS NOT NULL AND name NOT IN (?,?)) OR type = 'trigger')", fluxInvocationTable, fluxInvocationGrantIndex, fluxRecoveryIndex).Scan(&extras).Error; err != nil {
+			return err
+		}
+		if extras != 0 {
+			return errors.New("unexpected Tavern invocation index or trigger; migration stopped")
+		}
+
+		// Flux 历史走同一账本且默认归原角色；无需逐行改变授权、用户或付款数据。
+		const original = "room_id,event_id,grant_id,reserved,actual,state,created_at,completed_at"
+		for _, statement := range []string{
+			"ALTER TABLE tavern_flux_grants ADD COLUMN role_id VARCHAR(32) NOT NULL DEFAULT 'flux-the-cat'",
+			"CREATE UNIQUE INDEX ux_tavern_flux_grant_active_role_room ON tavern_flux_grants (active_room_id,role_id)",
+			"DROP INDEX idx_tavern_flux_grants_active_room_id",
+			"CREATE TABLE tavern_flux_invocations_roles_v14 (room_id VARCHAR(255),event_id VARCHAR(255),role_id VARCHAR(32) NOT NULL DEFAULT 'flux-the-cat',grant_id VARCHAR(64) NOT NULL,reserved INTEGER NOT NULL,actual INTEGER NOT NULL DEFAULT 0,state VARCHAR(16) NOT NULL,created_at INTEGER NOT NULL,completed_at INTEGER NOT NULL DEFAULT 0,PRIMARY KEY (room_id,event_id,role_id))",
+			"INSERT INTO tavern_flux_invocations_roles_v14 (" + original + ") SELECT " + original + " FROM tavern_flux_invocations",
+		} {
+			if err := tx.Exec(statement).Error; err != nil {
+				return err
+			}
+		}
+		var lostRows int64
+		if err := tx.Raw("SELECT COUNT(*) FROM (SELECT " + original + " FROM tavern_flux_invocations EXCEPT SELECT " + original + " FROM tavern_flux_invocations_roles_v14)").Scan(&lostRows).Error; err != nil {
+			return err
+		}
+		if lostRows != 0 {
+			return errors.New("Tavern role migration copy differs; original ledger preserved")
+		}
+		for _, statement := range []string{
+			"DROP TABLE tavern_flux_invocations",
+			"ALTER TABLE tavern_flux_invocations_roles_v14 RENAME TO tavern_flux_invocations",
+			"CREATE INDEX idx_tavern_flux_invocations_grant_id ON tavern_flux_invocations(grant_id)",
+			"CREATE INDEX idx_tavern_flux_wallet_recovery ON tavern_flux_invocations(state,created_at)",
+		} {
+			if err := tx.Exec(statement).Error; err != nil {
+				return err
+			}
+		}
+		grants, err = fluxSQLiteColumns(tx, fluxGrantTable)
+		if err != nil {
+			return err
+		}
+		invocations, err = fluxSQLiteColumns(tx, fluxInvocationTable)
+		if err != nil {
+			return err
+		}
+		return fluxVerifyRolesSchema(tx, grants, invocations, true)
+	})
+}
