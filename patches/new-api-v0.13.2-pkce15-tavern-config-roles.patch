+type tavernPaidRoleEntry struct {
+	RoleID      string `json:"role_id"`
+	BearerToken string `json:"bearer_token"`
+	Enabled     *bool  `json:"enabled"`
+}
+
+type tavernPaidRolesFile struct {
+	Roles []tavernPaidRoleEntry `json:"roles"`
+}
+
+func validTavernBearer(value, issuer string) bool {
+	return len(value) >= 32 && len(value) <= 256 && value != issuer &&
+		strings.IndexFunc(value, func(r rune) bool { return r < 33 || r > 126 }) < 0
+}
+
+// loadTavernRoleBearers 优先从受限 0600 私有文件 TAVERN_PAID_ROLES_FILE 加载角色凭据；
+// 未配置该文件时回退兼容既有 TAVERN_FLUX_BOT_BEARER / TAVERN_SAKANA_BOT_BEARER。
+func loadTavernRoleBearers() map[string]string {
+	issuer := os.Getenv("TAVERN_FLUX_ISSUER_BEARER")
+	if file := strings.TrimSpace(os.Getenv("TAVERN_PAID_ROLES_FILE")); file != "" {
+		info, err := os.Lstat(file)
+		if err != nil || !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > 64*1024 {
+			return nil
+		}
+		if runtime.GOOS != "windows" && info.Mode().Perm()&0o077 != 0 {
+			return nil
+		}
+		raw, err := os.ReadFile(file)
+		if err != nil || len(raw) > 64*1024 {
+			return nil
+		}
+		dec := json.NewDecoder(bytes.NewReader(raw))
+		dec.DisallowUnknownFields()
+		var cfg tavernPaidRolesFile
+		if err := dec.Decode(&cfg); err != nil || dec.Decode(new(any)) != io.EOF {
+			return nil
+		}
+		roles := make(map[string]string, len(cfg.Roles))
+		seenRoles := make(map[string]struct{}, len(cfg.Roles))
+		seenTokens := make(map[string]struct{}, len(cfg.Roles))
+		for _, entry := range cfg.Roles {
+			if !model.ValidTavernRoleID(entry.RoleID) {
+				return nil
+			}
+			if _, dup := seenRoles[entry.RoleID]; dup {
+				return nil
+			}
+			seenRoles[entry.RoleID] = struct{}{}
+			if entry.Enabled != nil && !*entry.Enabled {
+				continue
+			}
+			if !validTavernBearer(entry.BearerToken, issuer) {
+				return nil
+			}
+			if _, dup := seenTokens[entry.BearerToken]; dup {
+				return nil
+			}
+			seenTokens[entry.BearerToken] = struct{}{}
+			roles[entry.RoleID] = entry.BearerToken
+		}
+		return roles
+	}
+	roles := make(map[string]string, 2)
+	if flux := os.Getenv("TAVERN_FLUX_BOT_BEARER"); validTavernBearer(flux, issuer) {
+		roles[model.TavernRoleFlux] = flux
+	}
+	if sakana := fluxSakanaBearer(); sakana != "" {
+		roles[model.TavernRoleSakana] = sakana
+	}
+	return roles
+}
