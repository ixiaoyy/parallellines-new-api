new file mode 100644
--- /dev/null
+++ b/web/src/i18n/localeBackend.js
@@ -0,0 +1,31 @@
+/**
+ * 创建 i18next 的按需语言后端；loaders 仅包含本站已有语言的模块加载函数。
+ * 只读取请求的命名空间，导入失败交回 i18next 的既有中文回退与重试边界。
+ */
+export function createLocaleBackend(loaders) {
+  return {
+    type: 'backend',
+    init() {},
+    read(language, namespace, callback) {
+      const load = loaders[language];
+      if (!load) {
+        callback(new Error(`Unsupported locale: ${language}`), false);
+        return;
+      }
+      load().then(
+        ({ default: resources }) => {
+          const translations = resources[namespace];
+          if (!translations || typeof translations !== 'object') {
+            callback(
+              new Error(`Missing locale namespace: ${namespace}`),
+              false,
+            );
+            return;
+          }
+          callback(null, translations);
+        },
+        (error) => callback(error, false),
+      );
+    },
+  };
+}
