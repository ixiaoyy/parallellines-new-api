+func TestMainProfileExistsRetainsLockAndTransactionWiring(t *testing.T) {
+	db, provider := profileDatabase(t)
+	insertProfileUser(t, db, 2, "53", "old-name", "old@example.invalid")
+	locked := map[string]int{}
+	queries := 0
+	if err := db.Callback().Query().Before("gorm:query").Register("fixture:profile-exists-wiring", func(query *gorm.DB) {
+		if locking, ok := query.Statement.Clauses["FOR"].Expression.(clause.Locking); ok && locking.Strength == "UPDATE" {
+			if _, ok := query.Statement.ConnPool.(*sql.Tx); !ok {
+				t.Error("locking query escaped original transaction")
+			}
+			locked[query.Statement.Table]++
+		}
+		if query.Statement.Table == "users" && len(query.Statement.Selects) == 1 && query.Statement.Selects[0] == "id" {
+			queries++
+			limit, ok := query.Statement.Clauses["LIMIT"].Expression.(clause.Limit)
+			if !ok || limit.Limit == nil || *limit.Limit != 1 {
+				t.Error("collision query lacks its single-row bound")
+			}
+			if _, ok := query.Statement.ConnPool.(*sql.Tx); !ok {
+				t.Error("collision query escaped original transaction")
+			}
+		}
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := findOrCreateMainProfileUser(db, provider, testMainProfile(), 0); err != nil {
+		t.Fatal(err)
+	}
+	if queries != 1 || locked["custom_oauth_providers"] != 1 || locked["user_oauth_bindings"] != 1 || locked["users"] != 1 {
+		t.Fatalf("locking or query-count wiring changed: queries=%d locks=%v", queries, locked)
+	}
+	// SQLite 省略 FOR UPDATE 文本；这里核对 GORM 原锁意图和事务接线，不冒充 MySQL/PG 实锁验证。
+}
+
+func TestMainProfileExistsConflictCannotPromote(t *testing.T) {
+	db, _ := profileDatabase(t)
+	t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+	before := insertProfileUser(t, db, 2, "53", "old-name", "old@example.invalid")
+	if err := db.Model(&before).Update("role", common.RoleCommonUser).Error; err != nil {
+		t.Fatal(err)
+	}
+	profile := testMainProfile()
+	profile.Extra["main_role"] = "admin"
+	insertProfileUser(t, db, 3, "54", profile.Username, "other@example.invalid")
+	_, _, err := oauth.FindOrCreateChatMainUser(db, profile)
+	var conflict *oauth.MainProfileConflictError
+	if !errors.As(err, &conflict) {
+		t.Fatal("collision did not return the original conflict type")
+	}
+	var after model.User
+	if err := db.First(&after, 2).Error; err != nil {
+		t.Fatal(err)
+	}
+	if after.Role != common.RoleCommonUser || after.Username != before.Username || after.Email != before.Email || after.Quota != before.Quota {
+		t.Fatal("conflict promoted or changed the original account")
+	}
+}
+
+// 进程内 RESP 脚本连接，不监听端口、不拨号 Redis。第一次 DEL 返回错误，第二次成功。
+type profileExistsRedisConn struct {
+	response *bytes.Reader
+	commands bytes.Buffer
+	replies  []string
+	next     int
+}
+
+func (connection *profileExistsRedisConn) Read(data []byte) (int, error) {
+	if connection.response == nil {
+		return 0, io.EOF
+	}
+	return connection.response.Read(data)
+}
+func (connection *profileExistsRedisConn) Write(data []byte) (int, error) {
+	if !bytes.Contains(data, []byte("$3\r\ndel\r\n")) || connection.next >= len(connection.replies) {
+		return 0, errors.New("unexpected synthetic Redis command")
+	}
+	connection.response = bytes.NewReader([]byte(connection.replies[connection.next]))
+	connection.next++
+	return connection.commands.Write(data)
+}
+func (*profileExistsRedisConn) Close() error                     { return nil }
+func (*profileExistsRedisConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (*profileExistsRedisConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (*profileExistsRedisConn) SetDeadline(time.Time) error      { return nil }
+func (*profileExistsRedisConn) SetReadDeadline(time.Time) error  { return nil }
+func (*profileExistsRedisConn) SetWriteDeadline(time.Time) error { return nil }
+
+func TestMainProfileExistsRetriesCacheInvalidationAfterCommittedUpdate(t *testing.T) {
+	db, provider := profileDatabase(t)
+	t.Setenv("MAIN_OAUTH_ACCOUNT_SYNC_ENABLED", "true")
+	before := insertProfileUser(t, db, 2, "53", "old-name", "old@example.invalid")
+	if err := db.Model(&before).Update("role", common.RoleAdminUser).Error; err != nil {
+		t.Fatal(err)
+	}
+	connection := &profileExistsRedisConn{replies: []string{"-ERR synthetic invalidation failure\r\n", ":1\r\n"}}
+	dials := 0
+	client := redis.NewClient(&redis.Options{Addr: "synthetic.invalid:0", PoolSize: 1, MaxRetries: -1, IdleTimeout: -1,
+		Dialer: func(context.Context, string, string) (net.Conn, error) {
+			dials++
+			if dials > 1 {
+				return nil, errors.New("unexpected second synthetic connection")
+			}
+			return connection, nil
+		}})
+	oldClient, oldEnabled := common.RDB, common.RedisEnabled
+	common.RDB, common.RedisEnabled = client, true
+	t.Cleanup(func() { _ = client.Close(); common.RDB, common.RedisEnabled = oldClient, oldEnabled })
+	profile := testMainProfile()
+	profile.Extra["main_role"] = "user"
+	if _, _, err := findOrCreateMainProfileUser(db, provider, profile, 0); err != oauth.ErrMainAccountUnavailable {
+		t.Fatal("failed invalidation was disguised as a successful login")
+	}
+	var committed model.User
+	if err := db.First(&committed, 2).Error; err != nil {
+		t.Fatal(err)
+	}
+	if committed.Role != common.RoleCommonUser || committed.Username != profile.Username || committed.Email != profile.Email {
+		t.Fatal("the original commit-before-cache-error semantics changed")
+	}
+	after, created, err := findOrCreateMainProfileUser(db, provider, profile, 0)
+	if err != nil || created || after.Id != 2 {
+		t.Fatal("unchanged repeated request failed to recover cache invalidation")
+	}
+	if strings.Count(connection.commands.String(), "$3\r\ndel\r\n") != 2 || dials != 1 {
+		t.Fatal("the unchanged request skipped the second DEL or attempted external traffic")
+	}
+}
