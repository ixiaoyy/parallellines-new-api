diff --git a/common/oauth_relay_timing.go b/common/oauth_relay_timing.go
new file mode 100644
--- /dev/null
+++ b/common/oauth_relay_timing.go
@@ -0,0 +1,132 @@
+package common
+
+import (
+	"fmt"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+)
+
+const OAuthRelayTimingKey = "chat_oauth_relay_timing"
+
+type OAuthRelayTimingStage int
+
+const (
+	OAuthRelayUserInfoStage OAuthRelayTimingStage = iota
+	OAuthRelayAccountStage
+	OAuthRelayCredentialStage
+)
+
+type oauthRelayDuration struct {
+	elapsed  time.Duration
+	observed bool
+}
+
+// OAuthRelayTimings 仅保存受信路由的阶段时长，不包含身份、凭据、模型或请求正文。
+// 未进入的阶段保持缺失；响应头耗时不代表首个 token 或完整流成功。
+type OAuthRelayTimings struct {
+	mu                    sync.Mutex
+	started               time.Time
+	total                 oauthRelayDuration
+	userinfo              oauthRelayDuration
+	account               oauthRelayDuration
+	credential            oauthRelayDuration
+	distributionStarted   time.Time
+	distribution          oauthRelayDuration
+	upstreamHeaders       oauthRelayDuration
+	upstreamHeaderAttempt int
+	upstreamAttempts      int
+}
+
+// NewOAuthRelayTimings 在 OAuth adapter 路由入口开始计时；不改既有 frt 起点。
+func NewOAuthRelayTimings() *OAuthRelayTimings {
+	return &OAuthRelayTimings{started: time.Now()}
+}
+
+// OAuthRelayTimingsFromContext 只读取已由 adapter 创建的记录，普通 API 返回 nil。
+func OAuthRelayTimingsFromContext(c *gin.Context) *OAuthRelayTimings {
+	value, _ := c.Get(OAuthRelayTimingKey)
+	timings, _ := value.(*OAuthRelayTimings)
+	return timings
+}
+
+// RecordStage 记录已实际执行的核验阶段；elapsed 只覆盖该调用，不包含下游 relay。
+func (t *OAuthRelayTimings) RecordStage(stage OAuthRelayTimingStage, elapsed time.Duration) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	value := oauthRelayDuration{elapsed: elapsed, observed: true}
+	switch stage {
+	case OAuthRelayUserInfoStage:
+		t.userinfo = value
+	case OAuthRelayAccountStage:
+		t.account = value
+	case OAuthRelayCredentialStage:
+		t.credential = value
+	}
+}
+
+// BeginDistribution 标记原分发中间件的入口；不改变选渠、限频或重试行为。
+func (t *OAuthRelayTimings) BeginDistribution() {
+	t.mu.Lock()
+	t.distributionStarted = time.Now()
+	t.mu.Unlock()
+}
+
+// FinishDistribution 在 controller 前或选渠失败返回时结束一次计时，不包含生成过程。
+func (t *OAuthRelayTimings) FinishDistribution() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.distributionStarted.IsZero() && !t.distribution.observed {
+		t.distribution = oauthRelayDuration{elapsed: time.Since(t.distributionStarted), observed: true}
+	}
+}
+
+// BeginUpstreamAttempt 仅在原 HTTP client.Do 真正执行前计数；序号供响应头时长关联重试。
+func (t *OAuthRelayTimings) BeginUpstreamAttempt() int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.upstreamAttempts++
+	return t.upstreamAttempts
+}
+
+// RecordUpstreamHeaders 只记录首次实际返回 HTTP 响应头的那次 Do 耗时及序号。
+// 网络失败且没有响应时保持缺失；不把重试间隔、SSE 保活帧或本地响应当上游响应。
+func (t *OAuthRelayTimings) RecordUpstreamHeaders(attempt int, elapsed time.Duration, received bool) {
+	if !received {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.upstreamHeaders.observed {
+		t.upstreamHeaders = oauthRelayDuration{elapsed: elapsed, observed: true}
+		t.upstreamHeaderAttempt = attempt
+	}
+}
+
+// Finish 在 adapter 返回时记录总耗时；不推断响应是否到达用户或 SSE 是否成功。
+func (t *OAuthRelayTimings) Finish() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.total.observed {
+		t.total = oauthRelayDuration{elapsed: time.Since(t.started), observed: true}
+	}
+}
+
+func oauthRelayMilliseconds(value oauthRelayDuration) string {
+	if !value.observed {
+		return "-"
+	}
+	return strconv.FormatFloat(float64(value.elapsed)/float64(time.Millisecond), 'f', 3, 64)
+}
+
+// String 为原 GIN access log 生成固定小字段；沿用该行 requestId，不新增重复日志。
+func (t *OAuthRelayTimings) String() string {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return fmt.Sprintf("oauth_relay_total_ms=%s oauth_relay_userinfo_verify_ms=%s oauth_relay_account_resolve_ms=%s oauth_relay_credential_ms=%s oauth_relay_distribute_ms=%s oauth_relay_upstream_headers_ms=%s oauth_relay_upstream_headers_attempt=%d oauth_relay_upstream_attempts=%d",
+		oauthRelayMilliseconds(t.total), oauthRelayMilliseconds(t.userinfo), oauthRelayMilliseconds(t.account),
+		oauthRelayMilliseconds(t.credential), oauthRelayMilliseconds(t.distribution), oauthRelayMilliseconds(t.upstreamHeaders),
+		t.upstreamHeaderAttempt, t.upstreamAttempts)
+}
