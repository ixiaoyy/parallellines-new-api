+++ b/middleware/oauth_relay_timing.go
@@ -0,0 +1,29 @@
+package middleware
+
+import (
+	"github.com/QuantumNous/new-api/common"
+	"github.com/gin-gonic/gin"
+)
+
+// ChatOAuthRelayTiming 只给既有三条 adapter 路由增加计时，错误/流/身份边界继续由原链路拥有。
+func ChatOAuthRelayTiming() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		timings := common.NewOAuthRelayTimings()
+		c.Set(common.OAuthRelayTimingKey, timings)
+		defer timings.Finish()
+		c.Next()
+	}
+}
+
+// ChatOAuthRelayDistributionTiming 包围原 Distribute；成功时由 controller 前的标记提前结束。
+// 选渠失败没有进入 controller 时由 defer 结束，不把整段生成/结算混作分发耗时。
+func ChatOAuthRelayDistributionTiming() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		timings := common.OAuthRelayTimingsFromContext(c)
+		if timings != nil {
+			timings.BeginDistribution()
+			defer timings.FinishDistribution()
+		}
+		c.Next()
+	}
+}
