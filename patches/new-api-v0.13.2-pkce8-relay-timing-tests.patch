@@ -0,0 +1,45 @@
+package common
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestOAuthRelayTimingMissingStagesAndHeaderAttempt(t *testing.T) {
+	timings := NewOAuthRelayTimings()
+	if got := timings.String(); !strings.Contains(got, "oauth_relay_userinfo_verify_ms=-") || !strings.Contains(got, "oauth_relay_upstream_headers_ms=-") {
+		t.Fatal("unobserved stages must not be reported as zero")
+	}
+	timings.RecordStage(OAuthRelayUserInfoStage, 17*time.Millisecond)
+	timings.RecordStage(OAuthRelayAccountStage, 23*time.Millisecond)
+	timings.RecordStage(OAuthRelayCredentialStage, 3*time.Millisecond)
+	first := timings.BeginUpstreamAttempt()
+	timings.RecordUpstreamHeaders(first, 11*time.Millisecond, false)
+	if !strings.Contains(timings.String(), "oauth_relay_upstream_headers_ms=-") {
+		t.Fatal("a network error without a response was disguised as response headers")
+	}
+	second := timings.BeginUpstreamAttempt()
+	timings.RecordUpstreamHeaders(second, 31*time.Millisecond, true)
+	third := timings.BeginUpstreamAttempt()
+	timings.RecordUpstreamHeaders(third, 99*time.Millisecond, true)
+	timings.Finish()
+	got := timings.String()
+	for _, value := range []string{"userinfo_verify_ms=17.000", "account_resolve_ms=23.000", "credential_ms=3.000", "upstream_headers_ms=31.000", "upstream_headers_attempt=2", "upstream_attempts=3"} {
+		if !strings.Contains(got, value) {
+			t.Fatalf("missing observed field %s", value)
+		}
+	}
+}
+
+func TestOAuthRelayTimingDistributionDoesNotIncludeRelay(t *testing.T) {
+	timings := NewOAuthRelayTimings()
+	timings.BeginDistribution()
+	timings.FinishDistribution()
+	before := timings.String()
+	time.Sleep(time.Millisecond)
+	timings.FinishDistribution()
+	if timings.String() != before {
+		t.Fatal("the deferred distribution end overwrote the controller-entry measurement")
+	}
+}
