+package middleware
+
+import (
+	"bytes"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/gin-gonic/gin"
+)
+
+func TestOAuthRelayTimingAccessLogAndEarlyReject(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	t.Setenv("CHAT_OAUTH_RELAY_ENABLED", "true")
+	var logs bytes.Buffer
+	oldWriter := gin.DefaultWriter
+	gin.DefaultWriter = &logs
+	t.Cleanup(func() { gin.DefaultWriter = oldWriter })
+	engine := gin.New()
+	engine.Use(RequestId())
+	SetUpLogger(engine)
+	engine.GET("/oauth-relay/v1/models", ChatOAuthRelayTiming(), ChatOAuthRelay("/v1/models"), func(c *gin.Context) { c.Status(299) })
+	engine.GET("/ordinary", func(c *gin.Context) { c.Status(204) })
+	for _, path := range []string{"/oauth-relay/v1/models", "/oauth-relay/v1/models?access_token=synthetic-secret"} {
+		logs.Reset()
+		response := httptest.NewRecorder()
+		engine.ServeHTTP(response, httptest.NewRequest(http.MethodGet, path, nil))
+		if response.Code != 401 && response.Code != 400 {
+			t.Fatalf("original early rejection changed: %d", response.Code)
+		}
+		entry := logs.String()
+		if strings.Count(entry, "[GIN]") != 1 || strings.Count(entry, "oauth_relay_total_ms=") != 1 {
+			t.Fatal("timings must reuse the single existing access log")
+		}
+		if strings.Contains(entry, "synthetic-secret") || strings.Contains(entry, "access_token") || strings.Contains(entry, "Bearer") {
+			t.Fatal("rejected credentials appeared in the access log")
+		}
+		if !strings.Contains(entry, response.Header().Get(common.RequestIdKey)) || !strings.Contains(entry, "oauth_relay_userinfo_verify_ms=-") {
+			t.Fatal("request ID or truthful missing-stage marker was lost")
+		}
+	}
+	logs.Reset()
+	engine.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/ordinary", nil))
+	if strings.Contains(logs.String(), "oauth_relay_") {
+		t.Fatal("ordinary API acquired adapter timing fields")
+	}
+}
