+package service
+
+import (
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/gin-gonic/gin"
+)
+
+func TestOAuthRelayTimingKeepsExistingFrtAndRequestStart(t *testing.T) {
+	context, _ := gin.CreateTestContext(nil)
+	start := time.Unix(100, 0)
+	common.SetContextKey(context, constant.ContextKeyRequestStartTime, start)
+	info := &relaycommon.RelayInfo{ChannelMeta: &relaycommon.ChannelMeta{}, StartTime: start, FirstResponseTime: start.Add(1500 * time.Millisecond)}
+	timings := common.NewOAuthRelayTimings()
+	context.Set(common.OAuthRelayTimingKey, timings)
+	timings.RecordStage(common.OAuthRelayUserInfoStage, time.Second)
+	timings.Finish()
+	other := GenerateTextOtherInfo(context, info, 1, 1, 1, 0, 1, -1, 1)
+	if other["frt"] != float64(1500) || common.GetContextKeyTime(context, constant.ContextKeyRequestStartTime) != start {
+		t.Fatal("adapter entry timings redefined the established frt contract")
+	}
+}
