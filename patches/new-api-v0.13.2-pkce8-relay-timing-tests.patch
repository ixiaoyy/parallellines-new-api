@@ -0,0 +1,65 @@
+package channel
+
+import (
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/gin-gonic/gin"
+)
+
+type timingTransport func(*http.Request) (*http.Response, error)
+
+func (f timingTransport) RoundTrip(request *http.Request) (*http.Response, error) { return f(request) }
+
+type timingUnreadBody struct{ reads int }
+
+func (b *timingUnreadBody) Read([]byte) (int, error) { b.reads++; return 0, io.EOF }
+func (b *timingUnreadBody) Close() error             { return nil }
+
+func TestOAuthRelayTimingActualHTTPHeadersWithoutReadingStream(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	if service.GetHttpClient() == nil {
+		service.InitHttpClient()
+	}
+	client := service.GetHttpClient()
+	oldClient := *client
+	t.Cleanup(func() { *client = oldClient })
+	ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ctx.Request = httptest.NewRequest(http.MethodPost, "/oauth-relay/v1/chat/completions", strings.NewReader("synthetic-body"))
+	timings := common.NewOAuthRelayTimings()
+	ctx.Set(common.OAuthRelayTimingKey, timings)
+	body := &timingUnreadBody{}
+	calls := 0
+	client.Transport = timingTransport(func(request *http.Request) (*http.Response, error) {
+		calls++
+		if request.URL.Host != "synthetic.invalid" {
+			t.Fatal("unexpected request destination")
+		}
+		if calls == 1 {
+			return nil, errors.New("synthetic network failure")
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: body, Request: request}, nil
+	})
+	info := &relaycommon.RelayInfo{ChannelMeta: &relaycommon.ChannelMeta{}}
+	for attempt := 1; attempt <= 2; attempt++ {
+		request, _ := http.NewRequest(http.MethodPost, "https://synthetic.invalid/response", strings.NewReader("synthetic-body"))
+		response, err := DoRequest(ctx, request, info)
+		if attempt == 1 {
+			if err == nil || response != nil || !strings.Contains(timings.String(), "oauth_relay_upstream_headers_ms=-") {
+				t.Fatal("failed HTTP attempt changed behavior or fabricated response headers")
+			}
+		} else if err != nil || response.Body != body {
+			t.Fatal("successful response or body identity changed")
+		}
+	}
+	if body.reads != 0 || !strings.Contains(timings.String(), "upstream_headers_attempt=2") || !strings.Contains(timings.String(), "upstream_attempts=2") {
+		t.Fatal("timing consumed the stream body or lost the actual attempt number")
+	}
+}
