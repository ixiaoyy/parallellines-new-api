+package main
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"io/fs"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/router"
+	"github.com/gin-gonic/gin"
+)
+
+// 只读取真实 main package 的 embed.FS；不调用 main/InitResources，不连接身份、数据库或模型。
+func TestPkce9PublicEmbeddedAssetClosure(t *testing.T) {
+	var manifest struct {
+		Schema int  `json:"schema"`
+		Public bool `json:"public_assets_only"`
+		Count  int  `json:"file_count"`
+		Files  map[string]struct {
+			Bytes  int    `json:"bytes"`
+			SHA256 string `json:"sha256"`
+		} `json:"files"`
+		References []struct {
+			From   string `json:"from"`
+			Target string `json:"target"`
+		} `json:"references"`
+		Nonliteral int `json:"nonliteral_dynamic_imports"`
+	}
+	raw, err := os.ReadFile(os.Getenv("PKCE9_FRONTEND_MANIFEST"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := common.Unmarshal(raw, &manifest); err != nil {
+		t.Fatal(err)
+	}
+	if manifest.Schema != 1 || !manifest.Public || manifest.Count != len(manifest.Files) || manifest.Nonliteral != 0 {
+		t.Fatal("invalid public frontend manifest")
+	}
+	extensions := map[string]bool{".png": true, ".webp": true, ".ico": true, ".html": true, ".txt": true, ".js": true, ".css": true, ".woff2": true, ".woff": true, ".ttf": true}
+	private := regexp.MustCompile(`(?i)(^|[._-])(env|secrets?|private|credentials?|backup|runtime)([._-]|$)`)
+	actual := map[string]bool{}
+	if err := fs.WalkDir(buildFS, "web/dist", func(name string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() {
+			return nil
+		}
+		relative := strings.TrimPrefix(name, "web/dist/")
+		for _, part := range strings.Split(relative, "/") {
+			if strings.HasPrefix(part, ".") || private.MatchString(part) {
+				return fmt.Errorf("non-public embedded file: %s", relative)
+			}
+		}
+		expected, ok := manifest.Files[relative]
+		if !ok || !extensions[path.Ext(relative)] {
+			return fmt.Errorf("unlisted embedded file: %s", relative)
+		}
+		content, err := buildFS.ReadFile(name)
+		if err != nil {
+			return err
+		}
+		if len(content) != expected.Bytes || fmt.Sprintf("%x", sha256.Sum256(content)) != expected.SHA256 {
+			return fmt.Errorf("embedded asset differs: %s", relative)
+		}
+		actual[relative] = true
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if len(actual) != manifest.Count {
+		t.Fatalf("embedded file count=%d expected=%d", len(actual), manifest.Count)
+	}
+	for _, reference := range manifest.References {
+		if !actual[reference.From] || !actual[reference.Target] {
+			t.Fatalf("embedded module closure missing: %s -> %s", reference.From, reference.Target)
+		}
+	}
+	// 这两份真实下划线依赖过去被目录 embed 排除；同时沿原静态服务器入口验证并非 HTML fallback。
+	gin.SetMode(gin.TestMode)
+	engine := gin.New()
+	router.SetWebRouter(engine, buildFS, indexPage)
+	for _, name := range []string{"assets/_basePickBy-CFIS4253.js", "assets/_baseUniq-CDJh-vEn.js"} {
+		response := httptest.NewRecorder()
+		engine.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/"+name, nil))
+		if response.Code != http.StatusOK || fmt.Sprintf("%x", sha256.Sum256(response.Body.Bytes())) != manifest.Files[name].SHA256 {
+			t.Fatalf("real static entry failed: %s status=%d", name, response.Code)
+		}
+	}
+	t.Logf("real embed.FS: %d exact public files; %d parsed JS/CSS/HTML references; two underscore HTTP modules served", len(actual), len(manifest.References))
+}
