ARG BASE_IMAGE=calciumion/new-api:v0.13.2@sha256:81da2c875f1de1460e6dd30324c5cb36b23ef55eaae00f317621fcb8a701ad43
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.version="v0.13.2-pkce.9"
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/ixiaoyy/parallellines-new-api"
COPY --chmod=0755 new-api /new-api
